.mob-thread-search-item:hover { background:var(--bg-hover); }
.mob-thread-search-avatar { width:28px; height:28px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; color:white; margin-top:2px; }
.mob-thread-search-body { flex:1; min-width:0; }
.mob-thread-search-msg { font-size:14px; color:var(--text-primary); line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-bottom:3px; }
.mob-thread-search-meta { font-size:12px; color:var(--text-muted); }

/* ── Bottom nav ─────────────────────────────────────────────────────────────── */
.mob-bottom-nav { display:flex; border-top:1px solid var(--border); background:color-mix(in srgb,var(--bg-sidebar) 96%,transparent); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); flex-shrink:0; padding-bottom:env(safe-area-inset-bottom,0px); }
.mob-bottom-nav-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; padding:8px 4px 6px; min-height:50px; border:none; background:none; cursor:pointer; -webkit-tap-highlight-color:transparent; color:var(--text-muted); transition:color 160ms; }
.mob-bottom-nav-item.active { color:var(--accent); }
