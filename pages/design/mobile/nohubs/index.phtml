.mob-session-member-avatars { display:flex; }
.mob-session-mini-avatar { width:22px; height:22px; border-radius:50%; font-size:8px; font-weight:700; color:white; display:flex; align-items:center; justify-content:center; margin-left:-5px; border:2px solid var(--bg-elevated); flex-shrink:0; }
.mob-session-mini-avatar:first-child { margin-left:0; }

/* ── Thread search panel ────────────────────────────────────────────────────── */
.mob-thread-search-bar { padding:8px 12px; border-bottom:1px solid var(--border); flex-shrink:0; }
.mob-thread-search-input { width:100%; background:var(--fill-secondary); border:none; border-radius:10px; padding:7px 12px; font-size:15px; color:var(--text-primary); outline:none; }
.mob-thread-search-list { flex:1; min-height:0; overflow-y:auto; overscroll-behavior-y:contain; }
