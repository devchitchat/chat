.mob-thread-sub-item:hover { background:var(--bg-hover); }
.mob-thread-sub-connector { font-size:12px; color:var(--text-muted); flex-shrink:0; }
.mob-thread-sub-text { flex:1; font-size:13px; color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
.mob-thread-sub-meta { font-size:11px; color:var(--text-muted); white-space:nowrap; flex-shrink:0; }
.mob-thread-view-all { display:block; padding:4px 12px 4px 0; font-size:12px; color:var(--accent); margin:0 6px; cursor:pointer; border:none; background:none; text-align:left; }
.mob-thread-view-all:hover { text-decoration:underline; }

/* ── Session info banner ────────────────────────────────────────────────────── */
.mob-session-banner {
  padding:10px 14px;
  background:color-mix(in srgb, var(--accent) 6%, var(--bg-elevated));
