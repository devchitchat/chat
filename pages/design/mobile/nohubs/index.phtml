  { unread:false, initials:'AL', color:'#5865f2', text:'Alice replied in "Q4 planning" session', sub:'Feature priority for Q4 · thread',        time:'3h ago' },
]

class ActivitySheet {
  #sc

  constructor() {
    const sheetEl    = document.getElementById('mob-nh-activity-sheet')
    const backdropEl = document.getElementById('mob-nh-activity-backdrop')
    this.#sc = new SheetController(sheetEl, backdropEl)
    document.getElementById('mob-nh-activity-done').addEventListener('click', () => this.#sc.hide())
    this.#renderList()
  }

  show() { this.#sc.show() }

  #renderList() {
    const list = document.getElementById('mob-nh-activity-list')
    list.innerHTML = ACTIVITY_ITEMS.map(item => `
      <div class="mob-activity-item${item.unread ? ' unread' : ''}">
        <div class="mob-activity-avatar" style="background:${item.color}">${escHtml(item.initials)}</div>
        <div class="mob-activity-body">
          <div class="mob-activity-text">${escHtml(item.text)}</div>
          <div class="mob-activity-sub">${escHtml(item.sub)}</div>
        </div>
        <div class="mob-activity-time">${escHtml(item.time)}</div>
      </div>`).join('')
  }
}

class ChannelCreateSheet {
  #model; #sc; #nameInput

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#nameInput = document.getElementById('mob-nh-ch-name')
    document.getElementById('mob-nh-ch-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-nh-ch-create').addEventListener('click', () => this.#create())
    this.#nameInput.addEventListener('input', () => {
      const pos = this.#nameInput.selectionStart
      this.#nameInput.value = this.#nameInput.value.replace(/ /g, '-')
      this.#nameInput.setSelectionRange(pos, pos)
    })
  }

  show() {
    this.#nameInput.value = ''
    this.#sc.show()
    setTimeout(() => this.#nameInput.focus(), 340)
  }

  #create() {
    const name = this.#nameInput.value.trim().toLowerCase().replace(/\s+/g, '-')
    if (!name) { this.#nameInput.focus(); return }
    const vis = document.getElementById('mob-nh-ch-visibility').value
    const section = vis === 'private' ? 'private' : 'public'
    const ch = { id: `ch${Date.now()}`, name, joined: true, threadCount: 0, unread: false }
    this.#model.channels[section].push(ch)
    this.#sc.hide()
    this.#model.selectChannel(ch.id, section)
  }
}

class SessionCreateSheet {
  #model; #sc; #nameInput

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#nameInput = document.getElementById('mob-nh-ses-name')
    document.getElementById('mob-nh-ses-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-nh-ses-create').addEventListener('click', () => this.#create())
  }

  show() {
    this.#nameInput.value = ''
    this.#sc.show()
    setTimeout(() => this.#nameInput.focus(), 340)
  }

  #create() {
    const name = this.#nameInput.value.trim()
    if (!name) { this.#nameInput.focus(); return }
    const autoEnd = +document.getElementById('mob-nh-ses-autoend').value
    const ses = {
      id: `ses${Date.now()}`, name, status: 'active', owner: 'You',
      threadCount: 0, members: ['You'], autoEndDays: autoEnd || undefined,
    }
    this.#model.channels.sessions.push(ses)
    this.#sc.hide()
    this.#model.selectChannel(ses.id, 'sessions')
  }
}

class NewDMSheet {
  #model; #sc; #searchEl; #listEl

  static #MEMBERS = [
    { id:'dm1', name:'Alice', initials:'AL', color:'#5865f2', status:'online' },
    { id:'dm2', name:'Bob',   initials:'BO', color:'#22c55e', status:'away'   },
    { id:'dm3', name:'Carol', initials:'CA', color:'#f59e0b', status:'online' },
  ]

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#searchEl = document.getElementById('mob-nh-dm-search')
    this.#listEl   = document.getElementById('mob-nh-dm-list')
    document.getElementById('mob-nh-dm-cancel').addEventListener('click', () => this.#sc.hide())
    this.#searchEl.addEventListener('input', () => this.#render(this.#searchEl.value))
    this.#listEl.addEventListener('click', e => {
      const row = e.target.closest('.mob-dm-person-row')
      if (!row) return
      const { id, section } = row.dataset
      this.#model.selectChannel(id, section)
      this.#sc.hide()
    })
  }

  show() {
    this.#searchEl.value = ''
    this.#render('')
    this.#sc.show()
    setTimeout(() => this.#searchEl.focus(), 340)
  }

  #render(q) {
    const term = q.toLowerCase()
    const filtered = NewDMSheet.#MEMBERS.filter(m => m.name.toLowerCase().includes(term))
    this.#listEl.innerHTML = filtered.map(m => `
      <div class="mob-dm-person-row" data-id="${m.id}" data-section="dms">
        <div class="mob-dm-person-avatar${m.status === 'away' ? ' away' : ''}" style="background:${m.color}">${m.initials}</div>
        <div class="mob-dm-person-info">
          <div class="mob-dm-person-name">${escHtml(m.name)}</div>
          <div class="mob-dm-person-status">${m.status === 'away' ? 'Away' : 'Online'}</div>
        </div>
      </div>`).join('')
  }
}

