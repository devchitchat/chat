  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 32px rgba(0,0,0,.35), 0 2px 8px rgba(0,0,0,.2);
  overflow: hidden;
  display: none;
  flex-direction: column;
  transform-origin: top left;
  animation: mob-ctx-in 160ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
}
.mob-ctx-menu.is-open { display: flex; }

.mob-ctx-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 16px;
  font-size: 14px;
  color: var(--text-primary);
  cursor: pointer;
  border: none;
  background: none;
  width: 100%;
  text-align: left;
  white-space: nowrap;
}
.mob-ctx-item:hover  { background: var(--bg-hover); }
.mob-ctx-item:active { background: var(--bg-active); }
.mob-ctx-item.danger { color: var(--color-error, #ef4444); }
.mob-ctx-icon { width: 16px; text-align: center; flex-shrink: 0; font-size: 12px; opacity: .65; }
.mob-ctx-divider { height: 1px; background: var(--border); flex-shrink: 0; margin: 2px 0; }

/* ── Long-press peek ────────────────────────────────────────────────────────── */
@keyframes mob-peek {
  to { transform: scale(0.95); opacity: 0.75; }
}
.mob-lp-peek.mob-ch-row {
  animation: mob-peek 180ms ease forwards;
  border-radius: var(--radius-sm);
}
.mob-lp-peek.message {
  animation: mob-peek 180ms ease forwards;
  border-radius: var(--radius-sm);
}

/* ── Edit / sheet common ────────────────────────────────────────────────────── */
.mob-edit-backdrop {
  position: absolute;
  inset: 0;
  z-index: 70;
  background: rgba(0,0,0,.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity 280ms;
}
.mob-edit-backdrop.is-open { opacity: 1; pointer-events: auto; }

.mob-edit-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 71;
  background: var(--bg-elevated);
  border-radius: 20px 20px 0 0;
  height: 88%;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.mob-edit-sheet.is-open { transform: translateY(0); pointer-events: auto; }

.mob-edit-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--border);
  margin: 10px auto 0;
  flex-shrink: 0;
  cursor: grab;
}
.mob-edit-handle:active { cursor: grabbing; }

.mob-edit-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px 10px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.mob-edit-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.mob-edit-btn-cancel,
.mob-edit-btn-done {
  border: none;
  background: none;
  font-size: 16px;
  cursor: pointer;
  padding: 4px 0;
  min-width: 64px;
  -webkit-tap-highlight-color: transparent;
}
.mob-edit-btn-cancel { color: var(--text-secondary); text-align: left; }
.mob-edit-btn-done   { color: var(--accent); text-align: right; font-weight: 600; }
.mob-edit-btn-done:active { opacity: 0.6; }

.mob-edit-body {
  flex: 1;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  padding: 28px 16px 32px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.mob-edit-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.mob-edit-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.mob-edit-input {
  background: var(--bg-base);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  font-size: 16px;
  color: var(--text-primary);
  outline: none;
  width: 100%;
  font-family: inherit;
  resize: none;
}
.mob-edit-input:focus { border-color: var(--accent); }

/* ── Preferences sheet content ──────────────────────────────────────────────── */
.mob-prefs-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 18px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mob-prefs-status-row {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.mob-prefs-status {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  font-size: 15px;
  color: var(--text-secondary);
  background: var(--bg-base);
  border: none;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  text-align: left;
  -webkit-tap-highlight-color: transparent;
}
.mob-prefs-status:last-child { border-bottom: none; }
.mob-prefs-status:active { background: var(--bg-hover); }
.mob-prefs-status.active { color: var(--text-primary); font-weight: 500; }
.mob-prefs-status.active::after { content: 'check'; margin-left: auto; color: var(--accent); font-size: 15px; }

.mob-prefs-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.mob-prefs-links {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.mob-prefs-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  font-size: 15px;
  color: var(--text-primary);
  background: var(--bg-base);
  border: none;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  text-align: left;
  -webkit-tap-highlight-color: transparent;
}
.mob-prefs-link:last-child { border-bottom: none; }
.mob-prefs-link:active { background: var(--bg-hover); }
.mob-prefs-link::after { content: '>'; font-size: 18px; color: var(--text-muted); }

.mob-prefs-signout {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--bg-base);
  color: var(--color-error, #ef4444);
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.mob-prefs-signout:active { opacity: 0.7; }

/* Channel name input with inline # prefix */
.mob-ch-name-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-base);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 12px;
  gap: 3px;
  transition: border-color 160ms;
}
.mob-ch-name-wrap:focus-within { border-color: var(--accent); }
.mob-ch-name-input {
  border: none !important;
  background: none;
  padding: 10px 0;
  flex: 1;
  min-width: 0;
  font-size: 16px;
}
.mob-ch-name-input:focus { outline: none; }

/* ── Call bar ───────────────────────────────────────────────────────────────── */
.mob-call-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 0;
  overflow: hidden;
  padding: 0 12px;
  background: color-mix(in srgb, #22c55e 12%, var(--bg-elevated));
  border-bottom: 1px solid color-mix(in srgb, #22c55e 30%, transparent);
  flex-shrink: 0;
  cursor: pointer;
  transition: height 220ms cubic-bezier(0.32, 0.72, 0, 1);
}
.mob-call-bar.is-active { height: 36px; }

@keyframes mob-call-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
}
.mob-call-bar-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  flex-shrink: 0;
  animation: mob-call-pulse 1.4s ease-in-out infinite;
}
.mob-call-bar-text {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
}
.mob-call-bar-timer {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.mob-call-bar-leave {
  border: none;
  background: none;
  color: #ef4444;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  padding: 4px 6px;
  flex-shrink: 0;
  -webkit-tap-highlight-color: transparent;
}
.mob-call-bar-leave:active { opacity: 0.7; }

/* ── Call toast ─────────────────────────────────────────────────────────────── */
.mob-call-toast {
  position: absolute;
  top: 0;
  left: 12px;
  right: 12px;
  z-index: 80;
  display: flex;
  align-items: center;
  gap: 10px;
  background: color-mix(in srgb, var(--bg-elevated) 96%, transparent);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 10px 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,.35);
  transform: translateY(-100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.mob-call-toast.is-visible {
  transform: translateY(52px);
  pointer-events: auto;
}
.mob-call-toast-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}
.mob-call-toast-body { flex: 1; min-width: 0; }
.mob-call-toast-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
.mob-call-toast-sub { font-size: 12px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mob-call-toast-btns { display: flex; gap: 6px; flex-shrink: 0; }
.mob-call-toast-btn {
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  padding: 6px 11px;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.mob-call-toast-btn.decline { background: color-mix(in srgb, #ef4444 15%, var(--bg-base)); color: #ef4444; }
.mob-call-toast-btn.accept { background: #22c55e; color: white; }
.mob-call-toast-btn:active { opacity: 0.75; }

/* ── Call sheet ─────────────────────────────────────────────────────────────── */
.mob-call-backdrop {
  position: absolute;
  inset: 0;
  z-index: 75;
  background: rgba(0,0,0,.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 280ms;
}
.mob-call-backdrop.is-open { opacity: 1; pointer-events: auto; }

.mob-call-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 76;
  background: var(--bg-elevated);
  border-radius: 20px 20px 0 0;
  height: 92%;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.mob-call-sheet.is-open { transform: translateY(0); pointer-events: auto; }

.mob-call-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--border);
  margin: 10px auto 0;
  flex-shrink: 0;
  cursor: grab;
}
.mob-call-handle:active { cursor: grabbing; }

.mob-call-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px 10px;
  flex-shrink: 0;
}
.mob-call-channel { font-size: 15px; font-weight: 600; color: var(--text-primary); flex: 1; }
.mob-call-timer { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); flex-shrink: 0; }

.mob-call-participants {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 12px 16px;
  align-content: flex-start;
  overflow-y: auto;
}

.mob-call-tile {
  width: calc(50% - 6px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 16px 8px 12px;
  background: var(--bg-base);
  border-radius: 16px;
  position: relative;
}

@keyframes mob-call-speaking {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,.7); }
  50%       { box-shadow: 0 0 0 6px rgba(34,197,94,.0); }
}

.mob-call-tile-avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 700;
  color: white;
  position: relative;
  flex-shrink: 0;
}

.mob-call-tile.speaking .mob-call-tile-avatar {
  animation: mob-call-speaking 1s ease-in-out infinite;
  outline: 2.5px solid #22c55e;
  outline-offset: 2px;
}

.mob-call-tile-mic {
  position: absolute;
  bottom: -2px;
  right: -2px;
  font-size: 11px;
  line-height: 1;
  background: var(--bg-elevated);
  border-radius: 50%;
  padding: 2px;
}

.mob-call-tile-name {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.mob-call-controls {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px 20px 28px;
  flex-shrink: 0;
  border-top: 1px solid var(--border);
}
.mob-call-controls-row { display: flex; justify-content: space-around; gap: 8px; }

.mob-call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  min-width: 60px;
}
.mob-call-btn-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--bg-base);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  transition: background 160ms, transform 100ms;
}
.mob-call-btn:active .mob-call-btn-icon { transform: scale(0.92); }
.mob-call-btn.active .mob-call-btn-icon { background: color-mix(in srgb, var(--accent) 18%, var(--bg-base)); }
.mob-call-btn-label { font-size: 11px; color: var(--text-secondary); white-space: nowrap; }

.mob-call-hangup {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #ef4444;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(239,68,68,.4);
  -webkit-tap-highlight-color: transparent;
  transition: transform 100ms, box-shadow 100ms;
}
.mob-call-hangup:active {
  transform: scale(0.92);
  box-shadow: 0 2px 8px rgba(239,68,68,.4);
}

/* ── Debug bar ─────────────────────────────────────────────────────────────── */
.mob-debug {
  display: flex;
  gap: 12px;
  justify-content: center;
  align-items: center;
  padding: 6px 12px;
  background: color-mix(in srgb, var(--color-accent, #6366f1) 12%, var(--bg-base));
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  flex-shrink: 0;
}
.mob-debug span { white-space: nowrap; }

/* ── Messages ───────────────────────────────────────────────────────────────── */
.mob-messages .message {
  display: grid;
  grid-template-columns: 44px 1fr;
  column-gap: 0;
  row-gap: 2px;
  padding: 2px 12px;
  margin-top: 2px;
}
.mob-messages .message.new-sender { margin-top: 10px; }
.mob-messages .message.new-sender:first-child,
.mob-thread-root { margin-top: 0 !important; }

.mob-msg-avatar {
  grid-column: 1;
  grid-row: 1;
  align-self: start;
  display: flex;
  justify-content: center;
  padding-top: 1px;
}
.mob-msg-avatar-circle {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: white;
  letter-spacing: 0.03em;
  flex-shrink: 0;
}
.mob-messages .message:not(.new-sender) .mob-msg-avatar-circle { visibility: hidden; }

.mob-msg-header {
  grid-column: 2;
  grid-row: 1;
  display: flex;
  align-items: baseline;
  gap: 6px;
  min-width: 0;
}
.mob-messages .message:not(.new-sender) .mob-msg-header { display: none; }

.mob-messages .message-handle {
  grid-column: unset;
  grid-row: unset;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.1px;
  white-space: nowrap;
}
.mob-messages .message-time {
  grid-column: unset;
  grid-row: unset;
  text-align: left;
  align-self: unset;
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
}

.mob-messages .message-text {
  grid-column: 2;
  font-size: 15px;
  line-height: 1.45;
}

.mob-messages .reaction-bar { grid-column: 2 !important; }
.mob-messages .reaction-pill {
  min-height: 28px;
  padding: 4px 10px;
  font-size: 14px;
}

.mob-messages .mention {
  color: var(--accent);
  font-weight: 500;
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border-radius: 3px;
  padding: 0 3px;
}

/* ── Activity sheet items ─────────────────────────────────────────────────── */
.mob-activity-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}
.mob-activity-item:last-child { border-bottom: none; }
.mob-activity-item:hover { background: var(--bg-hover); }
.mob-activity-item.unread { background: color-mix(in srgb, var(--accent) 5%, transparent); }
.mob-activity-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700; color: white;
  flex-shrink: 0; margin-top: 1px;
}
.mob-activity-body { flex: 1; min-width: 0; }
.mob-activity-text {
  font-size: 14px; color: var(--text-primary);
  line-height: 1.4; margin-bottom: 2px;
}
.mob-activity-item.unread .mob-activity-text { font-weight: 600; }
.mob-activity-sub {
  font-size: 12px; color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mob-activity-time {
  font-size: 11px; color: var(--text-muted);
  flex-shrink: 0; margin-top: 2px;
}
/* ── DM people picker ────────────────────────────────────────────────────── */
.mob-dm-search {
  margin: 12px 16px 0;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background: var(--bg-input);
  color: var(--text-primary);
  font-size: 14px;
  width: calc(100% - 32px);
  outline: none;
}
.mob-dm-search:focus { border-color: var(--accent); }
.mob-dm-person-row {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px; cursor: pointer;
  border-bottom: 1px solid var(--border);
}
.mob-dm-person-row:last-child { border-bottom: none; }
.mob-dm-person-row:hover { background: var(--bg-hover); }
.mob-dm-person-avatar {
  width: 40px; height: 40px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; color: white; flex-shrink: 0;
  position: relative;
}
.mob-dm-person-avatar::after {
  content: '';
  position: absolute; bottom: 1px; right: 1px;
  width: 10px; height: 10px; border-radius: 50%;
  border: 2px solid var(--bg-elevated);
  background: var(--color-success);
}
.mob-dm-person-avatar.away::after { background: var(--color-warning); }
.mob-dm-person-info { flex: 1; min-width: 0; }
.mob-dm-person-name { font-size: 15px; color: var(--text-primary); font-weight: 500; }
.mob-dm-person-status { font-size: 12px; color: var(--text-muted); }

/* ── Global search overlay ───────────────────────────────────────────────── */
.mob-search-overlay {
  position: absolute;
  inset: 0;
  z-index: 45;
  background: var(--bg-base);
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.mob-search-overlay.is-open { transform: translateY(0); pointer-events: auto; }

.mob-search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.mob-search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--fill-secondary);
  border-radius: 10px;
  padding: 7px 10px;
  min-width: 0;
}
.mob-search-input-wrap svg { color: var(--text-muted); flex-shrink: 0; }
.mob-search-input {
  flex: 1; border: none; background: none;
  font-size: 16px; color: var(--text-primary); outline: none; min-width: 0;
  /* reset search input appearance */
  -webkit-appearance: none;
}
.mob-search-input::placeholder { color: var(--text-muted); }
.mob-search-input::-webkit-search-cancel-button { display: none; }
.mob-search-clear {
  border: none; background: none; color: var(--text-muted);
  cursor: pointer; padding: 2px; flex-shrink: 0; display: none;
