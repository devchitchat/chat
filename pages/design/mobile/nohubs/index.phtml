        <span id="mob-nh-dbg-panel">panel: sidebar</span>
        <span id="mob-nh-dbg-dir">dir: -</span>
        <span id="mob-nh-dbg-dx">dx: 0</span>
        <span id="mob-nh-dbg-vel">vel: -</span>
      </div>
    </div><!-- /mob-frame -->

    <!-- Annotations column -->
    <div style="flex:1;min-width:260px;max-width:420px;display:flex;flex-direction:column;gap:16px">
      <div class="ds-annotation" style="margin:0">
        <strong>Channel types:</strong> <em>Public</em> channels are visible to anyone with an
        account -- join by posting. <em>Private</em> channels require explicit membership.
        <em>Sessions</em> are bounded channels with an owner, auto-end timer, and become
        read-only when ended. Ideal for incidents, sprints, or planning cycles.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Threading:</strong> One level deep. When a channel is selected, its threads
        appear as a subtree in the sidebar (max 5, then "view all N threads"). The thread count
        badge on non-active channels shows at a glance. "View all" opens a searchable thread
        list in the third panel.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Guest model:</strong> Guests can only see channels they are explicitly added to.
        No ambient visibility of the channel list. This keeps the prototype's security model
        simple: one team, scoped access for external collaborators.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Streaming:</strong> Voice/video calls are available in any non-DM channel.
        Sessions are the natural home for structured calls -- the bounded context maps perfectly
        to incidents, retros, and planning. The call bar persists across panel navigation.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>No hubs:</strong> One installation = one team workspace. The hub/workspace
        layer has been removed entirely. All complexity of multi-workspace routing, tab bars,
        and overflow sheets is gone. The bottom nav switches between functional areas instead.
      </div>
    </div>

  </div><!-- /flex row -->
</div>

<style>
/* ── Phone frame ────────────────────────────────────────────────────────────── */
.mob-frame {
  width: 390px;
  flex-shrink: 0;
  border-radius: 44px;
  overflow: hidden;
  border: 8px solid color-mix(in srgb, var(--text-primary) 20%, transparent);
  box-shadow: 0 0 0 1px var(--border), 0 24px 64px rgba(0,0,0,.4);
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
  user-select: none;
  -webkit-user-select: none;
  position: relative;
}

.mob-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
  background: var(--bg-sidebar);
  flex-shrink: 0;
}

/* ── Viewport + track ───────────────────────────────────────────────────────── */
.mob-viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  position: relative;
  height: 600px;
}

.mob-track {
  display: flex;
  width: 300%;
  height: 100%;
  will-change: transform;
  transform: translateX(0);
}

/* ── Panels ─────────────────────────────────────────────────────────────────── */
.mob-panel {
  width: 33.333%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Sidebar panel */
.mob-sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px 8px 16px;
  background: color-mix(in srgb, var(--bg-sidebar) 80%, transparent);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
  border-bottom: 1px solid transparent;
  transition: border-color 160ms;
}
.mob-sidebar-header.scrolled { border-bottom-color: var(--border); }

.mob-team-name { font-size:17px; font-weight:700; color:var(--text-primary); }
.mob-team-icon { width:30px; height:30px; border-radius:8px; background:var(--accent); color:white; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; }

.mob-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.03em;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  -webkit-tap-highlight-color: transparent;
}
.mob-avatar:active { opacity: 0.7; }

.mob-sidebar-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  background: var(--bg-sidebar);
  touch-action: pan-y;
}

/* Section labels */
.mob-section-label {
  padding: 14px 10px 4px 16px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  display: flex;
  align-items: center;
}

.mob-section-add {
  margin-left: auto;
  color: var(--text-muted);
  opacity: 0.7;
  padding: 4px;
  border: none;
  background: none;
  cursor: pointer;
}
.mob-section-add:hover { opacity: 1; color: var(--accent); }

/* ── Channel rows ───────────────────────────────────────────────────────────── */
.mob-ch-row { display:flex; align-items:center; gap:8px; padding:0 12px; min-height:40px; cursor:pointer; }
.mob-ch-row:hover { background:var(--bg-hover); }
.mob-ch-row.active { background:var(--bg-active); }
.mob-ch-prefix { width:16px; text-align:center; flex-shrink:0; font-size:14px; color:var(--text-muted); }
.mob-ch-name { flex:1; font-size:15px; color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.mob-ch-row.active .mob-ch-name { color:var(--text-primary); font-weight:600; }
.mob-thread-badge { font-size:11px; font-weight:600; color:var(--text-muted); background:var(--bg-hover); border-radius:8px; padding:1px 6px; flex-shrink:0; cursor:pointer; }
.mob-unread-dot { width:8px; height:8px; border-radius:50%; background:var(--accent); flex-shrink:0; }
.mob-join-pill { font-size:11px; font-weight:600; color:var(--accent); border:1px solid var(--accent); border-radius:10px; padding:1px 8px; flex-shrink:0; cursor:pointer; background:none; }
.mob-join-pill:active { background: color-mix(in srgb, var(--accent) 12%, transparent); }
.mob-session-badge-active { font-size:10px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:#22c55e; background:color-mix(in srgb,#22c55e 12%,transparent); border-radius:8px; padding:2px 7px; flex-shrink:0; }
.mob-session-badge-ended { font-size:10px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--text-muted); background:var(--bg-hover); border-radius:8px; padding:2px 7px; flex-shrink:0; }
.mob-session-row.ended { opacity:0.5; }

.mob-browse-all { display:block; padding:6px 16px 6px 36px; font-size:12px; color:var(--text-muted); cursor:pointer; text-decoration:none; }
.mob-browse-all:hover { color:var(--accent); text-decoration:underline; }

/* ── Thread subtree in sidebar ──────────────────────────────────────────────── */
.mob-thread-subtree { display:flex; flex-direction:column; padding:2px 0 4px 28px; }
