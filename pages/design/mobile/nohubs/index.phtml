// ============================================================================
// KNOB CONFIG
// ============================================================================
const knobDefs = [
  { key:'lockPx',     elId:'knob-nh-lock',   valId:'knob-nh-lock-val',   fn: v => +v,       fmt: v => `${v}`      },
  { key:'commitPct',  elId:'knob-nh-commit', valId:'knob-nh-commit-val', fn: v => +v,       fmt: v => `${v}%`     },
  { key:'velocityPx', elId:'knob-nh-vel',    valId:'knob-nh-vel-val',    fn: v => v / 100,  fmt: v => v.toFixed(2)},
  { key:'rubberBand', elId:'knob-nh-rubber', valId:'knob-nh-rubber-val', fn: v => v / 100,  fmt: v => v.toFixed(2)},
]
const config = {}
for (const d of knobDefs) {
  const el = document.getElementById(d.elId)
  const vl = document.getElementById(d.valId)
  Object.defineProperty(config, d.key, { get: () => d.fn(+el.value) })
  const upd = () => { vl.textContent = d.fmt(d.fn(+el.value)) }
  el.addEventListener('input', upd); upd()
}

// ============================================================================
// HELPERS
// ============================================================================
const escHtml = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
const timeStr = () => new Date().toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit' })

const AVATAR_PALETTE = ['#5865f2','#22c55e','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316']
const SENDER_COLORS  = { You:'#6366f1', System:'#64748b', Alice:'#5865f2', Bob:'#22c55e', Carol:'#f59e0b' }
const senderColor    = name => SENDER_COLORS[name] ?? AVATAR_PALETTE[Math.abs([...name].reduce((h,c) => (h*31+c.charCodeAt(0))|0, 0)) % AVATAR_PALETTE.length]
const senderInitials = name => { const p=name.trim().split(/\s+/); return (p.length>1 ? p[0][0]+p[p.length-1][0] : name.slice(0,2)).toUpperCase() }

const msgInnerHtml = (handle, time, bodyHtml, extraHtml = '') => {
  const color = senderColor(handle); const init = senderInitials(handle)
  const timeEl = time ? `<time class="message-time">${escHtml(time)}</time>` : ''
  return `<div class="mob-msg-avatar"><div class="mob-msg-avatar-circle" style="background:${color}">${escHtml(init)}</div></div>` +
    `<div class="mob-msg-header"><span class="message-handle" style="color:${color}">${escHtml(handle)}</span>${timeEl}</div>` +
    `<div class="message-text">${bodyHtml}</div>${extraHtml}`
}

// ============================================================================
// APP MODEL
// ============================================================================
class AppModel extends EventTarget {
  #channels
  #threads
  #activeId = null
  #activeSection = null
  #expandedThreadChannelId = null
  #panel2Mode = 'thread'
  #activeThread = null
  #replyingTo = null
  #callState = 'idle'
  #callParticipants = []
  #callChannelId = null

  constructor(channels, threads) {
    super()
    this.#channels = JSON.parse(JSON.stringify(channels))
    this.#threads  = JSON.parse(JSON.stringify(threads))
  }

  #emit(type, detail = {}) { this.dispatchEvent(new CustomEvent(type, { detail })) }

  // ── Accessors ──────────────────────────────────────────────────────────────
  get channels()                { return this.#channels }
  get threads()                 { return this.#threads }
  get activeId()                { return this.#activeId }
  get activeSection()           { return this.#activeSection }
  get expandedThreadChannelId() { return this.#expandedThreadChannelId }
  get panel2Mode()              { return this.#panel2Mode }
  get activeThread()            { return this.#activeThread }
  get replyingTo()              { return this.#replyingTo }
  get callState()               { return this.#callState }
  get callParticipants()        { return this.#callParticipants }

  get activeChannel() {
    if (!this.#activeId || !this.#activeSection) return null
    const list = this.#activeSection === 'sessions'
      ? this.#channels.sessions
      : this.#activeSection === 'dms'
        ? this.#channels.dms
        : this.#channels[this.#activeSection]
    return list?.find(c => c.id === this.#activeId) ?? null
  }

  // ── Channel mutations ──────────────────────────────────────────────────────
  selectChannel(id, section) {
    if (this.#expandedThreadChannelId && this.#expandedThreadChannelId !== id) {
      this.#expandedThreadChannelId = null
    }
    this.#activeId = id
    this.#activeSection = section
    // Auto-expand threads if channel has them
    const ch = this.activeChannel
    if (ch && (this.#threads[id]?.length ?? 0) > 0) {
      this.#expandedThreadChannelId = id
    }
    this.#emit('channel:selected', { channel: ch, section })
  }

  joinChannel(id) {
    const ch = this.#channels.public.find(c => c.id === id)
    if (ch) { ch.joined = true; this.#emit('channel:joined', { channel: ch }) }
  }

  toggleThreadExpansion(channelId) {
    this.#expandedThreadChannelId = this.#expandedThreadChannelId === channelId ? null : channelId
    this.#emit('threads:toggled', { channelId })
  }

  openThread(thread, channel) {
    this.#activeThread = { thread, channel }
    this.#panel2Mode = 'thread'
    this.#emit('thread:opened', { thread, channel })
  }

  openThreadSearch(channelId) {
    this.#panel2Mode = 'search'
    const ch = this.activeChannel || this.#findChannel(channelId)
    this.#emit('thread:search-opened', { channelId, channel: ch })
  }

  endSession(sessionId) {
    const ses = this.#channels.sessions.find(s => s.id === sessionId)
    if (ses) { ses.status = 'ended'; ses.endedAt = 'just now'; this.#emit('session:ended', { session: ses }) }
  }

  #findChannel(id) {
    for (const section of ['public','private','sessions','dms']) {
      const ch = this.#channels[section]?.find(c => c.id === id)
      if (ch) return ch
    }
    return null
  }

  // ── Message / reply ────────────────────────────────────────────────────────
  setReplyingTo(handle, text) {
    this.#replyingTo = { handle, text }
    this.#emit('reply:changed', { replyingTo: this.#replyingTo })
  }

  clearReply() {
    this.#replyingTo = null
    this.#emit('reply:changed', { replyingTo: null })
  }

  sendMessage(text) {
    const msg = { text, handle:'You', replyingTo: this.#replyingTo, ts: Date.now() }
    this.clearReply()
    this.#emit('message:sent', { message: msg })
  }

  sendThreadReply(text) {
    this.#emit('thread:reply-sent', { message: { text, handle:'You', ts: Date.now() } })
  }

  // ── Call ────────────────────────────────────────────────────────────────────
  startCall() {
    if (this.#activeSection === 'dms') return
    if (this.#callState === 'active') { this.#emit('call:sheet-requested'); return }
    this.#callState = 'active'
    this.#callChannelId = this.#activeId
    this.#callParticipants = [
      { id:'you', name:'You', initials:'JG', color:'#5865f2', muted:false, speaking:false },
    ]
    this.#emit('call:started', { channel: this.activeChannel, participants: this.#callParticipants })
    setTimeout(() => {
      this.#callParticipants.push({ id:'u_alice', name:'Alice', initials:'AL', color:'#22c55e', muted:false, speaking:true })
      this.#emit('call:participants-changed', { participants: this.#callParticipants })
    }, 1500)
    setTimeout(() => {
      this.#callParticipants.push({ id:'u_bob', name:'Bob', initials:'BO', color:'#f59e0b', muted:true, speaking:false })
      const alice = this.#callParticipants.find(p => p.id === 'u_alice')
      if (alice) alice.speaking = false
      this.#emit('call:participants-changed', { participants: this.#callParticipants })
    }, 4000)
  }

  simulateIncomingCall() {
    this.#emit('call:incoming', {
      from: { name:'Alice', initials:'AL', color:'#22c55e' },
      channel: this.activeChannel,
    })
  }

  joinCall() { this.startCall() }

  leaveCall() {
    if (this.#callState === 'idle') return
    this.#callState = 'idle'
    this.#callParticipants = []
    this.#callChannelId = null
    this.#emit('call:ended')
  }

  toggleMute() {
    const you = this.#callParticipants.find(p => p.id === 'you')
    if (!you) return
    you.muted = !you.muted
    this.#emit('call:participants-changed', { participants: this.#callParticipants })
  }
}

// ============================================================================
// SHEET CONTROLLER
// ============================================================================
class SheetController {
  #sheet; #backdrop
  #dragStart = 0; #dragTime = 0; #dragging = false
  #isDragTargetFn
  static #COMMIT_PX = 80; static #COMMIT_VEL = 0.4

  constructor(sheet, backdrop, {
    handleSelector = '.mob-edit-handle, .mob-edit-toolbar',
    isDragTarget,
  } = {}) {
    this.#sheet    = sheet
    this.#backdrop = backdrop
    this.#isDragTargetFn = isDragTarget ?? (el => !!el.closest(handleSelector))
    this.#bindSwipeDismiss()
    if (backdrop) {
      backdrop.addEventListener('click',    () => this.hide())
      backdrop.addEventListener('touchend', e  => { e.preventDefault(); this.hide() }, { passive: false })
    }
  }

  get el()     { return this.#sheet }
  isOpen()     { return this.#sheet.classList.contains('is-open') }

  show() { this.#backdrop?.classList.add('is-open'); this.#sheet.classList.add('is-open') }

  hide() {
    this.#sheet.style.transform = 'translateY(100%)'
    this.#sheet.addEventListener('transitionend', () => {
      this.#sheet.style.transform = ''
      this.#backdrop?.classList.remove('is-open')
      this.#sheet.classList.remove('is-open')
    }, { once: true })
  }

  #begin(clientY, ts) {
    this.#dragging = true; this.#dragStart = clientY; this.#dragTime = ts
    this.#sheet.style.transition = 'none'
  }
  #move(clientY) {
    if (!this.#dragging) return
    this.#sheet.style.transform = `translateY(${Math.max(0, clientY - this.#dragStart)}px)`
  }
  #end(clientY, ts) {
    if (!this.#dragging) return
    this.#dragging = false
    const dy  = Math.max(0, clientY - this.#dragStart)
    const vel = dy / Math.max(ts - this.#dragTime, 1)
    this.#sheet.style.transition = ''
    if (dy > SheetController.#COMMIT_PX || vel > SheetController.#COMMIT_VEL) {
      this.hide()
    } else {
      this.#sheet.style.transform = ''
    }
  }

  #bindSwipeDismiss() {
    const s = this.#sheet
    s.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || !this.#isDragTargetFn(e.target)) return
      this.#begin(e.touches[0].clientY, e.timeStamp)
    }, { passive: true })
    s.addEventListener('touchmove', e => {
      if (!this.#dragging) return
      this.#move(e.touches[0].clientY)
    }, { passive: true })
    s.addEventListener('touchend',   e => { this.#end(e.changedTouches[0].clientY, e.timeStamp) }, { passive: true })
    s.addEventListener('touchcancel', () => { this.#dragging = false; s.style.transition = ''; s.style.transform = '' })
    s.addEventListener('mousedown', e => {
      if (!this.#isDragTargetFn(e.target)) return
      this.#begin(e.clientY, e.timeStamp); e.preventDefault()
    })
    document.addEventListener('mousemove', e => { if (this.#dragging) this.#move(e.clientY) })
    document.addEventListener('mouseup',   e => { if (this.#dragging) this.#end(e.clientY, e.timeStamp) })
  }
}

// ============================================================================
// NAVIGATION VIEW
// ============================================================================
class NavigationView {
  #model; #viewport; #track; #config
  #panel = 0
  #startX = 0; #startY = 0; #startTime = 0
  #locked = null; #active = false
  #ctx = null
  #dbg

  constructor(model, { viewport, track, backBtn, threadBackBtn, threadSearchBackBtn, config, dbg = {} }) {
    this.#model    = model
    this.#viewport = viewport
    this.#track    = track
    this.#config   = config
    this.#dbg      = dbg

    model.addEventListener('channel:selected',      () => this.goTo(1))
    model.addEventListener('thread:opened',         () => this.goTo(2))
    model.addEventListener('thread:search-opened',  () => this.goTo(2))

    backBtn?.addEventListener('click',              () => this.goTo(0))
    threadBackBtn?.addEventListener('click',        () => this.goTo(1))
    threadSearchBackBtn?.addEventListener('click',  () => this.goTo(1))

    this.#bindTouch()
    this.#bindMouse()
    this.goTo(1, false)
  }

  setCtx(ctx) { this.#ctx = ctx }
  get panel()  { return this.#panel }

  goTo(index, animate = true) {
    this.#panel = Math.max(0, Math.min(PANELS.length - 1, index))
    const pct   = -(this.#panel * (100 / PANELS.length))
    this.#track.style.transition = animate ? 'transform 320ms cubic-bezier(0.32,0.72,0,1)' : 'none'
    this.#track.style.transform  = `translateX(${pct}%)`
    if (this.#dbg.panel) this.#dbg.panel.textContent = `panel: ${PANELS[this.#panel]}`
    this.#model.dispatchEvent(new CustomEvent('panel:changed',
      { detail: { panel: this.#panel, name: PANELS[this.#panel] } }))
  }

  #panelPct(i) { return -(i * (100 / PANELS.length)) }

  #clamp(raw, min, max) {
    if (raw >= min && raw <= max) return raw
    const r = this.#config.rubberBand
    return raw < min ? min - (min - raw) * r : max + (raw - max) * r
  }

  #moveXY(cx, cy) {
    const dx = cx - this.#startX, dy = cy - this.#startY
    if (this.#dbg.dx) this.#dbg.dx.textContent = `dx: ${Math.round(dx)}`
    if (!this.#locked) {
      if (Math.abs(dx) < this.#config.lockPx && Math.abs(dy) < this.#config.lockPx) return false
      this.#locked = Math.abs(dx) >= Math.abs(dy) ? 'h' : 'v'
      if (this.#dbg.dir) this.#dbg.dir.textContent = `dir: ${this.#locked}`
    }
    if (this.#locked !== 'h') return false
    const vpW    = this.#viewport.offsetWidth
    const trackW = vpW * PANELS.length
    const base   = this.#panelPct(this.#panel) / 100 * trackW
    const clamped = this.#clamp(base + dx, -(trackW - vpW), 0)
    this.#track.style.transform = `translateX(${clamped / trackW * 100}%)`
    return true
  }

  #endGesture(cx, ts) {
    this.#active = false
    if (this.#locked !== 'h') { this.#locked = null; return }
    const dx   = cx - this.#startX
    const vel  = Math.abs(dx) / Math.max(ts - this.#startTime, 1)
    const vpW  = this.#viewport.offsetWidth
    const past = Math.abs(dx) >= vpW * (this.#config.commitPct / 100)
    if (this.#dbg.vel) this.#dbg.vel.textContent = `vel: ${vel.toFixed(2)}`
    let target = this.#panel
    if ((past || vel >= this.#config.velocityPx) && dx < 0) target = Math.min(this.#panel + 1, PANELS.length - 1)
    if ((past || vel >= this.#config.velocityPx) && dx > 0) target = Math.max(this.#panel - 1, 0)
    this.goTo(target)
    this.#locked = null
  }

  #begin(cx, cy, ts) {
    this.#startX = cx; this.#startY = cy; this.#startTime = ts
    this.#locked = null; this.#active = true
    this.#track.style.transition = 'none'
    if (this.#dbg.dir) this.#dbg.dir.textContent = 'dir: ?'
    if (this.#dbg.vel) this.#dbg.vel.textContent = 'vel: -'
  }

  #bindTouch() {
    this.#viewport.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || this.#ctx?.isOpen) return
      this.#begin(e.touches[0].clientX, e.touches[0].clientY, e.timeStamp)
    }, { passive: true })
    this.#viewport.addEventListener('touchmove', e => {
      if (!this.#active || e.touches.length !== 1) return
      if (this.#moveXY(e.touches[0].clientX, e.touches[0].clientY)) e.preventDefault()
    }, { passive: false })
    this.#viewport.addEventListener('touchend', e => {
      if (!this.#active) return
      this.#endGesture(e.changedTouches[0].clientX, e.timeStamp)
    }, { passive: true })
    this.#viewport.addEventListener('touchcancel', () => {
      if (!this.#active) return
      this.#active = false; this.#locked = null; this.goTo(this.#panel)
    })
  }

  #bindMouse() {
    this.#viewport.addEventListener('mousedown', e => {
      if (e.button !== 0 || this.#ctx?.isOpen) return
      if (e.target.closest('input, textarea, select, [contenteditable]')) return
      this.#begin(e.clientX, e.clientY, e.timeStamp); e.preventDefault()
    })
    document.addEventListener('mousemove', e => { if (this.#active) this.#moveXY(e.clientX, e.clientY) })
    document.addEventListener('mouseup',   e => { if (this.#active) this.#endGesture(e.clientX, e.timeStamp) })
  }
}

// ============================================================================
// SIDEBAR VIEW
// ============================================================================
class SidebarView {
  #model; #nav; #scrollEl; #ctx

  constructor(model, { nav, scrollEl, ctx }) {
    this.#model = model
    this.#nav = nav
    this.#scrollEl = scrollEl
    this.#ctx = ctx

    for (const ev of ['channel:selected','channel:joined','threads:toggled','session:ended']) {
      model.addEventListener(ev, () => this.render())
    }

    // Event delegation
    scrollEl.addEventListener('click', e => {
      if (this.#ctx?.lpFired) return

      // Join pill
      const joinPill = e.target.closest('.mob-join-pill')
      if (joinPill) {
        e.stopPropagation()
        const row = joinPill.closest('.mob-ch-row')
        if (row) model.joinChannel(row.dataset.id)
        return
      }

      // Thread badge on non-active channel: select + expand
      const badge = e.target.closest('.mob-thread-badge')
      if (badge) {
        e.stopPropagation()
        const row = badge.closest('.mob-ch-row')
        if (row) {
          const id = row.dataset.id
          const section = row.dataset.section
          if (id !== model.activeId) {
            model.selectChannel(id, section)
          } else {
            model.toggleThreadExpansion(id)
          }
        }
        return
      }

      // Thread sub-item
      const subItem = e.target.closest('.mob-thread-sub-item')
      if (subItem) {
        const threadId = subItem.dataset.threadId
        const channelId = subItem.dataset.channelId
        const ch = model.activeChannel
        const threads = model.threads[channelId] ?? []
        const thread = threads.find(t => t.id === threadId)
        if (thread && ch) model.openThread(thread, ch)
        return
      }

      // View all threads
      const viewAll = e.target.closest('.mob-thread-view-all')
      if (viewAll) {
        const channelId = viewAll.dataset.channelId
        model.openThreadSearch(channelId)
        return
      }

      // Channel / session / DM row
      const row = e.target.closest('.mob-ch-row')
      if (row) {
        const id = row.dataset.id
        const section = row.dataset.section
        // If already active and has threads, toggle expansion
        if (id === model.activeId && model.expandedThreadChannelId === id) {
          model.toggleThreadExpansion(id)
        } else {
          model.selectChannel(id, section)
        }
        return
      }
    }, true)
  }

  render() {
    const m = this.#model
    let html = ''

    // PUBLIC section
    html += this.#sectionHeader('PUBLIC', 'mob-nh-add-public')
    for (const ch of m.channels.public) {
      html += this.#channelRow(ch, 'public', '#')
      if (m.expandedThreadChannelId === ch.id) html += this.#threadSubtree(ch.id)
    }
    html += `<span class="mob-browse-all">Browse all channels</span>`

    // PRIVATE section
    html += this.#sectionHeader('PRIVATE', 'mob-nh-add-private')
    for (const ch of m.channels.private) {
      html += this.#channelRow(ch, 'private', '')
      if (m.expandedThreadChannelId === ch.id) html += this.#threadSubtree(ch.id)
    }

    // SESSIONS section
    html += this.#sectionHeader('SESSIONS', 'mob-nh-add-session')
    for (const ses of m.channels.sessions) {
      html += this.#sessionRow(ses)
      if (m.expandedThreadChannelId === ses.id) html += this.#threadSubtree(ses.id)
    }

    // DIRECT MESSAGES section
    html += this.#sectionHeader('DIRECT MESSAGES', 'mob-nh-add-dm')
    for (const dm of m.channels.dms) {
      html += this.#dmRow(dm)
    }

    this.#scrollEl.innerHTML = html

    // Scroll active into view
    const activeRow = this.#scrollEl.querySelector('.mob-ch-row.active')
    if (activeRow) activeRow.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
  }

  #sectionHeader(label, addId) {
    return `<div class="mob-section-label">${escHtml(label)}<button class="mob-section-add btn-icon" id="${addId}" type="button" title="Add" aria-label="Add"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="1" x2="7" y2="13"/><line x1="1" y1="7" x2="13" y2="7"/></svg></button></div>`
  }

  #channelRow(ch, section, prefixChar) {
    const active = ch.id === this.#model.activeId
    const prefix = section === 'private'
      ? `<span class="mob-ch-prefix" style="font-size:12px">lock</span>`
      : `<span class="mob-ch-prefix">${escHtml(prefixChar)}</span>`

    let right = ''
    if (!ch.joined && section === 'public') {
      right = `<button class="mob-join-pill" type="button">Join</button>`
    } else if (ch.unread && !active) {
      right = `<span class="mob-unread-dot"></span>`
    } else if (ch.threadCount > 0 && !active) {
      right = `<span class="mob-thread-badge">${ch.threadCount}</span>`
    }

    return `<div class="mob-ch-row${active ? ' active' : ''}" data-id="${ch.id}" data-section="${section}" role="button" tabindex="0">${prefix}<span class="mob-ch-name">${escHtml(ch.name)}</span>${right}</div>`
  }

  #sessionRow(ses) {
    const active = ses.id === this.#model.activeId
    const ended = ses.status === 'ended'
    let badge = ended
      ? `<span class="mob-session-badge-ended">Ended lock</span>`
      : `<span class="mob-session-badge-active">Active</span>`

    return `<div class="mob-ch-row mob-session-row${ended ? ' ended' : ''}${active ? ' active' : ''}" data-id="${ses.id}" data-section="sessions" role="button" tabindex="0"><span class="mob-ch-prefix">clip</span><span class="mob-ch-name">${escHtml(ses.name)}</span>${badge}</div>`
  }

  #dmRow(dm) {
    const active = dm.id === this.#model.activeId
    let right = dm.unread ? `<span class="mob-unread-dot"></span>` : ''
    return `<div class="mob-ch-row${active ? ' active' : ''}" data-id="${dm.id}" data-section="dms" role="button" tabindex="0"><span class="mob-ch-prefix" style="font-size:13px">@</span><span class="mob-ch-name">${escHtml(dm.name)}</span>${right}</div>`
  }

  #threadSubtree(channelId) {
    const threads = this.#model.threads[channelId] ?? []
    if (threads.length === 0) return ''
    const showMax = 5
    const visible = threads.length > showMax ? threads.slice(0, showMax - 1) : threads
    const hasMore = threads.length > showMax || threads.length > visible.length

    let html = `<div class="mob-thread-subtree">`
    for (const t of visible) {
      html += `<div class="mob-thread-sub-item" data-thread-id="${t.id}" data-channel-id="${channelId}" role="button" tabindex="0">`
      html += `<span class="mob-thread-sub-connector">|_</span>`
      html += `<span class="mob-thread-sub-text">${escHtml(t.rootMsg)}</span>`
      html += `<span class="mob-thread-sub-meta">${t.replies}r ${t.lastActivity}</span>`
      html += `</div>`
    }
    if (hasMore || threads.length > 1) {
      html += `<button class="mob-thread-view-all" data-channel-id="${channelId}" type="button">view all ${threads.length} threads</button>`
    }
    html += `</div>`
    return html
  }
}

// ============================================================================
// CHAT VIEW
// ============================================================================
class ChatView {
  #model
  #messages; #input; #sendBtn; #composerEl
  #titleEl; #typeEl; #sessionBanner; #sessionAvatars; #sessionInfo
  #replyBar; #replyName; #replyText; #replyDismiss
  #ptrBar; #ptrStartY = 0; #ptrPulling = false; #ptrLocked = false
  #joinBanner; #joinBannerName; #joinBannerBtn

  constructor(model) {
    this.#model        = model
    this.#messages     = document.getElementById('mob-nh-messages')
    this.#input        = document.getElementById('mob-nh-composer-input')
    this.#sendBtn      = document.getElementById('mob-nh-composer-send')
    this.#composerEl   = document.getElementById('mob-nh-composer')
    this.#titleEl      = document.getElementById('mob-nh-chat-title')
    this.#typeEl       = document.getElementById('mob-nh-chat-type')
    this.#sessionBanner = document.getElementById('mob-nh-session-banner')
    this.#sessionAvatars = document.getElementById('mob-nh-session-avatars')
    this.#sessionInfo   = document.getElementById('mob-nh-session-info')
    this.#replyBar     = document.getElementById('mob-nh-reply-quote')
    this.#replyName    = document.getElementById('mob-nh-reply-quote-name')
    this.#replyText    = document.getElementById('mob-nh-reply-quote-text')
    this.#replyDismiss = document.getElementById('mob-nh-reply-quote-dismiss')
    this.#ptrBar       = document.getElementById('mob-nh-ptr-bar')
    this.#joinBanner   = document.getElementById('mob-nh-join-banner')
    this.#joinBannerName = document.getElementById('mob-nh-join-banner-name')
    this.#joinBannerBtn  = document.getElementById('mob-nh-join-banner-btn')

    model.addEventListener('channel:selected', ({ detail }) => this.#updateChannel(detail.channel, detail.section))
    model.addEventListener('message:sent',     ({ detail: { message } }) => this.#append(message))
    model.addEventListener('reply:changed',    ({ detail: { replyingTo } }) => this.#updateReplyBar(replyingTo))
    model.addEventListener('channel:joined',   () => { this.#joinBanner.style.display = 'none' })

    this.#sendBtn.addEventListener('click', () => this.#send())
    this.#input.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.#send() }
      if (e.key === 'Escape') model.clearReply()
    })
    this.#replyDismiss.addEventListener('click', () => model.clearReply())
    this.#joinBannerBtn.addEventListener('click', () => {
      model.joinChannel(model.activeId)
    })

    this.#bindPtr()
    this.#messages.scrollTop = 9999
  }

  addReaction(article, emoji) {
    let bar = article.querySelector('.reaction-bar')
    if (!bar) { bar = document.createElement('div'); bar.className = 'reaction-bar'; article.appendChild(bar) }
    const pill = [...bar.querySelectorAll('.reaction-pill')].find(p => p.textContent.startsWith(emoji))
    if (pill) {
      pill.querySelector('.reaction-count').textContent = +pill.querySelector('.reaction-count').textContent + 1
      pill.classList.toggle('reacted')
    } else {
      const btn = document.createElement('button')
      btn.className = 'reaction-pill reacted'; btn.type = 'button'
      btn.innerHTML = `${emoji} <span class="reaction-count">1</span>`
      bar.appendChild(btn)
    }
  }

  #updateChannel(channel, section) {
    if (!channel) return
    const prefixes = { public:'#', private:'lock ', sessions:'clip ', dms:'' }
    const typeLabels = { public:'Public', private:'Private', sessions:'Session', dms:'Direct Message' }
    const prefix = prefixes[section] ?? ''
    this.#titleEl.textContent = `${prefix}${channel.name}`
    this.#typeEl.textContent = typeLabels[section] ?? ''
    this.#input.placeholder = `Message ${prefix}${channel.name}...`

    // Join banner for unjoined public channels
    if (section === 'public' && !channel.joined) {
      this.#joinBannerName.textContent = `#${channel.name}`
      this.#joinBanner.style.display = 'flex'
    } else {
      this.#joinBanner.style.display = 'none'
    }

    // Session banner
    if (section === 'sessions') {
      this.#sessionBanner.style.display = 'flex'
      const ended = channel.status === 'ended'
      this.#sessionBanner.classList.toggle('ended', ended)

      const colors = ['#5865f2','#22c55e','#f59e0b','#ef4444','#8b5cf6']
      const members = channel.members ?? []
      this.#sessionAvatars.innerHTML = members.map((m, i) =>
        `<div class="mob-session-mini-avatar" style="background:${colors[i % colors.length]}">${senderInitials(m)}</div>`
      ).join('')

      if (ended) {
        this.#sessionInfo.innerHTML = `lock Session ended ${escHtml(channel.endedAt ?? '')}`
      } else {
        this.#sessionInfo.textContent = `Owner: ${channel.owner} | ${members.length} members | Ends in ${channel.autoEndDays} days`
      }

      // Disable composer for ended sessions
      this.#input.disabled = ended
      this.#input.placeholder = ended ? 'This session has ended' : `Message clip ${channel.name}...`
      this.#sendBtn.style.display = ended ? 'none' : ''
    } else {
      this.#sessionBanner.style.display = 'none'
      this.#input.disabled = false
      this.#sendBtn.style.display = ''
    }
  }

  #send() {
    const text = this.#input.value.trim()
    if (!text || this.#input.disabled) return
    // Auto-join public channel on first message
    const ch = this.#model.activeChannel
    if (this.#model.activeSection === 'public' && ch && !ch.joined) {
      this.#model.joinChannel(this.#model.activeId)
      // Insert system message before the user's message
      const sysMsg = document.createElement('article')
      sysMsg.className = 'mob-system-msg'
      sysMsg.textContent = `You joined #${ch.name}`
      this.#messages.appendChild(sysMsg)
    }
    this.#model.sendMessage(text)
    this.#input.value = ''
  }

  #append(msg) {
    const lastSender = this.#messages.lastElementChild?.dataset.sender
    const isNew = lastSender !== msg.handle
    const art = document.createElement('article')
    art.className = 'message' + (isNew ? ' new-sender' : '')
    art.dataset.sender = msg.handle
    let replyHtml = ''
    if (msg.replyingTo) replyHtml =
      `<div style="font-size:12px;color:var(--text-muted);padding:2px 0 4px;display:flex;gap:6px;align-items:center">` +
      `<span style="width:2px;height:12px;background:var(--accent);border-radius:1px;flex-shrink:0"></span>` +
      `<b style="color:var(--text-secondary)">${escHtml(msg.replyingTo.handle)}</b>` +
      `<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(msg.replyingTo.text)}</span></div>`
    art.innerHTML = msgInnerHtml(msg.handle, timeStr(), `${replyHtml}<p>${escHtml(msg.text)}</p>`)
    this.#messages.appendChild(art)
    this.#messages.scrollTop = this.#messages.scrollHeight
  }

  #updateReplyBar(rt) {
    if (!rt) {
      this.#replyBar.style.display = 'none'
    } else {
      this.#replyName.textContent = rt.handle
      this.#replyText.textContent = rt.text
      this.#replyBar.style.display = 'flex'
      this.#input.focus()
    }
  }

  #bindPtr() {
    const el = this.#messages
    el.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || el.scrollTop > 0) return
      this.#ptrStartY = e.touches[0].clientY; this.#ptrPulling = true; this.#ptrLocked = false
    }, { passive: true })
    el.addEventListener('touchmove', e => {
      if (!this.#ptrPulling) return
      const dy = e.touches[0].clientY - this.#ptrStartY
      this.#ptrBar.classList.toggle('is-visible', dy > 24)
      this.#ptrLocked = dy > 72
    }, { passive: true })
    el.addEventListener('touchend', () => {
      if (!this.#ptrPulling) return; this.#ptrPulling = false
      if (this.#ptrLocked) {
        this.#ptrBar.classList.add('is-loading')
        setTimeout(() => {
          const stub = document.createElement('article')
          stub.className = 'message new-sender'
          stub.dataset.sender = 'System'
          stub.innerHTML = msgInnerHtml('System', 'earlier', '<p>Earlier messages loaded.</p>')
          el.insertBefore(stub, el.firstChild)
          this.#ptrBar.classList.remove('is-visible','is-loading')
        }, 1000)
      } else {
        this.#ptrBar.classList.remove('is-visible')
      }
    }, { passive: true })
    el.addEventListener('touchcancel', () => {
      this.#ptrPulling = false; this.#ptrBar.classList.remove('is-visible','is-loading')
    }, { passive: true })
  }
}

// ============================================================================
// THREAD VIEW
// ============================================================================
class ThreadView {
  #model
  #detailView; #searchView
  #messages; #composer; #sendBtn; #title; #subtitle
  #searchTitle; #searchSubtitle; #searchInput; #searchList

  constructor(model) {
    this.#model      = model
    this.#detailView = document.getElementById('mob-nh-thread-detail-view')
    this.#searchView = document.getElementById('mob-nh-thread-search-view')
    this.#messages   = document.getElementById('mob-nh-thread-messages')
    this.#composer   = document.getElementById('mob-nh-thread-composer')
    this.#sendBtn    = document.getElementById('mob-nh-thread-send')
    this.#title      = document.getElementById('mob-nh-thread-title')
    this.#subtitle   = document.getElementById('mob-nh-thread-subtitle')
    this.#searchTitle    = document.getElementById('mob-nh-thread-search-title')
    this.#searchSubtitle = document.getElementById('mob-nh-thread-search-subtitle')
    this.#searchInput    = document.getElementById('mob-nh-thread-search-input')
    this.#searchList     = document.getElementById('mob-nh-thread-search-list')

    model.addEventListener('thread:opened',         ({ detail }) => this.#openDetail(detail))
    model.addEventListener('thread:search-opened',  ({ detail }) => this.#openSearch(detail))
    model.addEventListener('thread:reply-sent',     ({ detail: { message } }) => this.#appendReply(message))

    this.#sendBtn.addEventListener('click', () => this.#send())
    this.#composer.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.#send() }
    })

    this.#searchInput.addEventListener('input', () => this.#filterSearch())

    this.#searchList.addEventListener('click', e => {
      const item = e.target.closest('.mob-thread-search-item')
      if (!item) return
      const threadId = item.dataset.threadId
      const channelId = item.dataset.channelId
      const threads = model.threads[channelId] ?? []
      const thread = threads.find(t => t.id === threadId)
      const channel = model.activeChannel
      if (thread && channel) model.openThread(thread, channel)
    })
  }

  #openDetail({ thread, channel }) {
    this.#detailView.style.display = ''
    this.#searchView.style.display = 'none'

    const chName = channel ? `#${channel.name}` : 'channel'
    this.#title.textContent = 'Thread'
    this.#subtitle.textContent = chName
    this.#composer.placeholder = `Reply in ${chName}...`

    const root = document.createElement('article')
    root.className = 'message mob-thread-root new-sender'
    root.dataset.sender = thread.author
    root.innerHTML = msgInnerHtml(thread.author, '', `<p>${escHtml(thread.rootMsg)}</p>`)

    const divider = document.createElement('div')
    divider.className = 'mob-thread-divider'
    divider.textContent = `${thread.replies} repl${thread.replies === 1 ? 'y' : 'ies'}`

    const stub = document.createElement('article')
    stub.className = 'message mob-thread-reply new-sender'
    stub.dataset.sender = 'Alice'
    stub.innerHTML = msgInnerHtml('Alice', 'just now', '<p>Thanks for the heads up</p>')

    this.#messages.replaceChildren(root, divider, stub)
    this.#messages.scrollTop = 0
  }

  #openSearch({ channelId, channel }) {
    this.#detailView.style.display = 'none'
    this.#searchView.style.display = 'flex'

    const chName = channel ? `#${channel.name}` : '#channel'
    this.#searchTitle.textContent = 'Threads'
    this.#searchSubtitle.textContent = chName
    this.#searchInput.value = ''

    this._searchChannelId = channelId
    this.#renderSearchList(this.#model.threads[channelId] ?? [])
    this.#searchInput.focus()
  }

  #filterSearch() {
    const query = this.#searchInput.value.toLowerCase().trim()
    const threads = this.#model.threads[this._searchChannelId] ?? []
    const filtered = query
      ? threads.filter(t =>
          t.rootMsg.toLowerCase().includes(query) || t.author.toLowerCase().includes(query)
        )
      : threads
    this.#renderSearchList(filtered)
  }

  #renderSearchList(threads) {
    if (threads.length === 0) {
      this.#searchList.innerHTML = `<div class="mob-search-empty">No threads yet. Start one by long-pressing a message.</div>`
      return
    }

    // Group into Recent (m/h suffix) and Earlier (d suffix)
    const recent  = threads.filter(t => t.lastActivity.endsWith('m') || t.lastActivity.endsWith('h'))
    const earlier = threads.filter(t => t.lastActivity.endsWith('d'))

    let html = ''
    if (recent.length) {
      html += `<div class="mob-search-section-title">Recent</div>`
      html += recent.map(t => this.#threadSearchItemHtml(t)).join('')
    }
    if (earlier.length) {
      html += `<div class="mob-search-section-title">Earlier</div>`
      html += earlier.map(t => this.#threadSearchItemHtml(t)).join('')
    }

    this.#searchList.innerHTML = html
  }

  #threadSearchItemHtml(t) {
    const color = senderColor(t.author)
    const init = senderInitials(t.author)
    return `<div class="mob-thread-search-item" data-thread-id="${t.id}" data-channel-id="${this._searchChannelId}" role="button" tabindex="0">
      <div class="mob-search-result-avatar" style="background:${color}">${escHtml(init)}</div>
      <div class="mob-thread-search-body">
        <div class="mob-thread-search-msg">${escHtml(t.rootMsg)}</div>
        <div class="mob-thread-search-meta">${t.replies} replies \u00b7 ${t.lastActivity} ago</div>
      </div>
    </div>`
  }

  #appendReply(msg) {
    const divider = this.#messages.querySelector('.mob-thread-divider')
    if (divider) {
      const parts = divider.textContent.match(/\d+/)
      const n = (parts ? +parts[0] : 0) + 1
      divider.textContent = `${n} repl${n === 1 ? 'y' : 'ies'}`
    }
    const lastSender = this.#messages.lastElementChild?.dataset.sender
    const isNew = lastSender !== msg.handle
    const art = document.createElement('article')
    art.className = 'message mob-thread-reply' + (isNew ? ' new-sender' : '')
    art.dataset.sender = msg.handle
    art.innerHTML = msgInnerHtml(msg.handle, timeStr(), `<p>${escHtml(msg.text)}</p>`)
    this.#messages.appendChild(art)
    this.#messages.scrollTop = this.#messages.scrollHeight
  }

  #send() {
    const text = this.#composer.value.trim()
    if (!text) return
    this.#model.sendThreadReply(text)
    this.#composer.value = ''
  }
}

// ============================================================================
// CALL VIEW
// ============================================================================
class CallView {
  #model; #sc
  #sheetEl; #backdropEl; #barEl; #barTextEl; #barTimerEl
  #participantsEl; #timerEl; #channelInfoEl
  #muteBtn; #cameraBtn; #speakerBtn; #hangupBtn; #barLeaveBtn; #callHeaderBtn
  #timerInterval = null; #elapsed = 0
  #muted = false; #cameraOn = false; #speakerOn = true

  constructor(model) {
    this.#model       = model
    this.#sheetEl     = document.getElementById('mob-nh-call-sheet')
    this.#backdropEl  = document.getElementById('mob-nh-call-backdrop')
    this.#barEl       = document.getElementById('mob-nh-call-bar')
    this.#barTextEl   = document.getElementById('mob-nh-call-bar-text')
    this.#barTimerEl  = document.getElementById('mob-nh-call-bar-timer')
    this.#participantsEl = document.getElementById('mob-nh-call-participants')
    this.#timerEl        = document.getElementById('mob-nh-call-timer')
    this.#channelInfoEl  = document.getElementById('mob-nh-call-channel-info')
    this.#muteBtn    = document.getElementById('mob-nh-call-mute')
    this.#cameraBtn  = document.getElementById('mob-nh-call-camera')
    this.#speakerBtn = document.getElementById('mob-nh-call-speaker')
    this.#hangupBtn  = document.getElementById('mob-nh-call-hangup')
    this.#barLeaveBtn = document.getElementById('mob-nh-call-bar-leave')
    this.#callHeaderBtn = document.getElementById('mob-nh-call-header-btn')

    this.#sc = new SheetController(this.#sheetEl, this.#backdropEl, {
      handleSelector: '.mob-call-handle',
    })

    this.#bindEvents()

    model.addEventListener('call:started',              e => this.#onCallStarted(e.detail))
    model.addEventListener('call:participants-changed',  e => this.#renderParticipants(e.detail.participants))
    model.addEventListener('call:ended',                () => this.#onCallEnded())
    model.addEventListener('call:sheet-requested',      () => this.#sc.show())
  }

  #onCallStarted({ channel, participants }) {
    this.#channelInfoEl.textContent = `#${channel?.name ?? ''}`
    this.#renderParticipants(participants)
    this.#startTimer()
    this.#barEl.classList.add('is-active')
    this.#sc.show()
    this.#muted = false; this.#cameraOn = false; this.#speakerOn = true
    this.#updateControlState()
  }

  #onCallEnded() {
    this.#sc.hide()
    this.#stopTimer()
    this.#barEl.classList.remove('is-active')
    this.#elapsed = 0
    this.#timerEl.textContent = '0:00'
    this.#barTimerEl.textContent = '0:00'
  }

  #renderParticipants(participants) {
    const count = participants.length
    this.#barTextEl.textContent = `${count} in call`
    this.#participantsEl.innerHTML = participants.map(p => `
      <div class="mob-call-tile${p.speaking ? ' speaking' : ''}${p.muted ? ' muted' : ''}">
        <div class="mob-call-tile-avatar" style="background:${escHtml(p.color)}">
          ${escHtml(p.initials)}
          <span class="mob-call-tile-mic">${p.muted ? 'X' : 'M'}</span>
        </div>
        <span class="mob-call-tile-name">${escHtml(p.name)}</span>
      </div>
    `).join('')
  }

  #startTimer() {
    this.#elapsed = 0
    this.#timerInterval = setInterval(() => {
      this.#elapsed++
      const m = Math.floor(this.#elapsed / 60)
      const s = String(this.#elapsed % 60).padStart(2, '0')
      const str = `${m}:${s}`
      this.#timerEl.textContent = str
      this.#barTimerEl.textContent = str
    }, 1000)
  }

  #stopTimer() {
    clearInterval(this.#timerInterval)
    this.#timerInterval = null
  }

  #updateControlState() {
    this.#muteBtn.classList.toggle('active', this.#muted)
    this.#muteBtn.querySelector('.mob-call-btn-icon').textContent = this.#muted ? 'X' : 'mic'
    this.#muteBtn.querySelector('.mob-call-btn-label').textContent = this.#muted ? 'Unmute' : 'Mute'
    this.#cameraBtn.classList.toggle('active', this.#cameraOn)
    this.#speakerBtn.classList.toggle('active', this.#speakerOn)
  }

  #bindEvents() {
    this.#callHeaderBtn.addEventListener('click', () => this.#model.startCall())

    this.#barEl.addEventListener('click', e => {
      if (e.target === this.#barLeaveBtn) return
      if (this.#model.callState === 'active') this.#sc.show()
    })

    this.#barLeaveBtn.addEventListener('click', e => {
      e.stopPropagation()
      this.#model.leaveCall()
    })

    this.#hangupBtn.addEventListener('click', () => this.#model.leaveCall())

    this.#muteBtn.addEventListener('click', () => {
      this.#muted = !this.#muted
      this.#model.toggleMute()
      this.#updateControlState()
    })

    this.#cameraBtn.addEventListener('click', () => {
      this.#cameraOn = !this.#cameraOn
      this.#updateControlState()
    })

    this.#speakerBtn.addEventListener('click', () => {
      this.#speakerOn = !this.#speakerOn
      this.#updateControlState()
    })

    document.getElementById('mob-nh-call-share').addEventListener('click', () => {
      const btn = document.getElementById('mob-nh-call-share')
      const icon = btn.querySelector('.mob-call-btn-icon')
      const label = btn.querySelector('.mob-call-btn-label')
      const sharing = btn.classList.toggle('active')
      icon.textContent  = sharing ? 'stop' : 'scr'
      label.textContent = sharing ? 'Stop' : 'Share'
    })
  }
}

// ============================================================================
// INCOMING CALL VIEW
// ============================================================================
class IncomingCallView {
  #model; #toastEl; #avatarEl; #nameEl; #subEl
  #acceptBtn; #declineBtn; #timeout = null

  constructor(model) {
    this.#model     = model
    this.#toastEl   = document.getElementById('mob-nh-call-toast')
    this.#avatarEl  = document.getElementById('mob-nh-call-toast-avatar')
    this.#nameEl    = document.getElementById('mob-nh-call-toast-name')
    this.#subEl     = document.getElementById('mob-nh-call-toast-sub')
    this.#acceptBtn  = document.getElementById('mob-nh-call-toast-accept')
    this.#declineBtn = document.getElementById('mob-nh-call-toast-decline')

    this.#acceptBtn.addEventListener('click', () => {
      this.#hide()
      this.#model.joinCall()
    })
    this.#declineBtn.addEventListener('click', () => this.#hide())

    model.addEventListener('call:incoming', e => this.#show(e.detail))
  }

  #show({ from, channel }) {
    this.#avatarEl.textContent    = from.initials
    this.#avatarEl.style.background = from.color
    this.#nameEl.textContent      = from.name
    this.#subEl.textContent       = `started a call in #${channel?.name ?? 'unknown'}`
    this.#toastEl.classList.add('is-visible')
    this.#timeout = setTimeout(() => this.#hide(), 8000)
  }

  #hide() {
    clearTimeout(this.#timeout)
    this.#toastEl.classList.remove('is-visible')
  }
}

// ============================================================================
// CONTEXT MENU CONTROLLER
// ============================================================================
class ContextMenuController {
  #model; #chat; #nav
  #menuEl; #backdropEl; #viewport
  #lpTimer = null; #lpPeekTimer = null
  #lpStartX = 0; #lpStartY = 0; #lpTarget = null; #lpFired = false
  #ctxTarget = null
  static #PEEK_MS = 300; static #FIRE_MS = 500; static #MOVE_PX = 8

  constructor(model, { chat, nav, viewport, menuEl, backdropEl }) {
    this.#model      = model; this.#chat = chat; this.#nav = nav
    this.#menuEl     = menuEl; this.#backdropEl = backdropEl; this.#viewport = viewport

    menuEl.addEventListener('click', e => {
      const btn = e.target.closest('[data-action]')
      if (!btn) return
      this.#handleAction(btn.dataset.action); this.#hide()
    })
    backdropEl.addEventListener('click',    () => this.#hide())
    backdropEl.addEventListener('touchend', e  => { e.preventDefault(); this.#hide() }, { passive: false })

    this.#bindPressTargets()
  }

  get isOpen()  { return this.#menuEl.classList.contains('is-open') }
  get lpFired() { return this.#lpFired }

  #bindPressTargets() {
    const zones = [
      { el: document.getElementById('mob-nh-sidebar-scroll'),
        pick: el => el.closest('.mob-ch-row') },
      { el: document.getElementById('mob-nh-panel-main'),
        pick: el => el.closest('.reaction-pill, .mob-composer') ? null : el.closest('.message') },
    ]

    for (const { el, pick } of zones) {
      el.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return
        const p = pick(e.target); if (!p) return
        this.#startLP(p, e.touches[0].clientX, e.touches[0].clientY)
      }, { passive: true })
      el.addEventListener('touchmove', e => {
        if (!this.#lpTimer) return
        if (this.#tooFar(e.touches[0].clientX, e.touches[0].clientY)) this.#cancel()
      }, { passive: true })
      el.addEventListener('touchend',    () => { if (!this.#lpFired) this.#cancel() }, { passive: true })
      el.addEventListener('touchcancel', () => this.#cancel(), { passive: true })
      el.addEventListener('mousedown', e => {
        if (e.button !== 0) return
        const p = pick(e.target); if (!p) return
        this.#startLP(p, e.clientX, e.clientY)
      })
      el.addEventListener('click', e => {
        if (!this.#lpFired) return
        e.preventDefault(); e.stopImmediatePropagation(); this.#lpFired = false
      }, true)
    }

    document.addEventListener('mousemove', e => {
      if (this.#lpTimer && this.#tooFar(e.clientX, e.clientY)) this.#cancel()
    })
    document.addEventListener('mouseup', () => { if (!this.#lpFired) this.#cancel() })
  }

  #startLP(el, x, y) {
    this.#lpStartX = x; this.#lpStartY = y; this.#lpTarget = el; this.#lpFired = false
    this.#lpPeekTimer = setTimeout(() => el.classList.add('mob-lp-peek'), ContextMenuController.#PEEK_MS)
    this.#lpTimer     = setTimeout(() => {
      el.classList.remove('mob-lp-peek')
      this.#fire(x, y)
    }, ContextMenuController.#FIRE_MS)
  }

  #cancel() {
    clearTimeout(this.#lpPeekTimer); clearTimeout(this.#lpTimer)
    this.#lpPeekTimer = null; this.#lpTimer = null
    this.#lpTarget?.classList.remove('mob-lp-peek'); this.#lpTarget = null
  }

  #tooFar(x, y) {
    return Math.abs(x - this.#lpStartX) > ContextMenuController.#MOVE_PX
        || Math.abs(y - this.#lpStartY) > ContextMenuController.#MOVE_PX
  }

  #buildItems(el) {
    const article = el.closest?.('.message')
    if (article) {
      const own = article.querySelector('.message-handle')?.textContent.trim() === 'You'
      return [
        { action:'reply-thread',  icon:'r',  label:'Reply in Thread' },
        { action:'reply-inline',  icon:'<',  label:'Reply' },
        '---',
        { action:'react-thumbs',  icon:'+1', label:'Thumbs Up' },
        { action:'react-heart',   icon:'<3', label:'Heart' },
        { action:'copy-text',     icon:'cp', label:'Copy Text' },
        ...(own ? ['---', { action:'delete-msg', icon:'X', label:'Delete Message', danger:true }] : []),
      ]
    }
    const row = el.closest?.('.mob-ch-row')
    if (row) {
      const section = row.dataset.section
      if (section === 'sessions') {
        const ses = this.#model.channels.sessions.find(s => s.id === row.dataset.id)
        const isOwner = ses?.owner === 'You'
        return [
          { action:'view-members', icon:'ppl', label:'View Members' },
          '---',
          ...(isOwner && ses?.status === 'active' ? [{ action:'end-session', icon:'X', label:'End Session', danger:false }] : []),
          { action:'leave-session', icon:'->', label:'Leave Session', danger:true },
        ]
      }
      if (section === 'dms') return []
      const ch = this.#model.channels[section]?.find(c => c.id === row.dataset.id)
      const isJoined = section === 'private' || ch?.joined
      return [
        { action:'mark-read', icon:'ok', label:'Mark as Read' },
        '---',
        ...(isJoined
          ? [{ action:'leave-channel', icon:'->', label:'Leave Channel', danger:true }]
          : [{ action:'join-channel', icon:'+', label:'Join Channel' }]),
        { action:'copy-name', icon:'cp', label:'Copy Name' },
      ]
    }
    return []
  }

  #fire(clientX, clientY) {
    this.#lpFired = true
    this.#ctxTarget = this.#lpTarget

    const items = this.#buildItems(this.#lpTarget)
    if (!items.length) return

    this.#menuEl.innerHTML = items.map(item =>
      item === '---'
        ? `<div class="mob-ctx-divider"></div>`
        : `<button class="mob-ctx-item${item.danger ? ' danger' : ''}" type="button" data-action="${item.action}">
             <span class="mob-ctx-icon">${item.icon ?? ''}</span>
             <span>${item.label}</span>
           </button>`
    ).join('')

    this.#menuEl.style.display = 'flex'
    const vp = this.#viewport.getBoundingClientRect()
    const mW = this.#menuEl.offsetWidth  || 192
    const mH = this.#menuEl.offsetHeight || 160
    let cx = clientX - vp.left + 6
    let cy = clientY - vp.top + 8
    cx = Math.max(8, Math.min(cx, vp.width  - mW - 8))
    cy = Math.max(8, Math.min(cy, vp.height - mH - 8))
    this.#menuEl.style.left = `${cx}px`
    this.#menuEl.style.top  = `${cy}px`
    this.#menuEl.classList.add('is-open')
    this.#backdropEl.style.display = 'block'
  }

  #hide() {
    this.#menuEl.classList.remove('is-open')
    this.#menuEl.style.display = 'none'
    this.#backdropEl.style.display = 'none'
    this.#lpFired = false
  }

  #toast(msg) {
    const el = document.getElementById('mob-nh-dbg-panel')
    const was = el.textContent
    el.textContent = msg
    setTimeout(() => { el.textContent = was }, 2000)
  }

  #handleAction(action) {
    const article = this.#ctxTarget?.closest?.('.message')
    switch (action) {
      case 'reply-thread': {
        const h = article?.querySelector('.message-handle')?.textContent.trim() ?? ''
        const t = article?.querySelector('.message-text p')?.textContent.trim() ?? ''
        const ch = this.#model.activeChannel
        if (ch) this.#model.openThread({ id:'ctx', rootMsg:t, replies:0, lastActivity:'now', author:h }, ch)
        break
      }
      case 'reply-inline': {
        if (article) {
          const h = article.querySelector('.message-handle')?.textContent.trim() ?? ''
          const t = article.querySelector('.message-text p')?.textContent.trim() ?? ''
          this.#model.setReplyingTo(h, t)
        }
        break
      }
      case 'react-thumbs': if (article) this.#chat.addReaction(article, '+1'); break
      case 'react-heart':  if (article) this.#chat.addReaction(article, '<3'); break
      case 'copy-text': {
        const t = article?.querySelector('.message-text p')?.textContent.trim() ?? ''
        this.#toast(`copied: "${t.slice(0,32)}${t.length>32?'...':''}"`)
        break
      }
      case 'delete-msg': article?.remove(); this.#toast('message deleted'); break
      case 'end-session': {
        const row = this.#ctxTarget?.closest?.('.mob-ch-row')
        if (row) this.#model.endSession(row.dataset.id)
        this.#toast('session ended'); break
      }
      case 'mark-read': this.#toast('marked as read'); break
      case 'view-members': this.#toast('members view (coming soon)'); break
      default: this.#toast(`ctx: ${action}`)
    }
  }
}

// ============================================================================
// BOTTOM NAV VIEW
// ============================================================================
class BottomNavView {
  #model; #nav; #el; #prefsSheet; #activitySheet; #searchView

  constructor(model, { nav, el, prefsSheet, activitySheet, searchView }) {
    this.#model         = model
    this.#nav           = nav
    this.#el            = el
    this.#prefsSheet    = prefsSheet
    this.#activitySheet = activitySheet
    this.#searchView    = searchView

    el.addEventListener('click', e => {
      const btn = e.target.closest('.mob-bottom-nav-item')
      if (!btn) return
      switch (btn.dataset.tab) {
        case 'channels': nav.goTo(0); break
        case 'search':   searchView.open(); break
        case 'activity': activitySheet.show(); break
        case 'you':      prefsSheet.show(); break
      }
    })

    model.addEventListener('panel:changed', () => this.render())
  }

  render() {
    const isChat = this.#nav.panel <= 1
    this.#el.querySelectorAll('.mob-bottom-nav-item').forEach(b =>
      b.classList.toggle('active', b.dataset.tab === 'channels' && isChat)
    )
    const hasUnread = this.#model.channels.dms.some(d => d.unread)
    const dot = document.getElementById('mob-nh-activity-dot')
    if (dot) dot.style.display = hasUnread ? '' : 'none'
  }
}

// ============================================================================
// SEARCH VIEW
// ============================================================================
class SearchView {
  #model; #nav
  #overlayEl; #inputEl; #bodyEl; #clearBtn
  #isOpen = false

  // Seed data for message results (channels + threads come from model)
  static #SEED_MSGS = [
    { text:'Good morning everyone! Ready for the standup?', author:'Alice', chName:'general',      chId:'pub1', section:'public',  time:'9:01 AM' },
    { text:'Migration PR is up: pr/mobile-schema-v2',       author:'Bob',   chName:'general',      chId:'pub1', section:'public',  time:'9:15 AM' },
    { text:'CI passed \u2705 \u2014 all 143 tests green.',           author:'Bob',   chName:'general',      chId:'pub1', section:'public',  time:'10:12 AM'},
    { text:'Blocker: need @Carol to approve the plan.',     author:'Bob',   chName:'engineering',  chId:'prv1', section:'private', time:'9:07 AM' },
    { text:'Left a few comments \u2014 mostly nits. LGTM \ud83d\udea2',   author:'Carol', chName:'engineering',  chId:'prv1', section:'private', time:'9:32 AM' },
    { text:'Feature priority for Q4 \u2014 starting the thread',author:'Alice', chName:'Q4 planning',  chId:'ses1', section:'sessions',time:'1h ago'  },
  ]

  static #RECENT = ['engineering', 'auth refactor', 'Q4 planning', 'Alice']

  constructor(model, nav) {
    this.#model     = model
    this.#nav       = nav
    this.#overlayEl = document.getElementById('mob-nh-search-overlay')
    this.#inputEl   = document.getElementById('mob-nh-search-input')
    this.#bodyEl    = document.getElementById('mob-nh-search-body')
    this.#clearBtn  = document.getElementById('mob-nh-search-clear')

    document.getElementById('mob-nh-search-cancel').addEventListener('click', () => this.close())
    this.#clearBtn.addEventListener('click', () => { this.#inputEl.value = ''; this.#onInput() })
    this.#inputEl.addEventListener('input', () => this.#onInput())
    this.#renderRecent()
  }

  get isOpen() { return this.#isOpen }

  open() {
    this.#overlayEl.classList.add('is-open')
    this.#isOpen = true
    this.#inputEl.value = ''
    this.#clearBtn.style.display = 'none'
    this.#renderRecent()
    this.#inputEl.focus()
  }

  close() {
    this.#overlayEl.classList.remove('is-open')
    this.#isOpen = false
    this.#inputEl.blur()
  }

  #onInput() {
    const q = this.#inputEl.value.trim()
    this.#clearBtn.style.display = q ? '' : 'none'
    q ? this.#renderResults(q) : this.#renderRecent()
  }

  #renderRecent() {
    const clockIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
    this.#bodyEl.innerHTML =
      `<div class="mob-search-section-title">Recent Searches</div>` +
      SearchView.#RECENT.map(r =>
        `<div class="mob-search-recent-item">${clockIcon}${escHtml(r)}</div>`
      ).join('')
  }

  #renderResults(q) {
    const lq = q.toLowerCase()
    const model = this.#model
    const html = []

    // -- Channels
    const allCh = [
      ...model.channels.public.map(c   => ({ ...c, section:'public',   icon:'#' })),
      ...model.channels.private.map(c  => ({ ...c, section:'private',  icon:'\ud83d\udd12' })),
      ...model.channels.sessions.map(c => ({ ...c, section:'sessions', icon:'\ud83d\udccb' })),
    ]
    const chHits = allCh.filter(c => c.name.toLowerCase().includes(lq))
    if (chHits.length) {
      html.push(`<div class="mob-search-section-title">Channels</div>`)
      chHits.slice(0, 4).forEach(c => {
        const sub = c.section === 'public' ? 'Public channel' : c.section === 'private' ? 'Private channel' : 'Session'
        html.push(`<div class="mob-search-result" data-type="channel" data-id="${c.id}" data-section="${c.section}">
          <div class="mob-search-result-icon">${c.icon}</div>
          <div class="mob-search-result-body">
            <div class="mob-search-result-title">${escHtml(c.icon + ' ' + c.name)}</div>
            <div class="mob-search-result-sub">${escHtml(sub)}</div>
          </div>
        </div>`)
      })
    }

    // -- Threads
    const allThreads = []
    for (const [chId, threads] of Object.entries(model.threads)) {
      const ch = allCh.find(c => c.id === chId)
      if (ch) threads.forEach(t => allThreads.push({ ...t, ch }))
    }
    const thrHits = allThreads.filter(t =>
      t.rootMsg.toLowerCase().includes(lq) || t.author.toLowerCase().includes(lq)
    )
    if (thrHits.length) {
      html.push(`<div class="mob-search-section-title">Threads</div>`)
      thrHits.slice(0, 4).forEach(t => {
        const color = senderColor(t.author); const init = senderInitials(t.author)
        html.push(`<div class="mob-search-result" data-type="thread" data-thread-id="${t.id}" data-ch-id="${t.ch.id}" data-section="${t.ch.section}">
          <div class="mob-search-result-avatar" style="background:${color}">${escHtml(init)}</div>
          <div class="mob-search-result-body">
            <div class="mob-search-result-title">${escHtml(t.rootMsg)}</div>
            <div class="mob-search-result-sub">#${escHtml(t.ch.name)} \u00b7 ${t.replies} replies \u00b7 ${escHtml(t.lastActivity)} ago</div>
          </div>
        </div>`)
      })
    }

    // -- Messages
    const msgHits = SearchView.#SEED_MSGS.filter(m =>
      m.text.toLowerCase().includes(lq) ||
      m.author.toLowerCase().includes(lq) ||
      m.chName.toLowerCase().includes(lq)
    )
    if (msgHits.length) {
      html.push(`<div class="mob-search-section-title">Messages</div>`)
      msgHits.slice(0, 4).forEach(m => {
        const color = senderColor(m.author); const init = senderInitials(m.author)
        html.push(`<div class="mob-search-result" data-type="message" data-ch-id="${m.chId}" data-section="${m.section}">
          <div class="mob-search-result-avatar" style="background:${color}">${escHtml(init)}</div>
          <div class="mob-search-result-body">
            <div class="mob-search-result-title">${escHtml(m.text)}</div>
            <div class="mob-search-result-sub">${escHtml(m.author)} \u00b7 #${escHtml(m.chName)} \u00b7 ${escHtml(m.time)}</div>
          </div>
        </div>`)
      })
    }

    this.#bodyEl.innerHTML = html.length
      ? html.join('')
      : `<div class="mob-search-empty">No results for "<strong>${escHtml(q)}</strong>"</div>`

    // Bind taps
    this.#bodyEl.querySelectorAll('.mob-search-result').forEach(el => {
      el.addEventListener('click', () => {
        const type = el.dataset.type
        if (type === 'channel') {
          model.selectChannel(el.dataset.id, el.dataset.section)
          this.close(); this.#nav.goTo(1)
        } else if (type === 'thread') {
          const ch = allCh.find(c => c.id === el.dataset.chId)
          const thr = allThreads.find(t => t.id === el.dataset.threadId)
          if (ch && thr) {
            model.selectChannel(ch.id, ch.section)
            model.openThread(thr, ch)
            this.close()
          }
        } else if (type === 'message') {
          model.selectChannel(el.dataset.chId, el.dataset.section)
          this.close(); this.#nav.goTo(1)
        }
      })
    })
  }
}

