new IncomingCallView(model)

// Wire add buttons (after sidebar renders)
model.selectChannel('pub1', 'public')
sidebar.render()
bottomNav.render()

// Bind section add buttons using event delegation on scroll
document.getElementById('mob-nh-sidebar-scroll').addEventListener('click', e => {
  const addBtn = e.target.closest('.mob-section-add')
  if (!addBtn) return
  const id = addBtn.id
  if (id === 'mob-nh-add-public' || id === 'mob-nh-add-private') channelCreateSheet.show()
  else if (id === 'mob-nh-add-session') sessionCreateSheet.show()
  else if (id === 'mob-nh-add-dm') newDMSheet.show()
})

// Simulate incoming call after 3s
setTimeout(() => model.simulateIncomingCall(), 3000)

// Keyboard avoidance for sheets
document.querySelectorAll('#mob-nh-frame .mob-edit-body').forEach(body => {
  body.addEventListener('focusin', e => {
    const input = e.target.closest('input, textarea, select'); if (!input) return
    setTimeout(() => input.scrollIntoView({ behavior:'smooth', block:'nearest' }), 120)
  })
})
