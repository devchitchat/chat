  track:         document.getElementById('mob-track'),
  backBtn:       document.getElementById('mob-back-btn'),
  threadBackBtn: document.getElementById('mob-thread-back-btn'),
  config,
  dbg: {
    panel: document.getElementById('dbg-panel'),
    dir:   document.getElementById('dbg-dir'),
    dx:    document.getElementById('dbg-dx'),
    vel:   document.getElementById('dbg-vel'),
  },
})

const overflowSheet = new OverflowSheet(model, {
  sheetEl:    document.getElementById('mob-overflow-sheet'),
  backdropEl: document.getElementById('mob-overflow-backdrop'),
  listEl:     document.getElementById('mob-overflow-list'),
})

const hubEditSheet = new HubEditSheet(model, {
  sheetEl:    document.getElementById('mob-edit-sheet'),
  backdropEl: document.getElementById('mob-edit-backdrop'),
})

const hubCreateSheet = new HubCreateSheet(model, {
  sheetEl:    document.getElementById('mob-hub-create-sheet'),
  backdropEl: document.getElementById('mob-hub-create-backdrop'),
})

const channelCreateSheet = new ChannelCreateSheet(model, {
  sheetEl:    document.getElementById('mob-ch-sheet'),
  backdropEl: document.getElementById('mob-ch-backdrop'),
})

new UserPrefsSheet({
  sheetEl:    document.getElementById('mob-prefs-sheet'),
  backdropEl: document.getElementById('mob-prefs-backdrop'),
  avatarBtn:  document.querySelector('.mob-avatar'),
})

const chat   = new ChatView(model)
const thread = new ThreadView(model)

const ctx = new ContextMenuController(model, {
  chat, nav,
  viewport:   document.getElementById('mob-viewport'),
  menuEl:     document.getElementById('mob-ctx-menu'),
  backdropEl: document.getElementById('mob-ctx-backdrop'),
})

nav.setCtx(ctx)

const tabBar = new TabBarView(model, document.getElementById('mob-tab-bar'), {
  nav, overflow: overflowSheet, hubCreateSheet, ctx,
})

new SidebarView(model, { nav, channelCreateSheet, hubEditSheet, ctx })

const callView = new CallView(model)
new IncomingCallView(model)

// Demo: simulate an incoming call after 2 s (remove in real app)
setTimeout(() => model.simulateIncomingCall(), 2000)

// ── Keyboard avoidance for all sheets ────────────────────────────────────────
document.querySelectorAll('.mob-edit-body').forEach(body => {
  body.addEventListener('focusin', e => {
    const input = e.target.closest('input, textarea, select'); if (!input) return
    setTimeout(() => input.scrollIntoView({ behavior:'smooth', block:'nearest' }), 120)
  })
})
if (window.visualViewport) {
  window.visualViewport.addEventListener('resize', () => {
    const kbH = Math.max(0, window.innerHeight - window.visualViewport.height)
    document.querySelectorAll('.mob-edit-body').forEach(b => {
      b.style.paddingBottom = kbH > 50 ? `${kbH + 16}px` : ''
    })
    if (kbH > 50 && document.activeElement?.matches('input, textarea, select'))
      setTimeout(() => document.activeElement.scrollIntoView({ behavior:'smooth', block:'nearest' }), 60)
  })
}

// ── Initial render ────────────────────────────────────────────────────────────
tabBar.render()
</script>
