      <!-- ── Tab bar — persistent hub switcher ─────────────────────────────────
           HIG: bottom tab bar on iPhone. Shows up to MAX_TABS hubs directly;
           extra hubs go behind a "More" tab that slides up an overflow sheet.
           Algorithm: if hubs.length > MAX_TABS → show first (MAX_TABS-1) tabs + ••• -->
      <div class="mob-tab-bar" id="mob-tab-bar">
        <!-- Populated by JS renderTabBar() -->
      </div>

      <!-- Overflow sheet — slides up when "More" tab is tapped -->
      <div class="mob-overflow-backdrop" id="mob-overflow-backdrop"></div>
      <div class="mob-overflow-sheet" id="mob-overflow-sheet" role="dialog" aria-label="More workspaces">
        <div class="mob-overflow-handle"></div>
        <p class="mob-overflow-title">More Workspaces</p>
        <ul class="mob-overflow-list" id="mob-overflow-list"></ul>
      </div>

      <!-- Hub edit sheet — full-height card, slides up over everything including tab bar -->
      <div class="mob-edit-backdrop" id="mob-edit-backdrop"></div>
      <div class="mob-edit-sheet" id="mob-edit-sheet" role="dialog" aria-label="Edit hub">
        <div class="mob-edit-handle" id="mob-edit-handle"></div>
        <div class="mob-edit-toolbar">
          <button class="mob-edit-btn-cancel" id="mob-edit-cancel" type="button">Cancel</button>
          <span class="mob-edit-title" id="mob-edit-sheet-title">Hub Settings</span>
          <button class="mob-edit-btn-done" id="mob-edit-done" type="button">Done</button>
        </div>
        <div class="mob-edit-body">
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-edit-hub-name">Name</label>
            <input class="mob-edit-input" id="mob-edit-hub-name" type="text" placeholder="Hub name" autocomplete="off">
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-edit-hub-visibility">Visibility</label>
            <select class="mob-edit-input" id="mob-edit-hub-visibility">
              <option value="public">Public — anyone can join</option>
              <option value="private">Private — invite only</option>
            </select>
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-edit-hub-desc">Description</label>
            <textarea class="mob-edit-input" id="mob-edit-hub-desc" rows="3" placeholder="What's this hub for?"></textarea>
          </div>
        </div>
      </div>

