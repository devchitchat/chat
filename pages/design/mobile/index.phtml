          <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 2C5.2 2 2.7 3.1 0.9 4.9L2.3 6.3C3.7 4.9 5.7 4 8 4s4.3.9 5.7 2.3l1.4-1.4C13.3 3.1 10.8 2 8 2z"/><path d="M8 6c-1.7 0-3.2.7-4.3 1.8L5.1 9.2C5.9 8.4 6.9 8 8 8s2.1.4 2.9 1.2l1.4-1.4C11.2 6.7 9.7 6 8 6z"/><circle cx="8" cy="11" r="1.5"/></svg>
          <svg width="25" height="12" viewBox="0 0 25 12" fill="none"><rect x="0.5" y="0.5" width="21" height="11" rx="3.5" stroke="currentColor" opacity=".35"/><rect x="1.5" y="1.5" width="16" height="9" rx="2.5" fill="currentColor"/><path d="M23 4v4a2 2 0 0 0 0-4z" fill="currentColor" opacity=".4"/></svg>
        </span>
      </div>

      <div class="mob-viewport" id="mob-viewport">
        <div class="mob-track" id="mob-track">

          <!-- Panel 0: Sidebar / channel list -->
          <div class="mob-panel" id="mob-panel-sidebar" data-panel="0">
