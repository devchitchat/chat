            <label class="mob-edit-label">Settings</label>
            <div class="mob-prefs-links">
              <button class="mob-prefs-link" type="button">Notifications</button>
              <button class="mob-prefs-link" type="button">Appearance</button>
              <button class="mob-prefs-link" type="button">Privacy</button>
            </div>
          </div>

          <button class="mob-prefs-signout" type="button">Sign Out</button>
        </div>
      </div>

      <!-- Hub create sheet -->
      <div class="mob-edit-backdrop" id="mob-hub-create-backdrop"></div>
      <div class="mob-edit-sheet" id="mob-hub-create-sheet" role="dialog" aria-label="New workspace">
        <div class="mob-edit-handle" id="mob-hub-create-handle"></div>
        <div class="mob-edit-toolbar">
          <button class="mob-edit-btn-cancel" id="mob-hub-create-cancel" type="button">Cancel</button>
          <span class="mob-edit-title">New Workspace</span>
          <button class="mob-edit-btn-done" id="mob-hub-create-done" type="button">Create</button>
        </div>
        <div class="mob-edit-body">
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-hub-create-name">Name</label>
            <input class="mob-edit-input" id="mob-hub-create-name" type="text"
                   placeholder="e.g. Engineering" autocomplete="off" autocapitalize="words">
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-hub-create-vis">Visibility</label>
            <select class="mob-edit-input" id="mob-hub-create-vis">
              <option value="public">Public — anyone can join</option>
              <option value="private">Private — invite only</option>
            </select>
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label">Color</label>
            <div class="mob-hub-color-row" id="mob-hub-color-row"></div>
          </div>
        </div>
      </div>

      <!-- Channel create sheet -->
      <div class="mob-edit-backdrop" id="mob-ch-backdrop"></div>
      <div class="mob-edit-sheet" id="mob-ch-sheet" role="dialog" aria-label="New channel">
        <div class="mob-edit-handle" id="mob-ch-handle"></div>
        <div class="mob-edit-toolbar">
          <button class="mob-edit-btn-cancel" id="mob-ch-cancel" type="button">Cancel</button>
          <span class="mob-edit-title">New Channel</span>
          <button class="mob-edit-btn-done" id="mob-ch-create" type="button">Create</button>
        </div>
        <div class="mob-edit-body">
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-ch-name">Name</label>
            <div class="mob-ch-name-wrap">
              <span class="mob-ch-prefix">#</span>
              <input class="mob-edit-input mob-ch-name-input" id="mob-ch-name" type="text"
                     placeholder="channel-name" autocomplete="off"
                     autocapitalize="none" spellcheck="false">
            </div>
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-ch-visibility">Visibility</label>
            <select class="mob-edit-input" id="mob-ch-visibility">
              <option value="public">Public — visible to everyone in this hub</option>
              <option value="private">Private — invite only</option>
            </select>
          </div>
          <div class="mob-edit-group">
            <label class="mob-edit-label" for="mob-ch-desc">Description <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-muted);font-size:11px">(optional)</span></label>
            <textarea class="mob-edit-input" id="mob-ch-desc" rows="3" placeholder="What's this channel for?"></textarea>
          </div>
        </div>
      </div>

      <!-- Incoming call toast -->
      <div class="mob-call-toast" id="mob-call-toast" role="alert">
        <div class="mob-call-toast-avatar" id="mob-call-toast-avatar" style="background:#5865f2">AL</div>
        <div class="mob-call-toast-body">
          <div class="mob-call-toast-name" id="mob-call-toast-name">Alice</div>
          <div class="mob-call-toast-sub" id="mob-call-toast-sub">started a call in #general</div>
        </div>
        <div class="mob-call-toast-btns">
          <button class="mob-call-toast-btn decline" id="mob-call-toast-decline" type="button">Decline</button>
          <button class="mob-call-toast-btn accept" id="mob-call-toast-accept" type="button">Join</button>
        </div>
      </div>

      <!-- Call sheet backdrop + sheet -->
      <div class="mob-call-backdrop" id="mob-call-backdrop"></div>
      <div class="mob-call-sheet" id="mob-call-sheet" role="dialog" aria-label="Voice call">
        <div class="mob-call-handle" id="mob-call-handle"></div>
        <div class="mob-call-header">
          <div class="mob-call-channel" id="mob-call-channel-info">Engineering › #general</div>
          <div class="mob-call-timer" id="mob-call-timer">0:00</div>
        </div>
        <div class="mob-call-participants" id="mob-call-participants"></div>
        <div class="mob-call-controls">
          <div class="mob-call-controls-row">
            <button class="mob-call-btn" id="mob-call-mute" type="button">
              <div class="mob-call-btn-icon">🎤</div>
              <span class="mob-call-btn-label">Mute</span>
            </button>
            <button class="mob-call-btn" id="mob-call-camera" type="button">
              <div class="mob-call-btn-icon">📷</div>
              <span class="mob-call-btn-label">Camera</span>
            </button>
            <button class="mob-call-btn" id="mob-call-speaker" type="button">
              <div class="mob-call-btn-icon">🔊</div>
              <span class="mob-call-btn-label">Speaker</span>
            </button>
            <button class="mob-call-btn" id="mob-call-share" type="button">
              <div class="mob-call-btn-icon">🖥</div>
              <span class="mob-call-btn-label">Share</span>
            </button>
          </div>
          <div class="mob-call-controls-row" style="justify-content:center">
            <button class="mob-call-hangup" id="mob-call-hangup" type="button" aria-label="End call">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Debug bar -->
      <div class="mob-debug" id="mob-debug">
        <span id="dbg-panel">panel: sidebar</span>
        <span id="dbg-dir">dir: –</span>
        <span id="dbg-dx">dx: 0</span>
        <span id="dbg-vel">vel: –</span>
      </div>
    </div><!-- /mob-frame -->

    <!-- Annotations column -->
    <div style="flex:1;min-width:260px;max-width:420px;display:flex;flex-direction:column;gap:16px">
      <div class="ds-annotation" style="margin:0">
        <strong>Tab bar algorithm:</strong> <code>MAX_TABS = 4</code>. With ≤ 4 hubs all fit directly.
        With 5+ hubs the first <code>MAX_TABS − 1</code> are shown as direct tabs; the rest go behind
        a <strong>•••</strong> tab that slides up an overflow sheet. This prototype has 5 hubs so
        you can see the overflow in action.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Tab tap behaviour (HIG):</strong> Tapping a tab always navigates to that workspace's
        channel list (sidebar panel). Re-tapping the active tab while already on the sidebar scrolls
        the list to top — standard iOS convention.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>44 pt tap targets:</strong> HIG minimum for interactive elements. Channel rows are
        now <code>min-height: 44px</code>. Tab items are <code>min-height: 50px</code> (iOS tab bar height).
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Long-press peek:</strong> At 300 ms a scale-down + background flash hints that a
        context menu is coming. At 500 ms the menu fires. This signals affordance without cluttering
        the UI with permanent controls.
      </div>
      <div class="ds-annotation" style="margin:0">
        <strong>Scroll isolation:</strong> Each panel uses <code>overscroll-behavior-y: contain</code>.
        Direction locks at the knob threshold — once classified as vertical, native scroll takes over
        with no horizontal interference.
      </div>
      <div style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-lg);padding:16px;font-size:13px;color:var(--text-secondary);line-height:1.6">
        <strong style="color:var(--text-primary);display:block;margin-bottom:8px">Still to resolve</strong>
        <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px">
          <li>Active tab when selected hub is in overflow — <strong>•••</strong> tab should highlight.</li>
          <li>Composer focus (keyboard open) changes <code>100dvh</code> — track should resize cleanly.</li>
          <li>iOS overscroll bounce shouldn't trigger a panel switch — rubber band knob = 0 helps.</li>
          <li>Re-tap active tab → scroll channel list to top.</li>
        </ul>
      </div>
    </div>

  </div><!-- /flex row -->
</div>

<style>
/* ── Phone frame ────────────────────────────────────────────────────────────── */
.mob-frame {
  width: 390px;
  flex-shrink: 0;
  border-radius: 44px;
  overflow: hidden;
  border: 8px solid color-mix(in srgb, var(--text-primary) 20%, transparent);
  box-shadow: 0 0 0 1px var(--border), 0 24px 64px rgba(0,0,0,.4);
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
  user-select: none;
  -webkit-user-select: none;
  position: relative; /* overflow sheet anchors here */
}

.mob-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
  background: var(--bg-sidebar);
  flex-shrink: 0;
}

/* ── Viewport + track ───────────────────────────────────────────────────────── */
.mob-viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  position: relative;
  height: 600px; /* fixed so frame doesn't grow with page */
}

.mob-track {
  display: flex;
  width: 300%; /* 3 panels: sidebar / main / thread */
  height: 100%;
  will-change: transform;
  transform: translateX(0);
}

/* ── Panels ─────────────────────────────────────────────────────────────────── */
.mob-panel {
  width: 33.333%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Sidebar panel */
.mob-sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px 8px 16px;
  background: color-mix(in srgb, var(--bg-sidebar) 80%, transparent);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
  border-bottom: 1px solid transparent; /* becomes visible on scroll via JS class */
  transition: border-color 160ms;
}
.mob-sidebar-header.scrolled { border-bottom-color: var(--border); }

/* Compact title — starts invisible, crossfades in as large title scrolls away */
.mob-compact-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  opacity: 0;
  transition: opacity 80ms linear;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8px;
}

/* Avatar button — user profile, top right */
.mob-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.03em;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  -webkit-tap-highlight-color: transparent;
}
.mob-avatar:active { opacity: 0.7; }

/* Large title — first element inside the scroll area */
.mob-large-title-area {
  padding: 16px 16px 4px;
}

.mob-large-title {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin: 0;
  line-height: 1.15;
  transition: opacity 80ms linear;
  flex: 1;
  min-width: 0;
}

/* Gear sits at the bottom of the large title's cap height */
.mob-hub-gear {
  align-self: flex-end;
  color: var(--text-muted);
  padding-bottom: 3px;
  flex-shrink: 0;
}
.mob-hub-gear:hover { color: var(--text-secondary); }

.mob-sidebar-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  background: var(--bg-sidebar);
  touch-action: pan-y;
}

/* Section labels inside sidebar (replaces hub <details> headers) */
.mob-section-label {
  padding: 14px 10px 4px 16px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  display: flex;
  align-items: center;
}

.mob-section-add {
  margin-left: auto;
  color: var(--text-muted);
  opacity: 0.7;
  padding: 4px;
}
.mob-section-add:hover { opacity: 1; color: var(--accent); }

/* Channel rows — HIG minimum 44 pt tap target */
.mob-sidebar-scroll .channel-item {
  min-height: 44px;
}

.mob-sidebar-scroll .channel-item a {
  min-height: 44px;
  height: auto;
  line-height: 44px;
}

/* # prefix on channels (not DMs) */
#mob-channel-list .channel-link::before {
  content: '#';
  opacity: 0.3;
  font-size: 14px;
  font-weight: 500;
  margin-right: 4px;
}

/* Unread dot — the global rule uses margin-left:auto which only works in flex.
   The channel link is display:block, so position the dot absolutely instead. */
.mob-sidebar-scroll .channel-item a {
  position: relative;
  padding-right: 24px; /* reserve room so text doesn't run into the dot */
}
.mob-sidebar-scroll .channel-item[data-mention] .channel-link::after,
.mob-sidebar-scroll .channel-item[data-urgent]  .channel-link::after {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 0;
}

.mob-sidebar-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  background: var(--bg-sidebar);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}

/* Main chat panel */
.mob-chat-header {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 12px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.mob-messages {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  touch-action: pan-y;
  padding: 8px 0 4px;
}

.mob-composer {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-top: 1px solid var(--border);
  background: var(--bg-elevated);
  flex-shrink: 0;
}

.mob-composer-input {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 8px 14px;
  font-size: 15px;
  background: var(--fill-secondary);
  color: var(--text-primary);
  outline: none;
  min-width: 0;
}
.mob-composer-input:focus { border-color: var(--accent); }
.mob-composer-send { color: var(--accent); flex-shrink: 0; }

/* ── Tab bar ────────────────────────────────────────────────────────────────── */
.mob-tab-bar {
  display: flex;
  border-top: 1px solid var(--border);
  background: color-mix(in srgb, var(--bg-sidebar) 96%, transparent);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

.mob-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 8px 4px 6px;
  min-height: 50px; /* iOS tab bar height */
  border: none;
  background: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1),
              opacity 200ms;
}

.mob-tab-icon {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: white;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  transition: box-shadow 200ms;
  position: relative; /* badge anchor */
}

/* Unread badge on hub tab icon */
.mob-tab-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  background: #ef4444;
  color: white;
  font-size: 9px;
  font-weight: 700;
  min-width: 15px;
  height: 15px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 3px;
  line-height: 1;
  border: 1.5px solid var(--bg-sidebar);
  pointer-events: none;
}

.mob-tab-item.active .mob-tab-icon {
  box-shadow: 0 0 0 2.5px var(--bg-sidebar), 0 0 0 4px currentColor;
}

.mob-tab-label {
  font-size: 10px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 56px;
  transition: color 160ms;
}

.mob-tab-item.active .mob-tab-label { color: var(--accent); }

/* "More" (overflow) tab icon */
.mob-tab-more {
  background: var(--bg-hover) !important;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
}

/* Active ring colour on the more icon inherits the active hub colour set via JS */
.mob-tab-item.active .mob-tab-more {
  box-shadow: 0 0 0 2.5px var(--bg-sidebar), 0 0 0 4px var(--accent);
}

/* "New hub" (+) tab */
.mob-tab-plus {
  background: var(--bg-hover) !important;
  color: var(--text-secondary);
  font-size: 18px;
  font-weight: 300;
  border: 1.5px dashed color-mix(in srgb, var(--border) 80%, transparent);
}
.mob-tab-new-hub:active .mob-tab-plus {
  background: var(--bg-active) !important;
  color: var(--text-primary);
}

/* Hub color picker */
.mob-hub-color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.mob-hub-color-swatch {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: transform 120ms, box-shadow 120ms;
  flex-shrink: 0;
}
.mob-hub-color-swatch.selected {
  box-shadow: 0 0 0 2.5px var(--bg-elevated), 0 0 0 4.5px var(--text-primary);
  transform: scale(1.12);
}
.mob-hub-color-swatch:active { transform: scale(0.92); }

/* ── Overflow sheet ─────────────────────────────────────────────────────────── */
.mob-overflow-backdrop {
  position: absolute;
  inset: 0;
  z-index: 60;
  background: rgba(0,0,0,.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 280ms;
}
.mob-overflow-backdrop.is-open { opacity: 1; pointer-events: auto; }

.mob-overflow-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 61;
  background: var(--bg-elevated);
  border-radius: 20px 20px 0 0;
  padding-bottom: env(safe-area-inset-bottom, 8px);
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.mob-overflow-sheet.is-open { transform: translateY(0); pointer-events: auto; }

.mob-overflow-handle {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--border);
  margin: 10px auto 0;
  cursor: grab;
}
.mob-overflow-handle:active { cursor: grabbing; }

.mob-overflow-title {
  padding: 12px 20px 8px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin: 0;
}

.mob-overflow-list {
  list-style: none;
  padding: 0;
  margin: 0;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  max-height: 340px; /* leaves room for the handle + title within the frame */
}

.mob-overflow-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 20px;
  min-height: 56px;
  cursor: pointer;
}
.mob-overflow-item:hover { background: var(--bg-hover); }
.mob-overflow-item:active { background: var(--bg-active); }
.mob-overflow-item.active { background: color-mix(in srgb, var(--accent) 8%, transparent); }

.mob-overflow-item-name {
  font-size: 16px;
  flex: 1;
  color: var(--text-primary);
}
.mob-overflow-item.active .mob-overflow-item-name { font-weight: 600; }

.mob-overflow-checkmark {
  font-size: 16px;
  color: var(--accent);
  width: 20px;
  text-align: center;
}

/* ── Context menu ─────────────────────────────────────────────────────────── */
.mob-ctx-backdrop {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: none;
}

@keyframes mob-ctx-in {
  from { opacity: 0; transform: scale(0.92) translateY(-4px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

.mob-ctx-menu {
  position: absolute;
  z-index: 51;
  min-width: 192px;
  background: color-mix(in srgb, var(--bg-elevated) 95%, transparent);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 32px rgba(0,0,0,.35), 0 2px 8px rgba(0,0,0,.2);
  overflow: hidden;
  display: none;
  flex-direction: column;
  transform-origin: top left;
  animation: mob-ctx-in 160ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
