const HUB_COLORS = ['#5865f2','#22c55e','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316','#64748b','#84cc16','#06b6d4','#a855f7']

// ══════════════════════════════════════════════════════════════════════════════
// KNOB CONFIG  (gesture tuning sliders)
// ══════════════════════════════════════════════════════════════════════════════
const knobDefs = [
  { key:'lockPx',     elId:'knob-lock',   valId:'knob-lock-val',   fn: v => +v,       fmt: v => `${v}`      },
  { key:'commitPct',  elId:'knob-commit', valId:'knob-commit-val', fn: v => +v,       fmt: v => `${v}%`     },
  { key:'velocityPx', elId:'knob-vel',    valId:'knob-vel-val',    fn: v => v / 100,  fmt: v => v.toFixed(2)},
  { key:'rubberBand', elId:'knob-rubber', valId:'knob-rubber-val', fn: v => v / 100,  fmt: v => v.toFixed(2)},
]
const config = {}
for (const d of knobDefs) {
  const el = document.getElementById(d.elId)
  const vl = document.getElementById(d.valId)
  Object.defineProperty(config, d.key, { get: () => d.fn(+el.value) })
  const upd = () => { vl.textContent = d.fmt(d.fn(+el.value)) }
  el.addEventListener('input', upd); upd()
}

// ══════════════════════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════════════════════
const escHtml = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
const timeStr = () => new Date().toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit' })

// ── Sender avatar helpers ──────────────────────────────────────────────────
const AVATAR_PALETTE = ['#5865f2','#22c55e','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316']
const SENDER_COLORS  = { You:'#6366f1', System:'#64748b', Alice:'#5865f2', Bob:'#22c55e', Carol:'#f59e0b' }
const senderColor    = name => SENDER_COLORS[name] ?? AVATAR_PALETTE[Math.abs([...name].reduce((h,c) => (h*31+c.charCodeAt(0))|0, 0)) % AVATAR_PALETTE.length]
const senderInitials = name => { const p=name.trim().split(/\s+/); return (p.length>1 ? p[0][0]+p[p.length-1][0] : name.slice(0,2)).toUpperCase() }

// Build the inner HTML for a message article.
// timeHtml is omitted for thread root messages where time isn't shown.
const msgInnerHtml = (handle, time, bodyHtml, extraHtml = '') => {
  const color = senderColor(handle); const init = senderInitials(handle)
  const timeEl = time ? `<time class="message-time">${escHtml(time)}</time>` : ''
  return `<div class="mob-msg-avatar"><div class="mob-msg-avatar-circle" style="background:${color}">${escHtml(init)}</div></div>` +
    `<div class="mob-msg-header"><span class="message-handle" style="color:${color}">${escHtml(handle)}</span>${timeEl}</div>` +
    `<div class="message-text">${bodyHtml}</div>${extraHtml}`
}

// ══════════════════════════════════════════════════════════════════════════════
// APP MODEL
// The hub. All state lives here. Views never share mutable state directly —
// they read via getters and mutate via methods.
// ══════════════════════════════════════════════════════════════════════════════
class AppModel extends EventTarget {
  #hubs; #activeHubId; #activeChannelId; #replyingTo = null; #maxTabs
  #callState = 'idle'  // 'idle' | 'active'
  #callParticipants = []
  #callChannelId = null
  #callHubId = null

  constructor(hubs, activeHubId, activeChannelId, maxTabs = 4) {
    super()
    // Deep-copy so HUBS_DATA stays clean if model is ever re-instantiated
    this.#hubs            = hubs.map(h => ({ ...h, channels: h.channels.map(c => ({ ...c })) }))
    this.#activeHubId     = activeHubId
    this.#activeChannelId = activeChannelId
    this.#maxTabs         = maxTabs
  }

  // ── Accessors ──────────────────────────────────────────────────────────────
  get hubs()            { return this.#hubs }
  get maxTabs()         { return this.#maxTabs }
  get activeHubId()     { return this.#activeHubId }
  get activeChannelId() { return this.#activeChannelId }
  get replyingTo()      { return this.#replyingTo }
  get activeHub()       { return this.#hubs.find(h => h.id === this.#activeHubId) ?? null }
  get activeChannel()   { return this.activeHub?.channels.find(c => c.id === this.#activeChannelId) ?? null }
  get callState()        { return this.#callState }
  get callParticipants() { return this.#callParticipants }
  get callChannelId()    { return this.#callChannelId }

  // ── Private ────────────────────────────────────────────────────────────────
  #emit(type, detail = {}) { this.dispatchEvent(new CustomEvent(type, { detail })) }

  // ── Hub mutations ──────────────────────────────────────────────────────────
  selectHub(hubId) {
    const hub = this.#hubs.find(h => h.id === hubId)
    if (!hub) return
    this.#activeHubId     = hubId
    this.#activeChannelId = hub.channels[0]?.id ?? null
    this.#emit('hub:changed', { hub })
  }

  createHub({ name, visibility, color }) {
    const initials = name.split(/\s+/).map(w => w[0]).join('').toUpperCase().slice(0, 2)
                     || name.slice(0, 2).toUpperCase()
    const short = name.length > 6 ? name.slice(0, 4) + '…' : name
    const hub = { id:`h${Date.now()}`, name, short, initials, color, visibility,
                  channels: [{ id:`c${Date.now()}`, name:'general' }] }
    this.#hubs.push(hub)
    this.#emit('hub:created', { hub })
    this.selectHub(hub.id)
  }

  updateHub(hubId, { name, visibility, description }) {
    const hub = this.#hubs.find(h => h.id === hubId)
    if (!hub) return
    if (name) { hub.name = name; hub.short = name.length > 6 ? name.slice(0,4)+'…' : name }
    if (visibility  !== undefined) hub.visibility  = visibility
    if (description !== undefined) hub.description = description
    this.#emit('hub:updated', { hub })
  }

  // ── Channel mutations ──────────────────────────────────────────────────────
  selectChannel(channelId) {
    this.#activeChannelId = channelId
    const ch = this.activeHub?.channels.find(c => c.id === channelId)
    this.#emit('channel:selected', { channel: ch, hub: this.activeHub })
  }

  createChannel(hubId, { name, visibility, description }) {
    const hub = this.#hubs.find(h => h.id === hubId)
    if (!hub) return null
    const ch = { id:`c${Date.now()}`, name, visibility, description }
    hub.channels.push(ch)
    this.#emit('channel:created', { hub, channel: ch })
    this.selectChannel(ch.id)
    return ch
  }

  markChannelRead(channelId) {
    for (const hub of this.#hubs) {
      const ch = hub.channels.find(c => c.id === channelId)
      if (ch) { delete ch.mention; delete ch.urgent; this.#emit('channel:read', { hub, channel: ch }); return }
    }
  }

  // ── Message / reply mutations ──────────────────────────────────────────────
  setReplyingTo(handle, text) {
    this.#replyingTo = { handle, text }
    this.#emit('reply:changed', { replyingTo: this.#replyingTo })
  }

  clearReply() {
    this.#replyingTo = null
    this.#emit('reply:changed', { replyingTo: null })
  }

  sendMessage(text) {
    const msg = { text, handle:'You', replyingTo: this.#replyingTo, ts: Date.now() }
    this.clearReply()
    this.#emit('message:sent', { message: msg })
  }

  openThread(handle, text) {
    this.#emit('thread:opened', { handle, text, hub: this.activeHub, channel: this.activeChannel })
  }

  sendThreadReply(text) {
    this.#emit('thread:reply-sent', { message: { text, handle:'You', ts: Date.now() } })
  }

  startCall() {
    if (this.#callState === 'active') { this.#emit('call:sheet-requested'); return }
    this.#callState = 'active'
    this.#callChannelId = this.#activeChannelId
    this.#callHubId     = this.#activeHubId
    this.#callParticipants = [
      { id:'you', name:'You', initials:'JG', color:'#5865f2', muted:false, speaking:false },
    ]
    this.#emit('call:started', { hub: this.activeHub, channel: this.activeChannel, participants: this.#callParticipants })
    // Simulate Alice joining after 1.5 s
    setTimeout(() => {
      this.#callParticipants.push({ id:'u_alice', name:'Alice', initials:'AL', color:'#22c55e', muted:false, speaking:true })
      this.#emit('call:participants-changed', { participants: this.#callParticipants })
    }, 1500)
    // Simulate Bob joining + Alice speaking stops after 4 s
    setTimeout(() => {
      this.#callParticipants.push({ id:'u_bob', name:'Bob', initials:'BO', color:'#f59e0b', muted:true, speaking:false })
      this.#callParticipants.find(p => p.id === 'u_alice').speaking = false
      this.#emit('call:participants-changed', { participants: this.#callParticipants })
    }, 4000)
  }

  simulateIncomingCall() {
    this.#emit('call:incoming', {
      from: { name:'Alice', initials:'AL', color:'#22c55e' },
      hub:  this.activeHub,
      channel: this.activeChannel,
    })
  }

  joinCall() {
    this.startCall()
  }

  leaveCall() {
    if (this.#callState === 'idle') return
    this.#callState = 'idle'
    this.#callParticipants = []
    this.#callChannelId = null
    this.#callHubId     = null
    this.#emit('call:ended')
  }

  toggleMute() {
    const you = this.#callParticipants.find(p => p.id === 'you')
    if (!you) return
    you.muted = !you.muted
    this.#emit('call:participants-changed', { participants: this.#callParticipants })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SHEET CONTROLLER  (reusable swipe-to-dismiss)
// Eliminates the 5× duplicated drag logic that existed before the refactor.
// ══════════════════════════════════════════════════════════════════════════════
class SheetController {
  #sheet; #backdrop
  #dragStart = 0; #dragTime = 0; #dragging = false
  #isDragTargetFn
  static #COMMIT_PX = 80; static #COMMIT_VEL = 0.4

  constructor(sheet, backdrop, {
    handleSelector = '.mob-edit-handle, .mob-edit-toolbar',
    isDragTarget,
  } = {}) {
    this.#sheet    = sheet
    this.#backdrop = backdrop
    this.#isDragTargetFn = isDragTarget ?? (el => !!el.closest(handleSelector))
    this.#bindSwipeDismiss()
    if (backdrop) {
      backdrop.addEventListener('click',    () => this.hide())
      backdrop.addEventListener('touchend', e  => { e.preventDefault(); this.hide() }, { passive: false })
    }
  }

  get el()     { return this.#sheet }
  isOpen()     { return this.#sheet.classList.contains('is-open') }

  show() { this.#backdrop?.classList.add('is-open'); this.#sheet.classList.add('is-open') }

  hide() {
    this.#sheet.style.transform = 'translateY(100%)'
    this.#sheet.addEventListener('transitionend', () => {
      this.#sheet.style.transform = ''
      this.#backdrop?.classList.remove('is-open')
      this.#sheet.classList.remove('is-open')
    }, { once: true })
  }

  #begin(clientY, ts) {
    this.#dragging = true; this.#dragStart = clientY; this.#dragTime = ts
    this.#sheet.style.transition = 'none'
  }
  #move(clientY) {
    if (!this.#dragging) return
    this.#sheet.style.transform = `translateY(${Math.max(0, clientY - this.#dragStart)}px)`
  }
  #end(clientY, ts) {
    if (!this.#dragging) return
    this.#dragging = false
    const dy  = Math.max(0, clientY - this.#dragStart)
    const vel = dy / Math.max(ts - this.#dragTime, 1)
    this.#sheet.style.transition = ''
    if (dy > SheetController.#COMMIT_PX || vel > SheetController.#COMMIT_VEL) {
      this.hide()
    } else {
      this.#sheet.style.transform = ''
    }
  }

  #bindSwipeDismiss() {
    const s = this.#sheet
    s.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || !this.#isDragTargetFn(e.target)) return
      this.#begin(e.touches[0].clientY, e.timeStamp)
    }, { passive: true })
    s.addEventListener('touchmove', e => {
      if (!this.#dragging) return
      this.#move(e.touches[0].clientY)
    }, { passive: true })
    s.addEventListener('touchend',   e => { this.#end(e.changedTouches[0].clientY, e.timeStamp) }, { passive: true })
    s.addEventListener('touchcancel', () => { this.#dragging = false; s.style.transition = ''; s.style.transform = '' })
    s.addEventListener('mousedown', e => {
      if (!this.#isDragTargetFn(e.target)) return
      this.#begin(e.clientY, e.timeStamp); e.preventDefault()
    })
    document.addEventListener('mousemove', e => { if (this.#dragging) this.#move(e.clientY) })
    document.addEventListener('mouseup',   e => { if (this.#dragging) this.#end(e.clientY, e.timeStamp) })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// NAVIGATION VIEW
// Owns the swipe gesture engine and panel transitions. Listens to model events
// that should trigger navigation (hub change → sidebar, thread opened → thread).
// ══════════════════════════════════════════════════════════════════════════════
class NavigationView {
  #model; #viewport; #track; #config
  #panel = 0
  #startX = 0; #startY = 0; #startTime = 0
  #locked = null; #active = false
  #ctx = null  // set after ContextMenuController is constructed
  #dbg         // debug element refs

  constructor(model, { viewport, track, backBtn, threadBackBtn, config, dbg = {} }) {
    this.#model    = model
    this.#viewport = viewport
    this.#track    = track
    this.#config   = config
    this.#dbg      = dbg

    model.addEventListener('hub:changed',   () => this.goTo(0))
    model.addEventListener('thread:opened', () => this.goTo(2))

    backBtn?.addEventListener('click',       () => this.goTo(0))
    threadBackBtn?.addEventListener('click', () => this.goTo(1))

    this.#bindTouch()
    this.#bindMouse()
    this.goTo(1, false)  // start on the message panel
  }

  setCtx(ctx) { this.#ctx = ctx }
  get panel()  { return this.#panel }

  goTo(index, animate = true) {
    this.#panel = Math.max(0, Math.min(PANELS.length - 1, index))
    const pct   = -(this.#panel * (100 / PANELS.length))
    this.#track.style.transition = animate ? 'transform 320ms cubic-bezier(0.32,0.72,0,1)' : 'none'
    this.#track.style.transform  = `translateX(${pct}%)`
    if (this.#dbg.panel) this.#dbg.panel.textContent = `panel: ${PANELS[this.#panel]}`
    this.#model.dispatchEvent(new CustomEvent('panel:changed',
      { detail: { panel: this.#panel, name: PANELS[this.#panel] } }))
  }

  #panelPct(i) { return -(i * (100 / PANELS.length)) }

  #clamp(raw, min, max) {
    if (raw >= min && raw <= max) return raw
    const r = this.#config.rubberBand
    return raw < min ? min - (min - raw) * r : max + (raw - max) * r
  }

  #moveXY(cx, cy) {
    const dx = cx - this.#startX, dy = cy - this.#startY
    if (this.#dbg.dx) this.#dbg.dx.textContent = `dx: ${Math.round(dx)}`
    if (!this.#locked) {
      if (Math.abs(dx) < this.#config.lockPx && Math.abs(dy) < this.#config.lockPx) return false
      this.#locked = Math.abs(dx) >= Math.abs(dy) ? 'h' : 'v'
      if (this.#dbg.dir) this.#dbg.dir.textContent = `dir: ${this.#locked}`
    }
    if (this.#locked !== 'h') return false
    const vpW    = this.#viewport.offsetWidth
    const trackW = vpW * PANELS.length
    const base   = this.#panelPct(this.#panel) / 100 * trackW
    const clamped = this.#clamp(base + dx, -(trackW - vpW), 0)
    this.#track.style.transform = `translateX(${clamped / trackW * 100}%)`
    return true
  }

  #endGesture(cx, ts) {
    this.#active = false
    if (this.#locked !== 'h') { this.#locked = null; return }
    const dx   = cx - this.#startX
    const vel  = Math.abs(dx) / Math.max(ts - this.#startTime, 1)
    const vpW  = this.#viewport.offsetWidth
    const past = Math.abs(dx) >= vpW * (this.#config.commitPct / 100)
    if (this.#dbg.vel) this.#dbg.vel.textContent = `vel: ${vel.toFixed(2)}`
    let target = this.#panel
    if ((past || vel >= this.#config.velocityPx) && dx < 0) target = Math.min(this.#panel + 1, PANELS.length - 1)
    if ((past || vel >= this.#config.velocityPx) && dx > 0) target = Math.max(this.#panel - 1, 0)
    this.goTo(target)
    this.#locked = null
  }

  #begin(cx, cy, ts) {
    this.#startX = cx; this.#startY = cy; this.#startTime = ts
    this.#locked = null; this.#active = true
    this.#track.style.transition = 'none'
    if (this.#dbg.dir) this.#dbg.dir.textContent = 'dir: ?'
    if (this.#dbg.vel) this.#dbg.vel.textContent = 'vel: –'
  }

  #bindTouch() {
    this.#viewport.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || this.#ctx?.isOpen) return
      this.#begin(e.touches[0].clientX, e.touches[0].clientY, e.timeStamp)
    }, { passive: true })
    this.#viewport.addEventListener('touchmove', e => {
      if (!this.#active || e.touches.length !== 1) return
      if (this.#moveXY(e.touches[0].clientX, e.touches[0].clientY)) e.preventDefault()
    }, { passive: false })
    this.#viewport.addEventListener('touchend', e => {
      if (!this.#active) return
      this.#endGesture(e.changedTouches[0].clientX, e.timeStamp)
    }, { passive: true })
    this.#viewport.addEventListener('touchcancel', () => {
      if (!this.#active) return
      this.#active = false; this.#locked = null; this.goTo(this.#panel)
    })
  }

  #bindMouse() {
    this.#viewport.addEventListener('mousedown', e => {
      if (e.button !== 0 || this.#ctx?.isOpen) return
      this.#begin(e.clientX, e.clientY, e.timeStamp); e.preventDefault()
    })
    document.addEventListener('mousemove', e => { if (this.#active) this.#moveXY(e.clientX, e.clientY) })
    document.addEventListener('mouseup',   e => { if (this.#active) this.#endGesture(e.clientX, e.timeStamp) })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// TAB BAR VIEW
// Renders hub tabs + unread badges + New / More buttons.
// Delegates hub switching to the model; sheet visibility to sheet instances.
// ══════════════════════════════════════════════════════════════════════════════
class TabBarView {
  #model; #el; #nav; #overflow; #hubCreateSheet; #ctx

  constructor(model, el, { nav, overflow, hubCreateSheet, ctx }) {
    this.#model = model; this.#el = el; this.#nav = nav
    this.#overflow = overflow; this.#hubCreateSheet = hubCreateSheet; this.#ctx = ctx

    for (const ev of ['hub:changed','hub:created','hub:updated','channel:read']) {
      model.addEventListener(ev, () => this.render())
    }

    el.addEventListener('click', e => {
      const item = e.target.closest('.mob-tab-item')
      if (!item || this.#ctx.lpFired) return
      if (item.dataset.action === 'overflow') { overflow.show(); return }
      if (item.dataset.action === 'new-hub')  { hubCreateSheet.show(); return }
      const hubId = item.dataset.hubId
      if (!hubId) return
      if (hubId === model.activeHubId) {
        document.querySelector('.mob-sidebar-scroll')?.scrollTo({ top: 0, behavior: 'smooth' })
        nav.goTo(0)
      } else {
        model.selectHub(hubId)
      }
    })
  }

  #unread(hub)  { return hub.channels.filter(c => c.mention || c.urgent).length }
  #badge(hub) {
    if (hub.id === this.#model.activeHubId) return ''
    const n = this.#unread(hub)
    return n ? `<span class="mob-tab-badge">${n > 9 ? '9+' : n}</span>` : ''
  }

  render() {
    const m = this.#model, hubs = m.hubs
    const overflow   = hubs.length > m.maxTabs ? hubs.slice(m.maxTabs - 1) : []
    const direct     = hubs.length > m.maxTabs ? hubs.slice(0, m.maxTabs - 1) : hubs
    const inOverflow = overflow.some(h => h.id === m.activeHubId)
    const ovBadge    = overflow.some(h => this.#unread(h) > 0 && h.id !== m.activeHubId)

    this.#el.innerHTML =
      direct.map(hub => `
        <button class="mob-tab-item${hub.id === m.activeHubId ? ' active' : ''}"
                data-hub-id="${hub.id}" type="button" aria-label="${escHtml(hub.name)}">
          <span class="mob-tab-icon" style="background:${hub.color};color:white">
            ${escHtml(hub.initials)}${this.#badge(hub)}
          </span>
          <span class="mob-tab-label">${escHtml(hub.short)}</span>
        </button>`).join('') + `
      <button class="mob-tab-item mob-tab-new-hub" data-action="new-hub" type="button" aria-label="New workspace">
        <span class="mob-tab-icon mob-tab-plus">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="7" y1="1" x2="7" y2="13"/><line x1="1" y1="7" x2="13" y2="7"/></svg>
        </span>
        <span class="mob-tab-label">New</span>
      </button>` + (overflow.length ? `
      <button class="mob-tab-item${inOverflow ? ' active' : ''}"
              data-action="overflow" type="button" aria-label="More workspaces">
        <span class="mob-tab-icon mob-tab-more">•••${ovBadge ? '<span class="mob-tab-badge">·</span>' : ''}</span>
        <span class="mob-tab-label">More</span>
      </button>` : '')
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SIDEBAR VIEW
// Renders the channel list and drives the large-title ↔ compact-title crossfade.
// ══════════════════════════════════════════════════════════════════════════════
class SidebarView {
  #model; #nav; #channelCreateSheet; #hubEditSheet; #ctx
  #scroll; #channelList; #hubNameEl; #compactTitle; #navGear; #hubGear; #header

  constructor(model, { nav, channelCreateSheet, hubEditSheet, ctx }) {
    this.#model = model; this.#nav = nav
    this.#channelCreateSheet = channelCreateSheet
    this.#hubEditSheet = hubEditSheet; this.#ctx = ctx

    this.#scroll      = document.querySelector('.mob-sidebar-scroll')
    this.#channelList = document.getElementById('mob-channel-list')
    this.#hubNameEl   = document.getElementById('mob-hub-name')
    this.#compactTitle = document.getElementById('mob-compact-title')
    this.#navGear     = document.getElementById('mob-nav-gear')
    this.#hubGear     = document.getElementById('mob-hub-edit-btn')
    this.#header      = document.getElementById('mob-sidebar-header')

    model.addEventListener('hub:changed',      () => this.#renderHub())
    model.addEventListener('hub:updated',      () => this.#renderHub())
    model.addEventListener('channel:created',  () => this.#renderChannels())
    model.addEventListener('channel:selected', () => this.#renderChannels())

    this.#scroll.addEventListener('scroll', () => this.#onScroll(), { passive: true })

    // Channel link clicks
    document.getElementById('mob-panel-sidebar').addEventListener('click', e => {
      if (this.#ctx.lpFired) return
      const link = e.target.closest('.channel-link')
      if (!link) return
      e.preventDefault()
      model.selectChannel(link.dataset.channelId)
      const ch = model.activeHub?.channels.find(c => c.id === link.dataset.channelId)
      const name = ch ? `#${ch.name}` : link.textContent.trim()
      document.getElementById('mob-chat-title').textContent = name
      document.querySelector('#mob-panel-main .mob-composer-input').placeholder = `Message ${name}…`
      nav.goTo(1)
    }, true)  // capture so lpFired check fires before link default

    // Gear buttons (both large-title and compact-nav)
    this.#hubGear.addEventListener('click', () => hubEditSheet.open(model.activeHub))
    this.#navGear.addEventListener('click', () => hubEditSheet.open(model.activeHub))

    // New channel button
    document.getElementById('mob-channel-add-btn').addEventListener('click',
      () => channelCreateSheet.show())
  }

  #onScroll() {
    const bottom = this.#hubNameEl.getBoundingClientRect().bottom
    const hdrBot = this.#header.getBoundingClientRect().bottom
    const t = Math.max(0, Math.min(1, (hdrBot - bottom) / (this.#hubNameEl.offsetHeight * 0.6)))
    this.#compactTitle.style.opacity = t
    this.#navGear.style.opacity      = t
    this.#hubNameEl.style.opacity    = 1 - t
    this.#hubGear.style.opacity      = 1 - t
    this.#header.classList.toggle('scrolled', this.#scroll.scrollTop > 4)
  }

  #renderHub() {
    const hub = this.#model.activeHub
    if (!hub) return
    this.#hubNameEl.textContent     = hub.name
    this.#compactTitle.textContent  = hub.name
    this.#scroll.scrollTop          = 0
    this.#hubNameEl.style.opacity   = 1
    this.#compactTitle.style.opacity = 0
    this.#navGear.style.opacity     = 0
    this.#hubGear.style.opacity     = 1
    this.#header.classList.remove('scrolled')
    this.#renderChannels()
  }

  #renderChannels() {
    const hub = this.#model.activeHub
    if (!hub) return
    const activeId = this.#model.activeChannelId
    this.#channelList.innerHTML = hub.channels.map(ch => `
      <li class="channel-item${ch.id === activeId ? ' active' : ''}"
          data-channel-id="${ch.id}"
          ${ch.mention ? 'data-mention=""' : ''}
          ${ch.urgent  ? 'data-urgent=""'  : ''}>
        <a class="channel-link" href="#" data-channel-id="${ch.id}">${escHtml(ch.name)}</a>
      </li>`).join('')
  }

  render() { this.#renderHub() }
}

// ══════════════════════════════════════════════════════════════════════════════
// CHAT VIEW
// Manages the main message panel: send, append, reply bar, pull-to-refresh.
// ══════════════════════════════════════════════════════════════════════════════
class ChatView {
  #model
  #messages; #input; #sendBtn
  #replyBar; #replyName; #replyText; #replyDismiss
  #ptrBar; #ptrStartY = 0; #ptrPulling = false; #ptrLocked = false

  constructor(model) {
    this.#model      = model
    this.#messages   = document.getElementById('mob-messages')
    this.#input      = document.querySelector('#mob-panel-main .mob-composer-input')
    this.#sendBtn    = document.querySelector('#mob-panel-main .mob-composer-send')
    this.#replyBar   = document.getElementById('mob-reply-quote')
    this.#replyName  = document.getElementById('mob-reply-quote-name')
    this.#replyText  = document.getElementById('mob-reply-quote-text')
    this.#replyDismiss = document.getElementById('mob-reply-quote-dismiss')
    this.#ptrBar     = document.getElementById('mob-ptr-bar')

    model.addEventListener('message:sent',  ({ detail: { message } }) => this.#append(message))
    model.addEventListener('reply:changed', ({ detail: { replyingTo } }) => this.#updateReplyBar(replyingTo))

    this.#sendBtn.addEventListener('click', () => this.#send())
    this.#input.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.#send() }
      if (e.key === 'Escape') model.clearReply()
    })
    this.#replyDismiss.addEventListener('click', () => model.clearReply())

    this.#bindPtr()
    this.#messages.scrollTop = 9999
  }

  // Public: called by ContextMenuController for reaction actions
  addReaction(article, emoji) {
    let bar = article.querySelector('.reaction-bar')
    if (!bar) { bar = document.createElement('div'); bar.className = 'reaction-bar'; article.appendChild(bar) }
    const pill = [...bar.querySelectorAll('.reaction-pill')].find(p => p.textContent.startsWith(emoji))
    if (pill) {
      pill.querySelector('.reaction-count').textContent = +pill.querySelector('.reaction-count').textContent + 1
      pill.classList.toggle('reacted')
    } else {
      const btn = document.createElement('button')
      btn.className = 'reaction-pill reacted'; btn.type = 'button'
      btn.innerHTML = `${emoji} <span class="reaction-count">1</span>`
      bar.appendChild(btn)
    }
  }

  #send() {
    const text = this.#input.value.trim()
    if (!text) return
    this.#model.sendMessage(text)
    this.#input.value = ''
  }

  #append(msg) {
    const lastSender = this.#messages.lastElementChild?.dataset.sender
    const isNew = lastSender !== msg.handle
    const art = document.createElement('article')
    art.className = 'message' + (isNew ? ' new-sender' : '')
    art.dataset.sender = msg.handle
    let replyHtml = ''
    if (msg.replyingTo) replyHtml =
      `<div style="font-size:12px;color:var(--text-muted);padding:2px 0 4px;display:flex;gap:6px;align-items:center">` +
      `<span style="width:2px;height:12px;background:var(--accent);border-radius:1px;flex-shrink:0"></span>` +
      `<b style="color:var(--text-secondary)">${escHtml(msg.replyingTo.handle)}</b>` +
      `<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(msg.replyingTo.text)}</span></div>`
    art.innerHTML = msgInnerHtml(msg.handle, timeStr(), `${replyHtml}<p>${escHtml(msg.text)}</p>`)
    this.#messages.appendChild(art)
    this.#messages.scrollTop = this.#messages.scrollHeight
  }

  #updateReplyBar(rt) {
    if (!rt) {
      this.#replyBar.style.display = 'none'
    } else {
      this.#replyName.textContent = rt.handle
      this.#replyText.textContent = rt.text
      this.#replyBar.style.display = 'flex'
      this.#input.focus()
    }
  }

  #bindPtr() {
    const el = this.#messages
    el.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || el.scrollTop > 0) return
      this.#ptrStartY = e.touches[0].clientY; this.#ptrPulling = true; this.#ptrLocked = false
    }, { passive: true })
    el.addEventListener('touchmove', e => {
      if (!this.#ptrPulling) return
      const dy = e.touches[0].clientY - this.#ptrStartY
      this.#ptrBar.classList.toggle('is-visible', dy > 24)
      this.#ptrLocked = dy > 72
    }, { passive: true })
    el.addEventListener('touchend', () => {
      if (!this.#ptrPulling) return; this.#ptrPulling = false
      if (this.#ptrLocked) {
        this.#ptrBar.classList.add('is-loading')
        setTimeout(() => {
          const stub = document.createElement('article')
          stub.className = 'message new-sender'
          stub.dataset.sender = 'System'
          stub.innerHTML = msgInnerHtml('System', 'earlier', '<p>↑ Earlier messages loaded.</p>')
          el.insertBefore(stub, el.firstChild)
          this.#ptrBar.classList.remove('is-visible','is-loading')
        }, 1000)
      } else {
        this.#ptrBar.classList.remove('is-visible')
      }
    }, { passive: true })
    el.addEventListener('touchcancel', () => {
      this.#ptrPulling = false; this.#ptrBar.classList.remove('is-visible','is-loading')
    }, { passive: true })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// THREAD VIEW
// Renders the thread panel when thread:opened fires; handles replies.
// ══════════════════════════════════════════════════════════════════════════════
class ThreadView {
  #model; #messages; #composer; #sendBtn; #title; #subtitle

  constructor(model) {
    this.#model    = model
    this.#messages = document.getElementById('mob-thread-messages')
    this.#composer = document.getElementById('mob-thread-composer')
    this.#sendBtn  = document.getElementById('mob-thread-send')
    this.#title    = document.getElementById('mob-thread-title')
    this.#subtitle = document.getElementById('mob-thread-subtitle')

    model.addEventListener('thread:opened',     ({ detail }) => this.#open(detail))
    model.addEventListener('thread:reply-sent', ({ detail: { message } }) => this.#appendReply(message))

    this.#sendBtn.addEventListener('click', () => this.#send())
    this.#composer.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.#send() }
    })
  }

  #open({ handle, text, channel }) {
    const chName = channel ? `#${channel.name}` : 'channel'
    this.#title.textContent    = 'Thread'
    this.#subtitle.textContent = chName
    this.#composer.placeholder = `Reply in ${chName}…`

    const root = document.createElement('article')
    root.className = 'message mob-thread-root new-sender'
    root.dataset.sender = handle
    root.innerHTML = msgInnerHtml(handle, '', `<p>${escHtml(text)}</p>`)

    const divider = document.createElement('div')
    divider.className = 'mob-thread-divider'
    divider.textContent = '1 reply'

    const stub = document.createElement('article')
    stub.className = 'message mob-thread-reply new-sender'
    stub.dataset.sender = 'Alice'
    stub.innerHTML = msgInnerHtml('Alice', 'just now', '<p>Thanks for the heads up 👍</p>')

    this.#messages.replaceChildren(root, divider, stub)
    this.#messages.scrollTop = 0
  }

  #appendReply(msg) {
    const divider = this.#messages.querySelector('.mob-thread-divider')
    if (divider) {
      const n = +divider.textContent + 1
      divider.textContent = `${n} repl${n === 1 ? 'y' : 'ies'}`
    }
    const lastSender = this.#messages.lastElementChild?.dataset.sender
    const isNew = lastSender !== msg.handle
    const art = document.createElement('article')
    art.className = 'message mob-thread-reply' + (isNew ? ' new-sender' : '')
    art.dataset.sender = msg.handle
    art.innerHTML = msgInnerHtml(msg.handle, timeStr(), `<p>${escHtml(msg.text)}</p>`)
    this.#messages.appendChild(art)
    this.#messages.scrollTop = this.#messages.scrollHeight
  }

  #send() {
    const text = this.#composer.value.trim()
    if (!text) return
    this.#model.sendThreadReply(text)
    this.#composer.value = ''
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// CALL VIEW
// Manages the call sheet, active call bar, and participant grid.
// ══════════════════════════════════════════════════════════════════════════════
class CallView {
  #model; #sc
  #sheetEl; #backdropEl; #barEl; #barTextEl; #barTimerEl
  #participantsEl; #timerEl; #channelInfoEl
  #muteBtn; #cameraBtn; #speakerBtn; #hangupBtn; #barLeaveBtn; #callHeaderBtn
  #timerInterval = null; #elapsed = 0
  #muted = false; #cameraOn = false; #speakerOn = true

  constructor(model) {
    this.#model       = model
    this.#sheetEl     = document.getElementById('mob-call-sheet')
    this.#backdropEl  = document.getElementById('mob-call-backdrop')
    this.#barEl       = document.getElementById('mob-call-bar')
    this.#barTextEl   = document.getElementById('mob-call-bar-text')
    this.#barTimerEl  = document.getElementById('mob-call-bar-timer')
    this.#participantsEl = document.getElementById('mob-call-participants')
    this.#timerEl        = document.getElementById('mob-call-timer')
    this.#channelInfoEl  = document.getElementById('mob-call-channel-info')
    this.#muteBtn    = document.getElementById('mob-call-mute')
    this.#cameraBtn  = document.getElementById('mob-call-camera')
    this.#speakerBtn = document.getElementById('mob-call-speaker')
    this.#hangupBtn  = document.getElementById('mob-call-hangup')
    this.#barLeaveBtn = document.getElementById('mob-call-bar-leave')
    this.#callHeaderBtn = document.getElementById('mob-call-header-btn')

    this.#sc = new SheetController(this.#sheetEl, this.#backdropEl, {
      handleSelector: '.mob-call-handle',
    })

    this.#bindEvents()

    model.addEventListener('call:started',             e => this.#onCallStarted(e.detail))
    model.addEventListener('call:participants-changed', e => this.#renderParticipants(e.detail.participants))
    model.addEventListener('call:ended',               () => this.#onCallEnded())
    model.addEventListener('call:sheet-requested',     () => this.#sc.show())
  }

  #onCallStarted({ hub, channel, participants }) {
    this.#channelInfoEl.textContent = `${hub?.name ?? ''} › #${channel?.name ?? ''}`
    this.#renderParticipants(participants)
    this.#startTimer()
    this.#barEl.classList.add('is-active')
    this.#sc.show()
    this.#muted = false; this.#cameraOn = false; this.#speakerOn = true
    this.#updateControlState()
  }

  #onCallEnded() {
    this.#sc.hide()
    this.#stopTimer()
    this.#barEl.classList.remove('is-active')
    this.#elapsed = 0
    this.#timerEl.textContent = '0:00'
    this.#barTimerEl.textContent = '0:00'
  }

  #renderParticipants(participants) {
    const count = participants.length
    this.#barTextEl.textContent = `${count} in call`
    this.#participantsEl.innerHTML = participants.map(p => `
      <div class="mob-call-tile${p.speaking ? ' speaking' : ''}${p.muted ? ' muted' : ''}">
        <div class="mob-call-tile-avatar" style="background:${escHtml(p.color)}">
          ${escHtml(p.initials)}
          <span class="mob-call-tile-mic">${p.muted ? '🔇' : '🎤'}</span>
        </div>
        <span class="mob-call-tile-name">${escHtml(p.name)}</span>
      </div>
    `).join('')
  }

  #startTimer() {
    this.#elapsed = 0
    this.#timerInterval = setInterval(() => {
      this.#elapsed++
      const m = Math.floor(this.#elapsed / 60)
      const s = String(this.#elapsed % 60).padStart(2, '0')
      const str = `${m}:${s}`
      this.#timerEl.textContent = str
      this.#barTimerEl.textContent = str
    }, 1000)
  }

  #stopTimer() {
    clearInterval(this.#timerInterval)
    this.#timerInterval = null
  }

  #updateControlState() {
    this.#muteBtn.classList.toggle('active', this.#muted)
    this.#muteBtn.querySelector('.mob-call-btn-icon').textContent = this.#muted ? '🔇' : '🎤'
    this.#muteBtn.querySelector('.mob-call-btn-label').textContent = this.#muted ? 'Unmute' : 'Mute'
    this.#cameraBtn.classList.toggle('active', this.#cameraOn)
    this.#cameraBtn.querySelector('.mob-call-btn-icon').textContent = this.#cameraOn ? '📷' : '📵'
    this.#speakerBtn.classList.toggle('active', this.#speakerOn)
  }

  #bindEvents() {
    this.#callHeaderBtn.addEventListener('click', () => this.#model.startCall())

    this.#barEl.addEventListener('click', e => {
      if (e.target === this.#barLeaveBtn) return
      if (this.#model.callState === 'active') this.#sc.show()
    })

    this.#barLeaveBtn.addEventListener('click', e => {
      e.stopPropagation()
      this.#model.leaveCall()
    })

    this.#hangupBtn.addEventListener('click', () => this.#model.leaveCall())

    this.#muteBtn.addEventListener('click', () => {
      this.#muted = !this.#muted
      this.#model.toggleMute()
      this.#updateControlState()
    })

    this.#cameraBtn.addEventListener('click', () => {
      this.#cameraOn = !this.#cameraOn
      this.#updateControlState()
    })

    this.#speakerBtn.addEventListener('click', () => {
      this.#speakerOn = !this.#speakerOn
      this.#updateControlState()
    })

    document.getElementById('mob-call-share').addEventListener('click', () => {
      const icon = document.querySelector('#mob-call-share .mob-call-btn-icon')
      const label = document.querySelector('#mob-call-share .mob-call-btn-label')
      const sharing = document.getElementById('mob-call-share').classList.toggle('active')
      icon.textContent  = sharing ? '⏹' : '🖥'
      label.textContent = sharing ? 'Stop' : 'Share'
    })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// INCOMING CALL VIEW
// Shows a toast when a call:incoming event is received.
// ══════════════════════════════════════════════════════════════════════════════
class IncomingCallView {
  #model; #toastEl; #avatarEl; #nameEl; #subEl
  #acceptBtn; #declineBtn; #timeout = null

  constructor(model) {
    this.#model     = model
    this.#toastEl   = document.getElementById('mob-call-toast')
    this.#avatarEl  = document.getElementById('mob-call-toast-avatar')
    this.#nameEl    = document.getElementById('mob-call-toast-name')
    this.#subEl     = document.getElementById('mob-call-toast-sub')
    this.#acceptBtn  = document.getElementById('mob-call-toast-accept')
    this.#declineBtn = document.getElementById('mob-call-toast-decline')

    this.#acceptBtn.addEventListener('click', () => {
      this.#hide()
      this.#model.joinCall()
    })
    this.#declineBtn.addEventListener('click', () => this.#hide())

    model.addEventListener('call:incoming', e => this.#show(e.detail))
  }

  #show({ from, hub, channel }) {
    this.#avatarEl.textContent    = from.initials
    this.#avatarEl.style.background = from.color
    this.#nameEl.textContent      = from.name
    this.#subEl.textContent       = `started a call in #${channel?.name ?? 'unknown'}`
    this.#toastEl.classList.add('is-visible')
    this.#timeout = setTimeout(() => this.#hide(), 8000)
  }

  #hide() {
    clearTimeout(this.#timeout)
    this.#toastEl.classList.remove('is-visible')
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// CONTEXT MENU CONTROLLER
// Long-press detection across channels, tabs, and messages. Owns lpFired so
// that other views can guard their click handlers against ghost clicks.
// ══════════════════════════════════════════════════════════════════════════════
class ContextMenuController {
  #model; #chat; #nav
  #menuEl; #backdropEl; #viewport
  #lpTimer = null; #lpPeekTimer = null
  #lpStartX = 0; #lpStartY = 0; #lpTarget = null; #lpFired = false
  #ctxTarget = null
  static #PEEK_MS = 300; static #FIRE_MS = 500; static #MOVE_PX = 8

  constructor(model, { chat, nav, viewport, menuEl, backdropEl }) {
    this.#model      = model; this.#chat = chat; this.#nav = nav
    this.#menuEl     = menuEl; this.#backdropEl = backdropEl; this.#viewport = viewport

    menuEl.addEventListener('click', e => {
      const btn = e.target.closest('[data-action]')
      if (!btn) return
      this.#handleAction(btn.dataset.action); this.#hide()
    })
    backdropEl.addEventListener('click',    () => this.#hide())
    backdropEl.addEventListener('touchend', e  => { e.preventDefault(); this.#hide() }, { passive: false })

    this.#bindPressTargets()
  }

  get isOpen()  { return this.#menuEl.classList.contains('is-open') }
  get lpFired() { return this.#lpFired }

  // ── Bind long-press on three zones ────────────────────────────────────────
  #bindPressTargets() {
    const zones = [
      { el: document.querySelector('.mob-sidebar-scroll'),
        pick: el => el.closest('.channel-item') },
      { el: document.getElementById('mob-tab-bar'),
        pick: el => el.closest('.mob-tab-item[data-hub-id]') },
      { el: document.getElementById('mob-panel-main'),
        pick: el => el.closest('.reaction-pill, .mob-composer') ? null : el.closest('.message') },
    ]

    for (const { el, pick } of zones) {
      el.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return
        const p = pick(e.target); if (!p) return
        this.#startLP(p, e.touches[0].clientX, e.touches[0].clientY)
      }, { passive: true })
      el.addEventListener('touchmove', e => {
        if (!this.#lpTimer) return
        if (this.#tooFar(e.touches[0].clientX, e.touches[0].clientY)) this.#cancel()
      }, { passive: true })
      el.addEventListener('touchend',    () => { if (!this.#lpFired) this.#cancel() }, { passive: true })
      el.addEventListener('touchcancel', () => this.#cancel(), { passive: true })
      el.addEventListener('mousedown', e => {
        if (e.button !== 0) return
        const p = pick(e.target); if (!p) return
        this.#startLP(p, e.clientX, e.clientY)
      })
      // Suppress the ghost click that fires after a long press
      el.addEventListener('click', e => {
        if (!this.#lpFired) return
        e.preventDefault(); e.stopImmediatePropagation(); this.#lpFired = false
      }, true)
    }

    document.addEventListener('mousemove', e => {
      if (this.#lpTimer && this.#tooFar(e.clientX, e.clientY)) this.#cancel()
    })
    document.addEventListener('mouseup', () => { if (!this.#lpFired) this.#cancel() })
  }

  #startLP(el, x, y) {
    this.#lpStartX = x; this.#lpStartY = y; this.#lpTarget = el; this.#lpFired = false
    this.#lpPeekTimer = setTimeout(() => el.classList.add('mob-lp-peek'), ContextMenuController.#PEEK_MS)
    this.#lpTimer     = setTimeout(() => {
      el.classList.remove('mob-lp-peek')
      this.#fire(x, y)
    }, ContextMenuController.#FIRE_MS)
  }

  #cancel() {
    clearTimeout(this.#lpPeekTimer); clearTimeout(this.#lpTimer)
    this.#lpPeekTimer = null; this.#lpTimer = null
    this.#lpTarget?.classList.remove('mob-lp-peek'); this.#lpTarget = null
  }

  #tooFar(x, y) {
    return Math.abs(x - this.#lpStartX) > ContextMenuController.#MOVE_PX
        || Math.abs(y - this.#lpStartY) > ContextMenuController.#MOVE_PX
  }

  // ── Menu item definitions ─────────────────────────────────────────────────
  #buildItems(el) {
    const article = el.closest?.('.message')
    if (article) {
      const own = article.querySelector('.message-handle')?.textContent.trim() === 'You'
      return [
        { action:'reply-thread',  icon:'↩',  label:'Reply in Thread' },
        { action:'reply-inline',  icon:'↰',  label:'Reply' },
        '---',
        { action:'react-thumbs',  icon:'👍', label:'Thumbs Up' },
        { action:'react-heart',   icon:'❤️', label:'Heart' },
        { action:'copy-text',     icon:'⎘',  label:'Copy Text' },
        ...(own ? ['---', { action:'delete-msg', icon:'✕', label:'Delete Message', danger:true }] : []),
      ]
    }
    if (el.classList.contains('mob-tab-item')) {
      const hub = this.#model.hubs.find(h => h.id === el.dataset.hubId)
      return hub ? [
        { action:'hub-new-channel', icon:'+',  label:'New Channel' },
        '---',
        { action:'hub-settings',    icon:'⚙', label:'Hub Settings' },
        { action:'hub-leave',       icon:'→',  label:`Leave ${hub.name}`, danger:true },
      ] : []
    }
    const li = el.closest?.('.channel-item')
    if (li) {
      const isDm   = !!li.closest('#mob-dm-list')
      const unread = li.hasAttribute('data-mention') || li.hasAttribute('data-urgent')
      if (isDm) return [
        ...(unread ? [{ action:'mark-read', icon:'✓', label:'Mark as Read' }] : []),
        { action:'mute-dm',  icon:'🔇', label:'Mute' },
        '---',
        { action:'close-dm', icon:'✕',  label:'Close Conversation', danger:true },
      ]
      return [
        ...(unread ? [{ action:'mark-read', icon:'✓', label:'Mark as Read' }] : []),
        { action:'mute-channel',  icon:'🔇', label:'Mute Channel' },
        { action:'copy-link',     icon:'🔗', label:'Copy Link' },
        '---',
        { action:'leave-channel', icon:'→',  label:'Leave Channel', danger:true },
      ]
    }
    return []
  }

  #fire(clientX, clientY) {
    this.#lpFired = true
    this.#ctxTarget = this.#lpTarget

    const items = this.#buildItems(this.#lpTarget)
    if (!items.length) return

    this.#menuEl.innerHTML = items.map(item =>
      item === '---'
        ? `<div class="mob-ctx-divider"></div>`
        : `<button class="mob-ctx-item${item.danger ? ' danger' : ''}" type="button" data-action="${item.action}">
             <span class="mob-ctx-icon">${item.icon ?? ''}</span>
             <span>${item.label}</span>
           </button>`
    ).join('')

    this.#menuEl.style.display = 'flex'
    const vp   = this.#viewport.getBoundingClientRect()
    const mW   = this.#menuEl.offsetWidth  || 192
    const mH   = this.#menuEl.offsetHeight || 160
    const isTab = this.#lpTarget?.classList.contains('mob-tab-item')
    let cx = clientX - vp.left + 6
    let cy = isTab ? vp.height - mH - 58 : clientY - vp.top + 8
    cx = Math.max(8, Math.min(cx, vp.width  - mW - 8))
    cy = Math.max(8, Math.min(cy, vp.height - mH - 8))
    this.#menuEl.style.left = `${cx}px`
    this.#menuEl.style.top  = `${cy}px`
    this.#menuEl.classList.add('is-open')
    this.#backdropEl.style.display = 'block'
  }

  #hide() {
    this.#menuEl.classList.remove('is-open')
    this.#menuEl.style.display = 'none'
    this.#backdropEl.style.display = 'none'
    this.#lpFired = false
  }

  #toast(msg) {
    const el = document.getElementById('dbg-panel')
    const was = el.textContent
    el.textContent = msg
    setTimeout(() => { el.textContent = was }, 2000)
  }

  #handleAction(action) {
    const article = this.#ctxTarget?.closest?.('.message')
    switch (action) {
      case 'reply-thread': {
        const h = article?.querySelector('.message-handle')?.textContent.trim() ?? ''
        const t = article?.querySelector('.message-text p')?.textContent.trim() ?? ''
        this.#model.openThread(h, t); break
      }
      case 'reply-inline': {
        if (article) {
          const h = article.querySelector('.message-handle')?.textContent.trim() ?? ''
          const t = article.querySelector('.message-text p')?.textContent.trim() ?? ''
          this.#model.setReplyingTo(h, t)
        }
        break
      }
      case 'react-thumbs': if (article) this.#chat.addReaction(article, '👍'); break
      case 'react-heart':  if (article) this.#chat.addReaction(article, '❤️'); break
      case 'copy-text': {
        const t = article?.querySelector('.message-text p')?.textContent.trim() ?? ''
        this.#toast(`⎘ "${t.slice(0,32)}${t.length>32?'…':''}"`)
        break
      }
      case 'delete-msg': article?.remove(); this.#toast('message deleted'); break
      case 'mark-read': {
        const li = this.#ctxTarget?.closest?.('.channel-item')
        if (li) this.#model.markChannelRead(li.dataset.channelId)
        this.#toast('✓ marked as read'); break
      }
      default: this.#toast(`ctx: ${action}`)
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SHEET VIEWS  (each composes SheetController for swipe-dismiss)
// ══════════════════════════════════════════════════════════════════════════════

class OverflowSheet {
  #model; #sc; #listEl

  constructor(model, { sheetEl, backdropEl, listEl }) {
    this.#model = model; this.#listEl = listEl
    // Allow drag anywhere on the sheet UNLESS the list is scrolled
    this.#sc = new SheetController(sheetEl, backdropEl, {
      isDragTarget: el => !(el.closest('.mob-overflow-list') && listEl.scrollTop > 0)
    })
    listEl.addEventListener('click', e => {
      const item = e.target.closest('[data-hub-id]'); if (!item) return
      this.hide(); model.selectHub(item.dataset.hubId)
    })
  }

  get isOpen() { return this.#sc.isOpen() }
  show() {
    const overflow = this.#model.hubs.length > this.#model.maxTabs
      ? this.#model.hubs.slice(this.#model.maxTabs - 1) : []
    this.#listEl.innerHTML = overflow.map(hub => `
      <li class="mob-overflow-item${hub.id === this.#model.activeHubId ? ' active' : ''}" data-hub-id="${hub.id}">
        <span class="mob-tab-icon" style="background:${hub.color};color:white;width:38px;height:38px;border-radius:11px;font-size:12px">${escHtml(hub.initials)}</span>
        <span class="mob-overflow-item-name">${escHtml(hub.name)}</span>
        <span class="mob-overflow-checkmark">${hub.id === this.#model.activeHubId ? '✓' : ''}</span>
      </li>`).join('')
    this.#sc.show()
  }
  hide() { this.#sc.hide() }
}

class HubEditSheet {
  #model; #sc; #nameInput; #visInput; #descInput; #titleEl

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#nameInput = document.getElementById('mob-edit-hub-name')
    this.#visInput  = document.getElementById('mob-edit-hub-visibility')
    this.#descInput = document.getElementById('mob-edit-hub-desc')
    this.#titleEl   = document.getElementById('mob-edit-sheet-title')
    document.getElementById('mob-edit-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-edit-done').addEventListener('click',   () => this.#save())
    document.getElementById('mob-edit-backdrop').addEventListener('click', () => this.#sc.hide())
  }

  open(hub) {
    if (!hub) return
    this.#titleEl.textContent = hub.name
    this.#nameInput.value     = hub.name
    this.#visInput.value      = hub.visibility  ?? 'public'
    this.#descInput.value     = hub.description ?? ''
    this.#sc.show()
    setTimeout(() => this.#nameInput.focus(), 340)
  }

  #save() {
    const name = this.#nameInput.value.trim()
    if (!name) { this.#nameInput.focus(); return }
    this.#model.updateHub(this.#model.activeHubId, {
      name, visibility: this.#visInput.value, description: this.#descInput.value.trim(),
    })
    this.#sc.hide()
  }
}

class HubCreateSheet {
  #model; #sc; #nameInput; #visInput; #colorRow; #selectedColor = HUB_COLORS[0]

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#nameInput = document.getElementById('mob-hub-create-name')
    this.#visInput  = document.getElementById('mob-hub-create-vis')
    this.#colorRow  = document.getElementById('mob-hub-color-row')
    document.getElementById('mob-hub-create-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-hub-create-done').addEventListener('click',   () => this.#create())
    this.#colorRow.addEventListener('click', e => {
      const sw = e.target.closest('.mob-hub-color-swatch'); if (!sw) return
      this.#selectedColor = sw.dataset.color; this.#renderColors()
    })
    this.#nameInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') this.#create()
      if (e.key === 'Escape') this.#sc.hide()
    })
  }

  show() {
    this.#nameInput.value = ''; this.#visInput.value = 'public'
    const used = new Set(this.#model.hubs.map(h => h.color))
    this.#selectedColor = HUB_COLORS.find(c => !used.has(c)) ?? HUB_COLORS[this.#model.hubs.length % HUB_COLORS.length]
    this.#renderColors(); this.#sc.show()
    setTimeout(() => this.#nameInput.focus(), 340)
  }

  #renderColors() {
    this.#colorRow.innerHTML = HUB_COLORS.map(c => `
      <button class="mob-hub-color-swatch${c === this.#selectedColor ? ' selected' : ''}"
              data-color="${c}" type="button" style="background:${c}"></button>`).join('')
  }

  #create() {
    const name = this.#nameInput.value.trim(); if (!name) { this.#nameInput.focus(); return }
    this.#sc.hide()
    this.#sc.el.addEventListener('transitionend', () =>
      this.#model.createHub({ name, visibility: this.#visInput.value, color: this.#selectedColor })
    , { once: true })
  }
}

class ChannelCreateSheet {
  #model; #sc; #nameInput; #visInput; #descInput

  constructor(model, { sheetEl, backdropEl }) {
    this.#model = model
    this.#sc = new SheetController(sheetEl, backdropEl)
    this.#nameInput = document.getElementById('mob-ch-name')
    this.#visInput  = document.getElementById('mob-ch-visibility')
    this.#descInput = document.getElementById('mob-ch-desc')
    document.getElementById('mob-ch-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-ch-create').addEventListener('click', () => this.#create())
    this.#nameInput.addEventListener('input', () => {
      const pos = this.#nameInput.selectionStart
      this.#nameInput.value = this.#nameInput.value.replace(/ /g, '-')
      this.#nameInput.setSelectionRange(pos, pos)
    })
    this.#nameInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') this.#create()
      if (e.key === 'Escape') this.#sc.hide()
    })
  }

  show() {
    this.#nameInput.value = ''; this.#visInput.value = 'public'; this.#descInput.value = ''
    this.#sc.show()
    setTimeout(() => this.#nameInput.focus(), 340)
  }

  #create() {
    const name = this.#nameInput.value.trim().toLowerCase().replace(/\s+/g, '-')
    if (!name) { this.#nameInput.focus(); return }
    const hub = this.#model.activeHub; if (!hub) return
    const ch = this.#model.createChannel(hub.id, {
      name, visibility: this.#visInput.value, description: this.#descInput.value.trim(),
    })
    if (!ch) return
    this.#sc.hide()
    document.getElementById('mob-chat-title').textContent = `#${name}`
    document.querySelector('#mob-panel-main .mob-composer-input').placeholder = `Message #${name}…`
  }
}

class UserPrefsSheet {
  #sc; #avatarBtn

  constructor({ sheetEl, backdropEl, avatarBtn }) {
    this.#avatarBtn = avatarBtn
    this.#sc = new SheetController(sheetEl, backdropEl)
    avatarBtn.addEventListener('click', () => this.#sc.show())
    document.getElementById('mob-prefs-cancel').addEventListener('click', () => this.#sc.hide())
    document.getElementById('mob-prefs-status-row').addEventListener('click', e => {
      const btn = e.target.closest('.mob-prefs-status'); if (!btn) return
      document.querySelectorAll('.mob-prefs-status').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      const color = btn.querySelector('.mob-prefs-dot')?.style.background ?? ''
      avatarBtn.style.boxShadow = color ? `0 0 0 2px var(--bg-sidebar), 0 0 0 4px ${color}` : ''
    })
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// BOOTSTRAP  — wire everything together
// ══════════════════════════════════════════════════════════════════════════════
const model = new AppModel(HUBS_DATA, 'h1', 'c1', MAX_TABS)

