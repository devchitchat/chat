<style>
/* ── iPad frame + layout ──────────────────────────────────────────────────── */
.ipad-frame {
  width: 920px;
  flex-shrink: 0;
  border-radius: 20px;
  overflow: hidden;
  border: 10px solid color-mix(in srgb, var(--text-primary) 20%, transparent);
  box-shadow: 0 0 0 1px var(--border), 0 32px 80px rgba(0,0,0,.45);
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

.ipad-status-bar {
  height: 24px;
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
  background: var(--bg-sidebar);
  border-bottom: 1px solid var(--border);
}

.ipad-content {
  display: flex;
  flex: 1;
  min-height: 0;
  height: 636px;
}

/* ── Sidebar ──────────────────────────────────────────────────────────────── */
.ipad-sidebar {
  width: 220px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--border);
  background: var(--bg-sidebar);
  overflow: hidden;
}

.ipad-sidebar-header {
  padding: 12px 12px 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.ipad-team-badge {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.ipad-team-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ipad-sidebar-compose {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ipad-sidebar-compose:hover { background: var(--bg-hover); color: var(--accent); }

.ipad-search-wrap {
  padding: 8px 10px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.ipad-search-field {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--fill-secondary);
  border-radius: 8px;
  padding: 5px 8px;
}
.ipad-search-field svg { color: var(--text-muted); flex-shrink: 0; }

.ipad-search-input {
  flex: 1;
  border: none;
  background: none;
  font-size: 13px;
  color: var(--text-primary);
  outline: none;
  min-width: 0;
  -webkit-appearance: none;
}
.ipad-search-input::placeholder { color: var(--text-muted); }
.ipad-search-input::-webkit-search-cancel-button { display: none; }

.ipad-search-clear {
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 2px;
  font-size: 14px;
  line-height: 1;
  flex-shrink: 0;
  border-radius: 50%;
}
.ipad-search-clear:hover { color: var(--text-primary); }

.ipad-sidebar-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 4px 0;
}

.ipad-section-label {
  padding: 12px 12px 4px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-muted);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ipad-section-add {
  width: 18px;
  height: 18px;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  padding: 0;
  font-size: 16px;
  line-height: 1;
}
.ipad-section-add:hover { color: var(--accent); background: var(--bg-hover); }

.ipad-ch-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  margin: 1px 6px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  color: var(--text-secondary);
  position: relative;
}
.ipad-ch-row:hover { background: var(--bg-hover); color: var(--text-primary); }
.ipad-ch-row.active { background: var(--bg-active); color: var(--accent); font-weight: 500; }

.ipad-ch-prefix {
  font-size: 12px;
  color: inherit;
  flex-shrink: 0;
  width: 14px;
  text-align: center;
}

.ipad-ch-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ipad-unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.ipad-thread-badge {
  font-size: 11px;
  color: var(--text-muted);
  flex-shrink: 0;
  background: var(--bg-elevated);
  border-radius: 10px;
  padding: 1px 6px;
  border: 1px solid var(--border);
}

.ipad-join-pill {
  font-size: 11px;
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border: none;
  border-radius: 10px;
  padding: 2px 8px;
  cursor: pointer;
  flex-shrink: 0;
}
.ipad-join-pill:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }

.ipad-session-row.ended { opacity: 0.55; }

.ipad-session-badge-active {
  font-size: 10px;
  color: #22c55e;
  background: color-mix(in srgb, #22c55e 12%, transparent);
  border-radius: 8px;
  padding: 1px 6px;
  flex-shrink: 0;
}

.ipad-session-badge-ended {
  font-size: 10px;
  color: var(--text-muted);
  background: var(--bg-elevated);
  border-radius: 8px;
  padding: 1px 6px;
  flex-shrink: 0;
  border: 1px solid var(--border);
}

.ipad-thread-subtree {
  display: flex;
  flex-direction: column;
  padding: 2px 0 4px 16px;
}

.ipad-thread-sub-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  margin: 0 4px;
  border-radius: 5px;
  cursor: pointer;
  min-height: 28px;
}
.ipad-thread-sub-item:hover { background: var(--bg-hover); }

.ipad-thread-sub-connector { font-size: 11px; color: var(--text-muted); flex-shrink: 0; }
.ipad-thread-sub-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; color: var(--text-secondary); }
.ipad-thread-sub-meta { font-size: 10px; color: var(--text-muted); flex-shrink: 0; }

.ipad-thread-view-all {
  display: block;
  padding: 3px 8px;
  margin: 0 4px;
  font-size: 11px;
  color: var(--accent);
  border: none;
  background: none;
  cursor: pointer;
  text-align: left;
}
.ipad-thread-view-all:hover { text-decoration: underline; }

.ipad-sidebar-footer {
  border-top: 1px solid var(--border);
  flex-shrink: 0;
  padding: 4px 6px;
}

.ipad-sidebar-nav-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 13px;
  color: var(--text-secondary);
  cursor: pointer;
  width: 100%;
  border: none;
  background: none;
  position: relative;
}
.ipad-sidebar-nav-item:hover { background: var(--bg-hover); color: var(--text-primary); }

.ipad-sidebar-nav-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  position: absolute;
  top: 7px;
  left: 22px;
}

/* ── Main chat area ───────────────────────────────────────────────────────── */
.ipad-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
}

.ipad-chat-header {
  height: 52px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-elevated);
}

.ipad-chat-title-group { flex: 1; min-width: 0; }

.ipad-chat-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ipad-chat-type { font-size: 11px; color: var(--text-muted); }

.ipad-icon-btn {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ipad-icon-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
.ipad-icon-btn.active { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }

/* ── Call bar ─────────────────────────────────────────────────────────────── */
.ipad-call-bar {
  height: 0;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  background: color-mix(in srgb, #22c55e 12%, var(--bg-elevated));
  border-bottom: 1px solid color-mix(in srgb, #22c55e 30%, transparent);
  transition: height 220ms cubic-bezier(0.32, 0.72, 0, 1);
  font-size: 13px;
}
.ipad-call-bar.is-active { height: 36px; }

@keyframes ipad-call-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
}
.ipad-call-bar-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #22c55e; flex-shrink: 0;
  animation: ipad-call-pulse 1.4s ease-in-out infinite;
}
.ipad-call-bar-text { font-size: 13px; font-weight: 500; color: var(--text-primary); flex: 1; }
.ipad-call-bar-timer { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); flex-shrink: 0; }
.ipad-call-bar-leave {
  border: none; background: none; color: #ef4444;
  font-size: 13px; font-weight: 600; cursor: pointer; padding: 4px 6px; flex-shrink: 0;
}
.ipad-call-bar-leave:active { opacity: 0.7; }

/* ── Session banner ───────────────────────────────────────────────────────── */
.ipad-session-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: color-mix(in srgb, var(--accent) 8%, transparent);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  font-size: 12px;
  color: var(--text-secondary);
}
.ipad-session-banner.ended { background: var(--bg-elevated); }
.ipad-session-member-avatars { display: flex; }
.ipad-session-mini-avatar {
  width: 20px; height: 20px; border-radius: 50%;
  font-size: 9px; font-weight: 700; color: white;
  display: flex; align-items: center; justify-content: center;
  margin-left: -6px;
  border: 2px solid var(--bg-elevated);
  flex-shrink: 0;
}
.ipad-session-mini-avatar:first-child { margin-left: 0; }
.ipad-end-session-btn {
  border: 1px solid #ef4444; background: none; color: #ef4444;
  border-radius: 6px; padding: 3px 10px; font-size: 11px; cursor: pointer;
  flex-shrink: 0; margin-left: auto;
}
.ipad-end-session-btn:hover { background: color-mix(in srgb, #ef4444 10%, transparent); }

/* ── Messages ─────────────────────────────────────────────────────────────── */
.ipad-messages {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16px 0;
}

.ipad-messages .message {
  display: grid;
  grid-template-columns: 44px 1fr;
  column-gap: 0;
  row-gap: 2px;
  padding: 2px 16px;
  margin-top: 2px;
}
.ipad-messages .message.new-sender { margin-top: 12px; }
.ipad-messages .message.new-sender:first-child { margin-top: 0; }

.ipad-messages .mob-msg-avatar {
  grid-column: 1; grid-row: 1;
  align-self: start;
  display: flex; justify-content: center; padding-top: 1px;
}
.ipad-messages .mob-msg-avatar-circle {
  width: 34px; height: 34px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: white;
  letter-spacing: 0.03em; flex-shrink: 0;
}
.ipad-messages .message:not(.new-sender) .mob-msg-avatar-circle { visibility: hidden; }

.ipad-messages .mob-msg-header {
  grid-column: 2; grid-row: 1;
  display: flex; align-items: baseline; gap: 6px; min-width: 0;
}
.ipad-messages .message:not(.new-sender) .mob-msg-header { display: none; }

.ipad-messages .message-handle {
  font-size: 14px; font-weight: 600; letter-spacing: -0.1px; white-space: nowrap;
}
.ipad-messages .message-time {
  font-size: 11px; color: var(--text-muted); white-space: nowrap;
}
.ipad-messages .message-text {
  grid-column: 2; font-size: 14px; line-height: 1.45; color: var(--text-primary);
}
.ipad-messages .message-text p { margin: 0; }

.ipad-messages .reaction-bar {
  grid-column: 2; display: flex; gap: 6px; flex-wrap: wrap; margin-top: 3px;
}
.ipad-messages .reaction-pill {
  display: inline-flex; align-items: center; gap: 4px;
  border: 1px solid var(--border); border-radius: 12px;
  padding: 3px 8px; font-size: 12px;
  background: none; cursor: pointer; color: var(--text-secondary);
}
.ipad-messages .reaction-pill.reacted {
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  color: var(--accent);
}
.ipad-messages .reaction-count { font-size: 11px; }
.ipad-messages .mention {
  color: var(--accent); font-weight: 500;
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border-radius: 3px; padding: 0 3px;
}

/* ── Join banner ──────────────────────────────────────────────────────────── */
.ipad-join-banner {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 16px;
  background: color-mix(in srgb, var(--accent) 8%, transparent);
  border-top: 1px solid var(--border);
  flex-shrink: 0; font-size: 13px; color: var(--text-secondary);
}
.ipad-join-banner-text { flex: 1; }
.ipad-join-banner-btn {
  background: var(--accent); color: white; border: none; border-radius: 8px;
  padding: 6px 14px; font-size: 13px; font-weight: 600; cursor: pointer; flex-shrink: 0;
}
.ipad-join-banner-btn:active { opacity: 0.8; }

/* ── Composer ─────────────────────────────────────────────────────────────── */
.ipad-composer {
  padding: 10px 16px 14px;
  flex-shrink: 0;
  border-top: 1px solid var(--border);
  background: var(--bg-base);
}

.ipad-reply-quote {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 10px; margin-bottom: 6px;
  background: var(--bg-elevated); border-radius: 6px;
  border-left: 3px solid var(--accent);
  font-size: 12px; color: var(--text-secondary);
}
.ipad-reply-quote-name { font-weight: 600; color: var(--text-primary); flex-shrink: 0; }
.ipad-reply-quote-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ipad-reply-quote-dismiss {
  border: none; background: none; color: var(--text-muted);
  font-size: 16px; cursor: pointer; padding: 0 0 0 4px; flex-shrink: 0; line-height: 1;
}

.ipad-composer-row { display: flex; align-items: flex-end; gap: 8px; }

.ipad-composer-input {
  flex: 1;
  background: var(--fill-secondary); border: none; border-radius: 10px;
  padding: 8px 12px; font-size: 14px; color: var(--text-primary);
  outline: none; resize: none; font-family: inherit; max-height: 120px; line-height: 1.4;
}
.ipad-composer-input::placeholder { color: var(--text-muted); }

.ipad-composer-send {
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--accent); border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; color: white;
}
.ipad-composer-send:active { opacity: 0.8; transform: scale(0.94); }

/* ── Thread panel ─────────────────────────────────────────────────────────── */
.ipad-thread-panel {
  width: 0; flex-shrink: 0; overflow: hidden;
  display: flex; flex-direction: column;
  border-left: 1px solid var(--border);
  background: var(--bg-elevated);
  transition: width 260ms cubic-bezier(0.32, 0.72, 0, 1);
}
.ipad-thread-panel.is-open { width: 280px; }

.ipad-thread-header {
  height: 52px; flex-shrink: 0;
  display: flex; align-items: center; gap: 8px;
  padding: 0 14px; border-bottom: 1px solid var(--border);
}
.ipad-thread-label { font-size: 14px; font-weight: 600; color: var(--text-primary); flex: 1; }

.ipad-thread-messages { flex: 1; min-height: 0; overflow-y: auto; padding: 12px 0; }

.ipad-thread-root {
  padding: 10px 14px 8px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 4px;
}
.ipad-thread-root-text { font-size: 13px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 4px; }
.ipad-thread-root-meta { font-size: 11px; color: var(--text-muted); }
.ipad-thread-reply-count {
  display: inline-block; font-size: 11px; color: var(--text-muted);
  background: var(--bg-base); border-radius: 10px; padding: 1px 7px;
  border: 1px solid var(--border); margin-top: 6px;
}

.ipad-thread-composer {
  padding: 8px 12px 12px; flex-shrink: 0; border-top: 1px solid var(--border);
}
.ipad-thread-input {
  width: 100%; background: var(--fill-secondary); border: none;
  border-radius: 8px; padding: 7px 10px; font-size: 13px;
  color: var(--text-primary); outline: none; font-family: inherit; box-sizing: border-box;
}
.ipad-thread-input::placeholder { color: var(--text-muted); }

.ipad-thread-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8px; color: var(--text-muted); font-size: 13px; padding: 24px;
  text-align: center; height: 100%;
}

.ipad-thread-msg {
  display: grid; grid-template-columns: 36px 1fr;
  row-gap: 2px; padding: 3px 14px; margin-top: 2px;
}
.ipad-thread-msg.new-sender { margin-top: 10px; }
.ipad-thread-msg-avatar { grid-column: 1; grid-row: 1; align-self: start; display: flex; justify-content: center; padding-top: 1px; }
.ipad-thread-msg-avatar-circle {
  width: 26px; height: 26px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700; color: white; flex-shrink: 0;
}
.ipad-thread-msg:not(.new-sender) .ipad-thread-msg-avatar-circle { visibility: hidden; }
.ipad-thread-msg-header { grid-column: 2; grid-row: 1; display: flex; align-items: baseline; gap: 5px; }
.ipad-thread-msg:not(.new-sender) .ipad-thread-msg-header { display: none; }
.ipad-thread-msg-handle { font-size: 12px; font-weight: 600; }
.ipad-thread-msg-time { font-size: 10px; color: var(--text-muted); }
.ipad-thread-msg-text { grid-column: 2; font-size: 13px; line-height: 1.4; color: var(--text-primary); }
.ipad-thread-msg-text p { margin: 0; }

/* ── Sheet common ─────────────────────────────────────────────────────────── */
.ipad-backdrop {
  position: absolute; inset: 0; z-index: 70;
  background: rgba(0,0,0,.4); opacity: 0;
  pointer-events: none; transition: opacity 280ms;
}
.ipad-backdrop.is-open { opacity: 1; pointer-events: auto; }

.ipad-sheet {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 71;
  background: var(--bg-elevated); border-radius: 16px 16px 0 0;
  height: 88%; display: flex; flex-direction: column;
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.ipad-sheet.is-open { transform: translateY(0); pointer-events: auto; }

.ipad-sheet-handle {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--border); margin: 10px auto 0; flex-shrink: 0;
}
.ipad-sheet-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px 10px; border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.ipad-sheet-title {
  font-size: 16px; font-weight: 600; color: var(--text-primary); flex: 1; text-align: center;
}
.ipad-sheet-btn-cancel,
.ipad-sheet-btn-done {
  border: none; background: none; font-size: 15px; cursor: pointer; padding: 4px 0; min-width: 60px;
}
.ipad-sheet-btn-cancel { color: var(--text-secondary); text-align: left; }
.ipad-sheet-btn-done { color: var(--accent); text-align: right; font-weight: 600; }
.ipad-sheet-btn-done:active { opacity: 0.6; }

.ipad-sheet-body {
  flex: 1; overflow-y: auto; padding: 24px 16px 28px;
  display: flex; flex-direction: column; gap: 24px;
}
.ipad-sheet-group { display: flex; flex-direction: column; gap: 6px; }
.ipad-sheet-label {
  font-size: 11px; font-weight: 700; letter-spacing: 0.09em;
  text-transform: uppercase; color: var(--text-muted);
}
.ipad-sheet-input {
  background: var(--bg-base); border: 1px solid var(--border);
  border-radius: 8px; padding: 10px 12px; font-size: 15px;
  color: var(--text-primary); outline: none; width: 100%;
  font-family: inherit; resize: none; box-sizing: border-box;
}
.ipad-sheet-input:focus { border-color: var(--accent); }

.ipad-sheet-ch-name-wrap {
  display: flex; align-items: center;
  background: var(--bg-base); border: 1px solid var(--border);
