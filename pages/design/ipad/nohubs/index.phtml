// ── AppModel ───────────────────────────────────────────────────────────────────
class AppModel extends EventTarget {
  channels = CHANNELS
  threads  = THREADS
  activeId      = null
  activeSection = null
  activeChannel = null
  activeThread  = null
  replyingTo    = null
  expandedThreadChannelId = null
  callState     = 'idle' // 'idle' | 'active'
  callParticipants = []

  selectChannel(id, section) {
    this.activeId      = id
    this.activeSection = section
    const all = [...this.channels.public, ...this.channels.private, ...this.channels.sessions, ...this.channels.dms]
    this.activeChannel = all.find(c => c.id === id) ?? null
    this.replyingTo    = null
    this.expandedThreadChannelId = id
    this.dispatchEvent(new CustomEvent('channel:selected', { detail: { channel: this.activeChannel, section } }))
  }

  joinChannel(id) {
    const ch = this.channels.public.find(c => c.id === id)
    if (ch) { ch.joined = true; this.dispatchEvent(new CustomEvent('channel:joined', { detail: { channel: ch } })) }
  }

  toggleThreadExpansion(channelId) {
    this.expandedThreadChannelId = this.expandedThreadChannelId === channelId ? null : channelId
    this.dispatchEvent(new CustomEvent('threads:toggled', { detail: { channelId } }))
  }

  openThread(thread, channel) {
    this.activeThread = thread
    this.dispatchEvent(new CustomEvent('thread:opened', { detail: { thread, channel } }))
  }

  openThreadSearch(channelId) {
    this.dispatchEvent(new CustomEvent('thread:search', { detail: { channelId } }))
  }

  endSession(id) {
    const ses = this.channels.sessions.find(s => s.id === id)
    if (ses && ses.status === 'active') {
      ses.status = 'ended'
      ses.endedAt = 'just now'
      this.dispatchEvent(new CustomEvent('session:ended', { detail: { session: ses } }))
    }
  }

  setReplyingTo(replyingTo) {
    this.replyingTo = replyingTo
    this.dispatchEvent(new CustomEvent('reply:changed', { detail: { replyingTo } }))
  }

  clearReply() {
    this.replyingTo = null
    this.dispatchEvent(new CustomEvent('reply:changed', { detail: { replyingTo: null } }))
  }

  sendMessage(text) {
    const msg = { handle:'You', text, replyingTo: this.replyingTo }
    this.replyingTo = null
    this.dispatchEvent(new CustomEvent('reply:changed', { detail: { replyingTo: null } }))
    this.dispatchEvent(new CustomEvent('message:sent', { detail: { message: msg } }))
  }

  sendThreadReply(text) {
    const msg = { handle:'You', text }
    this.dispatchEvent(new CustomEvent('thread:reply-sent', { detail: { message: msg } }))
  }

  startCall() {
    if (this.callState === 'active') {
      this.dispatchEvent(new CustomEvent('call:sheet-requested'))
      return
    }
    this.callState = 'active'
    this.callParticipants = [
      { name:'You',   initials:'JG', color:'#6366f1', speaking:false, muted:false },
      { name:'Alice', initials:'AL', color:'#5865f2', speaking:true,  muted:false },
    ]
    this.dispatchEvent(new CustomEvent('call:started', { detail: { channel: this.activeChannel, participants: this.callParticipants } }))
  }

  simulateIncomingCall() {
    if (this.callState === 'active') return
    const from = { name:'Alice', initials:'AL', color:'#5865f2' }
    this.dispatchEvent(new CustomEvent('call:incoming', { detail: { from, channel: this.activeChannel } }))
  }

  joinCall() {
    this.callState = 'active'
    this.callParticipants = [
      { name:'Alice', initials:'AL', color:'#5865f2', speaking:true,  muted:false },
      { name:'You',   initials:'JG', color:'#6366f1', speaking:false, muted:false },
    ]
    this.dispatchEvent(new CustomEvent('call:started', { detail: { channel: this.activeChannel, participants: this.callParticipants } }))
  }

  leaveCall() {
    this.callState = 'idle'
    this.callParticipants = []
    this.dispatchEvent(new CustomEvent('call:ended'))
  }

  toggleMute() {
    const you = this.callParticipants.find(p => p.name === 'You')
    if (you) { you.muted = !you.muted }
    this.dispatchEvent(new CustomEvent('call:participants-changed', { detail: { participants: this.callParticipants } }))
  }
}

// ── SheetController ────────────────────────────────────────────────────────────
class SheetController {
  #sheet; #backdrop
  #dragStart = 0; #dragTime = 0; #dragging = false
  #isDragTargetFn
  static #COMMIT_PX = 80; static #COMMIT_VEL = 0.4

  constructor(sheet, backdrop, {
    handleSelector = '.ipad-sheet-handle, .ipad-sheet-toolbar, .ipad-call-handle',
    isDragTarget,
  } = {}) {
    this.#sheet    = sheet
    this.#backdrop = backdrop
    this.#isDragTargetFn = isDragTarget ?? (el => !!el.closest(handleSelector))
    this.#bindSwipeDismiss()
    if (backdrop) {
      backdrop.addEventListener('click',    () => this.hide())
      backdrop.addEventListener('touchend', e  => { e.preventDefault(); this.hide() }, { passive: false })
    }
  }

  isOpen() { return this.#sheet.classList.contains('is-open') }
  show()   { this.#backdrop?.classList.add('is-open'); this.#sheet.classList.add('is-open') }

  hide() {
    this.#sheet.style.transform = 'translateY(100%)'
    this.#sheet.addEventListener('transitionend', () => {
      this.#sheet.style.transform = ''
      this.#backdrop?.classList.remove('is-open')
      this.#sheet.classList.remove('is-open')
    }, { once: true })
  }

  #begin(clientY, ts) {
    this.#dragging = true; this.#dragStart = clientY; this.#dragTime = ts
    this.#sheet.style.transition = 'none'
  }
  #move(clientY) {
    if (!this.#dragging) return
    this.#sheet.style.transform = `translateY(${Math.max(0, clientY - this.#dragStart)}px)`
  }
  #end(clientY, ts) {
    if (!this.#dragging) return
    this.#dragging = false
    const dy  = Math.max(0, clientY - this.#dragStart)
    const vel = dy / Math.max(ts - this.#dragTime, 1)
    this.#sheet.style.transition = ''
    if (dy > SheetController.#COMMIT_PX || vel > SheetController.#COMMIT_VEL) this.hide()
    else this.#sheet.style.transform = ''
  }

  #bindSwipeDismiss() {
    const s = this.#sheet
    s.addEventListener('touchstart', e => {
      if (e.touches.length !== 1 || !this.#isDragTargetFn(e.target)) return
      this.#begin(e.touches[0].clientY, e.timeStamp)
    }, { passive: true })
    s.addEventListener('touchmove', e => {
      if (!this.#dragging) return
      this.#move(e.touches[0].clientY)
    }, { passive: true })
    s.addEventListener('touchend',    e => { this.#end(e.changedTouches[0].clientY, e.timeStamp) }, { passive: true })
    s.addEventListener('touchcancel', () => { this.#dragging = false; s.style.transition = ''; s.style.transform = '' })
    s.addEventListener('mousedown', e => {
      if (!this.#isDragTargetFn(e.target)) return
      this.#begin(e.clientY, e.timeStamp); e.preventDefault()
    })
    document.addEventListener('mousemove', e => { if (this.#dragging) this.#move(e.clientY) })
    document.addEventListener('mouseup',   e => { if (this.#dragging) this.#end(e.clientY, e.timeStamp) })
  }
}

// ── SidebarView ────────────────────────────────────────────────────────────────
class SidebarView {
  #model; #scrollEl; #searchInput; #searchClear

  constructor(model) {
    this.#model = model
    this.#scrollEl    = document.getElementById('ipad-nh-sidebar-scroll')
    this.#searchInput = document.getElementById('ipad-nh-search-input')
    this.#searchClear = document.getElementById('ipad-nh-search-clear')

    for (const ev of ['channel:selected','channel:joined','threads:toggled','session:ended']) {
      model.addEventListener(ev, () => this.render())
    }

    this.#scrollEl.addEventListener('click', e => {
      const joinPill = e.target.closest('.ipad-join-pill')
      if (joinPill) { e.stopPropagation(); const row = joinPill.closest('.ipad-ch-row'); if (row) model.joinChannel(row.dataset.id); return }

      const threadItem = e.target.closest('.ipad-thread-sub-item')
      if (threadItem) {
        const threadId   = threadItem.dataset.threadId
        const channelId  = threadItem.dataset.channelId
        const threads    = model.threads[channelId] ?? []
        const thread     = threads.find(t => t.id === threadId)
        if (thread) {
          const allCh = [...model.channels.public, ...model.channels.private, ...model.channels.sessions, ...model.channels.dms]
          const ch = allCh.find(c => c.id === channelId)
          model.openThread(thread, ch)
        }
        return
      }

      const viewAll = e.target.closest('.ipad-thread-view-all')
      if (viewAll) { model.openThreadSearch(viewAll.dataset.channelId); return }

      const row = e.target.closest('.ipad-ch-row')
      if (!row || !row.dataset.id) return
      model.selectChannel(row.dataset.id, row.dataset.section)
    })

    this.#searchInput.addEventListener('input', () => this.#onSearch())
    this.#searchClear.addEventListener('click', () => {
      this.#searchInput.value = ''
      this.#searchClear.style.display = 'none'
      this.render()
    })
  }

  render() {
    const q = this.#searchInput?.value.trim().toLowerCase() ?? ''
    if (q) { this.#renderSearch(q); return }
    this.#renderChannels()
  }

  #onSearch() {
    const q = this.#searchInput.value.trim()
    this.#searchClear.style.display = q ? '' : 'none'
    this.render()
  }

  #renderSearch(q) {
    const model = this.#model
    const allCh = [
      ...model.channels.public.map(c=>({...c,section:'public',prefix:'#'})),
      ...model.channels.private.map(c=>({...c,section:'private',prefix:'🔒'})),
      ...model.channels.sessions.map(c=>({...c,section:'sessions',prefix:'◈'})),
      ...model.channels.dms.map(c=>({...c,section:'dms',prefix:'@'})),
    ]
    const matchCh = allCh.filter(c => c.name.toLowerCase().includes(q))
    const threadMatches = []
    for (const [chId, threads] of Object.entries(model.threads)) {
      for (const t of threads) {
        if (t.rootMsg.toLowerCase().includes(q) || t.author.toLowerCase().includes(q)) {
          const ch = allCh.find(c => c.id === chId)
          threadMatches.push({ thread:t, ch })
        }
      }
    }

    let html = ''
    if (matchCh.length) {
      html += `<div class="ipad-section-label">Channels</div>`
      for (const c of matchCh) {
        const active = c.id === model.activeId
        html += `<div class="ipad-ch-row${active?' active':''}" data-id="${c.id}" data-section="${c.section}" role="button" tabindex="0">
          <span class="ipad-ch-prefix">${escHtml(c.prefix)}</span>
          <span class="ipad-ch-name">${escHtml(c.name)}</span>
        </div>`
      }
    }
    if (threadMatches.length) {
      html += `<div class="ipad-section-label">Threads</div>`
      for (const { thread, ch } of threadMatches) {
        html += `<div class="ipad-thread-sub-item" data-thread-id="${thread.id}" data-channel-id="${ch?.id??''}" role="button" tabindex="0">
          <span class="ipad-thread-sub-connector">↳</span>
          <span class="ipad-thread-sub-text">${escHtml(thread.rootMsg)}</span>
          <span class="ipad-thread-sub-meta">${thread.replies}r · ${thread.lastActivity}</span>
        </div>`
      }
    }
    if (!html) html = `<div style="padding:16px;font-size:13px;color:var(--text-muted);text-align:center">No results for "${escHtml(q)}"</div>`
    this.#scrollEl.innerHTML = html
  }

  #renderChannels() {
    const m = this.#model
    let html = ''

    html += this.#sectionHeader('PUBLIC', 'ipad-nh-pub-add')
    for (const ch of m.channels.public) {
      html += this.#channelRow(ch, 'public', '#')
      if (m.expandedThreadChannelId === ch.id) html += this.#threadSubtree(ch.id)
    }
    html += this.#sectionHeader('PRIVATE', 'ipad-nh-prv-add')
    for (const ch of m.channels.private) {
      html += this.#channelRow(ch, 'private', '🔒')
      if (m.expandedThreadChannelId === ch.id) html += this.#threadSubtree(ch.id)
    }
    html += this.#sectionHeader('SESSIONS', 'ipad-nh-ses-add')
    for (const ses of m.channels.sessions) {
      html += this.#sessionRow(ses)
      if (m.expandedThreadChannelId === ses.id) html += this.#threadSubtree(ses.id)
    }
    html += this.#sectionHeader('DIRECT MESSAGES', 'ipad-nh-add-dm')
    for (const dm of m.channels.dms) html += this.#dmRow(dm)

    this.#scrollEl.innerHTML = html

    const active = this.#scrollEl.querySelector('.ipad-ch-row.active')
    if (active) active.scrollIntoView({ block:'nearest', behavior:'smooth' })
  }

  #sectionHeader(label, addId) {
    const btn = addId
      ? `<button class="ipad-section-add" id="${addId}" type="button" title="Add">
           <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="7" y1="1" x2="7" y2="13"/><line x1="1" y1="7" x2="13" y2="7"/></svg>
         </button>`
      : ''
    return `<div class="ipad-section-label">${escHtml(label)}${btn}</div>`
  }

  #channelRow(ch, section, prefix) {
    const active = ch.id === this.#model.activeId
    let right = ''
    if (section === 'public' && !ch.joined) right = `<button class="ipad-join-pill" type="button">Join</button>`
    else if (ch.unread && !active) right = `<span class="ipad-unread-dot"></span>`
    else if (ch.threadCount > 0 && !active) right = `<span class="ipad-thread-badge">${ch.threadCount}</span>`
    const prefixHtml = section === 'private'
      ? `<svg class="ipad-ch-prefix" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
      : `<span class="ipad-ch-prefix">${escHtml(prefix)}</span>`
    return `<div class="ipad-ch-row${active?' active':''}" data-id="${ch.id}" data-section="${section}" role="button" tabindex="0">${prefixHtml}<span class="ipad-ch-name">${escHtml(ch.name)}</span>${right}</div>`
  }

  #sessionRow(ses) {
    const active = ses.id === this.#model.activeId
    const ended  = ses.status === 'ended'
    const badge  = ended
      ? `<span class="ipad-session-badge-ended">ended</span>`
      : `<span class="ipad-session-badge-active">live</span>`
    return `<div class="ipad-ch-row${ended?' ipad-session-row ended':''}${active?' active':''}" data-id="${ses.id}" data-section="sessions" role="button" tabindex="0"><span class="ipad-ch-prefix">◈</span><span class="ipad-ch-name">${escHtml(ses.name)}</span>${badge}</div>`
  }

  #dmRow(dm) {
    const active = dm.id === this.#model.activeId
    const color  = senderColor(dm.name)
    const right  = dm.unread ? `<span class="ipad-unread-dot"></span>` : ''
    return `<div class="ipad-ch-row${active?' active':''}" data-id="${dm.id}" data-section="dms" role="button" tabindex="0"><span class="ipad-ch-prefix" style="color:${color};font-size:8px">●</span><span class="ipad-ch-name">${escHtml(dm.name)}</span>${right}</div>`
  }

  #threadSubtree(channelId) {
    const threads = this.#model.threads[channelId] ?? []
    if (!threads.length) return ''
    const showMax = 4
    const visible = threads.slice(0, showMax)
    let html = `<div class="ipad-thread-subtree">`
    for (const t of visible) {
      html += `<div class="ipad-thread-sub-item" data-thread-id="${t.id}" data-channel-id="${channelId}" role="button" tabindex="0">
        <span class="ipad-thread-sub-connector">↳</span>
        <span class="ipad-thread-sub-text">${escHtml(t.rootMsg)}</span>
        <span class="ipad-thread-sub-meta">${t.replies}r · ${t.lastActivity}</span>
      </div>`
    }
    if (threads.length > showMax) {
      html += `<button class="ipad-thread-view-all" data-channel-id="${channelId}" type="button">view all ${threads.length} threads</button>`
    }
    html += `</div>`
    return html
  }
}

