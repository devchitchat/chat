// ── ContextMenuController ──────────────────────────────────────────────────────
class ContextMenuController {
  #model; #chat; #threadPanel
  #menuEl; #backdropEl
  #ctxTarget = null
  #lpTimer = null; #lpStartX = 0; #lpStartY = 0; #lpFired = false
  static #FIRE_MS = 500; static #MOVE_PX = 8

  constructor(model, { chat, threadPanel }) {
    this.#model       = model
    this.#chat        = chat
    this.#threadPanel = threadPanel
    this.#menuEl      = document.getElementById('ipad-nh-ctx-menu')
    this.#backdropEl  = document.getElementById('ipad-nh-ctx-backdrop')

    this.#menuEl.addEventListener('click', e => {
      const btn = e.target.closest('[data-action]')
      if (!btn) return
      this.#handleAction(btn.dataset.action)
      this.#hide()
    })
    this.#backdropEl.addEventListener('click', () => this.#hide())

    // Right-click (desktop/Magic Trackpad two-finger tap)
    document.getElementById('ipad-nh-messages').addEventListener('contextmenu', e => {
      const article = e.target.closest('.message')
      if (!article) return
      e.preventDefault()
      this.#ctxTarget = article
      this.#show(e.clientX, e.clientY, article)
    })

    // Long-press on messages
    const zones = [
      { el: document.getElementById('ipad-nh-messages'),
        pick: el => el.closest('.reaction-pill') ? null : el.closest('.message') },
      { el: document.getElementById('ipad-nh-sidebar-scroll'),
        pick: el => el.closest('.ipad-ch-row') },
    ]
    for (const { el, pick } of zones) {
      el.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return
        const target = pick(e.target); if (!target) return
        this.#lpStartX = e.touches[0].clientX; this.#lpStartY = e.touches[0].clientY
        this.#lpFired = false
        this.#lpTimer = setTimeout(() => {
          this.#lpFired = true
          this.#ctxTarget = target
          this.#show(this.#lpStartX, this.#lpStartY, target)
        }, ContextMenuController.#FIRE_MS)
      }, { passive: true })
      el.addEventListener('touchmove', e => {
        if (!this.#lpTimer) return
        const t = e.touches[0]
        if (Math.abs(t.clientX - this.#lpStartX) > ContextMenuController.#MOVE_PX ||
            Math.abs(t.clientY - this.#lpStartY) > ContextMenuController.#MOVE_PX) {
          clearTimeout(this.#lpTimer); this.#lpTimer = null
        }
      }, { passive: true })
      el.addEventListener('touchend',    () => { clearTimeout(this.#lpTimer); this.#lpTimer = null }, { passive: true })
      el.addEventListener('touchcancel', () => { clearTimeout(this.#lpTimer); this.#lpTimer = null }, { passive: true })
      // Suppress the click that fires after a long-press
      el.addEventListener('click', e => {
        if (!this.#lpFired) return
        e.preventDefault(); e.stopImmediatePropagation(); this.#lpFired = false
      }, true)
    }
  }

  #show(px, py, target) {
    const isChannel = target.classList.contains('ipad-ch-row')
    let items
    if (isChannel) {
      const name    = target.querySelector('.ipad-ch-name')?.textContent.trim() ?? ''
      const section = target.dataset.section
      const isOwner = section === 'sessions' && this.#model.channels.sessions.find(s => s.id === target.dataset.id)?.owner === 'You'
      items = [
        { action:'ch-mark-read', label:'Mark as Read' },
        { action:'ch-copy-link', label:'Copy Link' },
        ...(section === 'public' || section === 'private'
          ? ['---', { action:'ch-leave', label:'Leave Channel', danger:true }]
          : []),
        ...(isOwner ? ['---', { action:'ch-end-session', label:'End Session', danger:true }] : []),
      ]
    } else {
      const own = target.querySelector('.message-handle')?.textContent.trim() === 'You'
      items = [
        { action:'reply-thread', label:'Reply in Thread' },
        { action:'react-thumbs', label:'👍 Thumbs Up' },
        { action:'react-heart',  label:'❤️ Heart' },
        '---',
        { action:'copy-text',    label:'Copy Text' },
        ...(own ? ['---', { action:'delete-msg', label:'Delete', danger:true }] : []),
      ]
    }
    this.#menuEl.innerHTML = items.map(item =>
      typeof item === 'string'
        ? `<div class="ipad-ctx-divider"></div>`
        : `<button class="ipad-ctx-item${item.danger?' danger':''}" data-action="${item.action}" type="button">${item.label}</button>`
    ).join('')

    const frame = document.getElementById('ipad-nh-frame')
    const fr    = frame.getBoundingClientRect()
    this.#menuEl.style.display = ''  // clear any stale inline style before class takes effect
    this.#menuEl.classList.add('is-open')
    let cx = px - fr.left, cy = py - fr.top
    if (cx + 200 > fr.width)  cx = fr.width - 208
    if (cy + 160 > fr.height) cy = cy - 160
    this.#menuEl.style.left = `${cx}px`
    this.#menuEl.style.top  = `${cy}px`
    this.#backdropEl.style.display = 'block'
  }

  #hide() {
    this.#menuEl.classList.remove('is-open')
    this.#backdropEl.style.display = 'none'
    this.#ctxTarget = null
  }

  #handleAction(action) {
    if (!this.#ctxTarget) return
    // Message actions
    const text   = this.#ctxTarget.querySelector('.message-text')?.textContent.trim() ?? ''
    const handle = this.#ctxTarget.querySelector('.message-handle')?.textContent.trim() ?? ''
    switch (action) {
      case 'reply-thread': {
        const thread = { id:`t_ctx_${Date.now()}`, rootMsg:text.slice(0,60), replies:0, lastActivity:'just now', author:handle }
        this.#model.openThread(thread, this.#model.activeChannel)
        break
      }
      case 'react-thumbs':   this.#chat.addReaction(this.#ctxTarget, '👍'); break
      case 'react-heart':    this.#chat.addReaction(this.#ctxTarget, '❤️'); break
      case 'copy-text':      navigator.clipboard?.writeText(text); break
      case 'delete-msg':     this.#ctxTarget.style.opacity = '0.35'; break
      // Channel actions
      case 'ch-mark-read':   this.#ctxTarget.querySelector('.ipad-unread-dot')?.remove(); break
      case 'ch-copy-link':   navigator.clipboard?.writeText(`#${this.#ctxTarget.querySelector('.ipad-ch-name')?.textContent ?? ''}`); break
      case 'ch-leave':       this.#ctxTarget.style.opacity = '0.4'; break
      case 'ch-end-session': this.#model.endSession(this.#ctxTarget.dataset.id); break
    }
  }
}

class NewDMSheet {
  #model; #sc; #searchEl; #listEl

  static #MEMBERS = [
    { id:'dm1', name:'Alice', initials:'AL', color:'#5865f2', status:'online' },
    { id:'dm2', name:'Bob',   initials:'BO', color:'#22c55e', status:'away'   },
    { id:'dm3', name:'Carol', initials:'CA', color:'#f59e0b', status:'online' },
  ]

  constructor(model) {
    this.#model   = model
    const sheetEl   = document.getElementById('ipad-nh-dm-sheet')
    const backdropEl = document.getElementById('ipad-nh-dm-backdrop')
    this.#sc      = new SheetController(sheetEl, backdropEl, {
      handleSelector: '.ipad-sheet-handle, .ipad-sheet-toolbar',
    })
    this.#searchEl = document.getElementById('ipad-nh-dm-search')
    this.#listEl   = document.getElementById('ipad-nh-dm-list')
    document.getElementById('ipad-nh-dm-cancel').addEventListener('click', () => this.#sc.hide())
    this.#searchEl.addEventListener('input', () => this.#render(this.#searchEl.value))
    this.#listEl.addEventListener('click', e => {
      const row = e.target.closest('.ipad-dm-person-row')
      if (!row) return
      this.#model.selectChannel(row.dataset.id, 'dms')
      this.#sc.hide()
    })
  }

  show() {
    this.#searchEl.value = ''
    this.#render('')
    this.#sc.show()
    setTimeout(() => this.#searchEl.focus(), 340)
  }

  #render(q) {
    const term = q.toLowerCase()
    const filtered = NewDMSheet.#MEMBERS.filter(m => m.name.toLowerCase().includes(term))
    this.#listEl.innerHTML = filtered.map(m => `
      <div class="ipad-dm-person-row" data-id="${m.id}">
        <div class="ipad-dm-person-avatar${m.status === 'away' ? ' away' : ''}" style="background:${m.color}">${m.initials}</div>
        <div class="ipad-dm-person-info">
          <div class="ipad-dm-person-name">${escHtml(m.name)}</div>
          <div class="ipad-dm-person-status">${m.status === 'away' ? 'Away' : 'Online'}</div>
        </div>
      </div>`).join('')
  }
}

