    this.#messagesEl     = document.getElementById('ipad-nh-messages')
    this.#inputEl        = document.getElementById('ipad-nh-composer-input')
    this.#sendBtn        = document.getElementById('ipad-nh-composer-send')
    this.#titleEl        = document.getElementById('ipad-nh-chat-name')
    this.#typeEl         = document.getElementById('ipad-nh-chat-type')
    this.#sessionBanner  = document.getElementById('ipad-nh-session-banner')
    this.#sessionAvatars = document.getElementById('ipad-nh-session-avatars')
    this.#sessionInfo    = document.getElementById('ipad-nh-session-info')
    this.#endSessionBtn  = document.getElementById('ipad-nh-end-session-btn')
    this.#replyQuote     = document.getElementById('ipad-nh-reply-quote')
    this.#replyName      = document.getElementById('ipad-nh-reply-quote-name')
    this.#replyText      = document.getElementById('ipad-nh-reply-quote-text')
    this.#replyDismiss   = document.getElementById('ipad-nh-reply-quote-dismiss')
    this.#joinBanner     = document.getElementById('ipad-nh-join-banner')
    this.#joinBannerName = document.getElementById('ipad-nh-join-banner-name')
    this.#joinBannerBtn  = document.getElementById('ipad-nh-join-banner-btn')

    model.addEventListener('channel:selected', ({ detail }) => this.#updateChannel(detail.channel, detail.section))
    model.addEventListener('message:sent',     ({ detail: { message } }) => this.#appendMessage(message))
    model.addEventListener('reply:changed',    ({ detail: { replyingTo } }) => this.#updateReplyBar(replyingTo))
    model.addEventListener('channel:joined',   () => { this.#joinBanner.style.display = 'none' })
    model.addEventListener('session:ended',    ({ detail: { session } }) => this.#onSessionEnded(session))

    this.#sendBtn.addEventListener('click', () => this.#send())
    this.#inputEl.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.#send() }
      if (e.key === 'Escape') model.clearReply()
    })
    this.#inputEl.addEventListener('input', () => {
      this.#inputEl.style.height = 'auto'
      this.#inputEl.style.height = Math.min(this.#inputEl.scrollHeight, 120) + 'px'
    })
    this.#replyDismiss.addEventListener('click', () => model.clearReply())
    this.#joinBannerBtn.addEventListener('click', () => model.joinChannel(model.activeId))
    this.#endSessionBtn?.addEventListener('click', () => model.endSession(model.activeId))

    this.#messagesEl.scrollTop = 9999
  }

  addReaction(article, emoji) {
    let bar = article.querySelector('.reaction-bar')
    if (!bar) { bar = document.createElement('div'); bar.className = 'reaction-bar'; article.appendChild(bar) }
    const pill = [...bar.querySelectorAll('.reaction-pill')].find(p => p.textContent.startsWith(emoji))
    if (pill) { pill.querySelector('.reaction-count').textContent = +pill.querySelector('.reaction-count').textContent + 1; pill.classList.toggle('reacted') }
    else { const btn = document.createElement('button'); btn.className = 'reaction-pill reacted'; btn.type = 'button'; btn.innerHTML = `${emoji} <span class="reaction-count">1</span>`; bar.appendChild(btn) }
  }

  get messagesEl() { return this.#messagesEl }

  #updateChannel(channel, section) {
    if (!channel) return
    const typeLabels = { public:'Public channel', private:'Private channel', sessions:'Session', dms:'Direct message' }
    const prefix = section === 'public' ? '#' : section === 'sessions' ? '◈ ' : section === 'private' ? '🔒 ' : ''
    this.#titleEl.textContent = `${prefix}${channel.name}`
    this.#typeEl.textContent  = typeLabels[section] ?? ''

    if (section === 'public' && !channel.joined) {
      this.#joinBannerName.textContent = `#${channel.name}`
      this.#joinBanner.style.display = 'flex'
    } else {
      this.#joinBanner.style.display = 'none'
    }

    if (section === 'sessions') {
      this.#sessionBanner.style.display = 'flex'
      const ended = channel.status === 'ended'
      this.#sessionBanner.classList.toggle('ended', ended)
      const colors = ['#5865f2','#22c55e','#f59e0b','#ef4444','#8b5cf6']
      const members = channel.members ?? []
      this.#sessionAvatars.innerHTML = members.map((m, i) =>
        `<div class="ipad-session-mini-avatar" style="background:${colors[i%colors.length]};margin-left:${i?'-4px':'0'}">${senderInitials(m)}</div>`
      ).join('')
      if (ended) {
        this.#sessionInfo.innerHTML = `🔒 Session ended ${escHtml(channel.endedAt ?? '')}`
        if (this.#endSessionBtn) this.#endSessionBtn.style.display = 'none'
      } else {
        this.#sessionInfo.textContent = `Owner: ${channel.owner} · ${members.length} members · Ends in ${channel.autoEndDays}d`
        if (this.#endSessionBtn) this.#endSessionBtn.style.display = channel.owner === 'You' ? '' : 'none'
      }
      this.#inputEl.disabled = ended
      this.#inputEl.placeholder = ended ? 'This session has ended' : `Message ◈ ${channel.name}…`
      this.#sendBtn.style.display = ended ? 'none' : ''
    } else {
      this.#sessionBanner.style.display = 'none'
      this.#inputEl.disabled = false
      this.#inputEl.placeholder = `Message ${section === 'public' ? '#' : section === 'private' ? '🔒 ' : ''}${channel.name}…`
      this.#sendBtn.style.display = ''
    }
  }

  #onSessionEnded(session) {
    this.#sessionBanner.classList.add('ended')
    this.#sessionInfo.innerHTML = `🔒 Session ended just now`
    if (this.#endSessionBtn) this.#endSessionBtn.style.display = 'none'
    this.#inputEl.disabled = true
    this.#inputEl.placeholder = 'This session has ended'
    this.#sendBtn.style.display = 'none'
    const art = document.createElement('article')
    art.className = 'message new-sender'
    art.innerHTML = msgInnerHtml('System', timeStr(), `<p>◈ Session ended by You.</p>`)
    this.#messagesEl.appendChild(art)
    this.#messagesEl.scrollTop = 9999
  }

  #send() {
    const text = this.#inputEl.value.trim()
    if (!text || this.#inputEl.disabled) return
    const ch = this.#model.activeChannel
    if (this.#model.activeSection === 'public' && ch && !ch.joined) {
      this.#model.joinChannel(this.#model.activeId)
      const sysArt = document.createElement('article')
      sysArt.className = 'message new-sender'
      sysArt.innerHTML = msgInnerHtml('System', timeStr(), `<p>You joined <strong>#${escHtml(ch.name)}</strong>.</p>`)
      this.#messagesEl.appendChild(sysArt)
    }
    this.#inputEl.value = ''
    this.#inputEl.style.height = ''
    this.#model.sendMessage(text)
  }

  #appendMessage(msg) {
    const art = document.createElement('article')
    art.className = 'message new-sender'
    let body = `<p>${escHtml(msg.text)}</p>`
    let extra = ''
    if (msg.replyingTo) {
      extra = `<div class="mob-reply-quote"><span class="mob-reply-quote-name">${escHtml(msg.replyingTo.handle)}</span><span class="mob-reply-quote-text">${escHtml(msg.replyingTo.text)}</span></div>`
    }
    art.innerHTML = msgInnerHtml(msg.handle, timeStr(), body, extra)
    this.#messagesEl.appendChild(art)
    this.#messagesEl.scrollTop = 9999
  }

  #updateReplyBar(replyingTo) {
    if (replyingTo) {
      this.#replyName.textContent = replyingTo.handle
      this.#replyText.textContent = replyingTo.text
      this.#replyQuote.style.display = 'flex'
      this.#inputEl.focus()
    } else {
      this.#replyQuote.style.display = 'none'
    }
  }
}

// ── ThreadPanelView ────────────────────────────────────────────────────────────
class ThreadPanelView {
  #model; #panelEl; #messagesEl; #emptyEl; #composerEl; #inputEl; #closeBtn; #toggleBtn; #labelEl

  constructor(model) {
    this.#model      = model
    this.#panelEl    = document.getElementById('ipad-nh-thread-panel')
    this.#messagesEl = document.getElementById('ipad-nh-thread-messages')
    this.#emptyEl    = document.getElementById('ipad-nh-thread-empty')
    this.#composerEl = document.getElementById('ipad-nh-thread-composer')
    this.#inputEl    = document.getElementById('ipad-nh-thread-input')
    this.#closeBtn   = document.getElementById('ipad-nh-thread-close')
    this.#toggleBtn  = document.getElementById('ipad-nh-thread-toggle')
    this.#labelEl    = this.#panelEl.querySelector('.ipad-thread-label')

    model.addEventListener('thread:opened',     ({ detail }) => this.#showThread(detail.thread, detail.channel))
    model.addEventListener('thread:reply-sent', ({ detail: { message } }) => this.#appendReply(message))

    this.#closeBtn.addEventListener('click', () => this.close())
    this.#toggleBtn.addEventListener('click', () => {
      if (this.#panelEl.classList.contains('is-open')) this.close()
      else this.open()
    })
    this.#inputEl.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); this.#sendReply() }
    })
  }

  open() {
    this.#panelEl.classList.add('is-open')
    this.#toggleBtn.classList.add('active')
  }

  close() {
    this.#panelEl.classList.remove('is-open')
    this.#toggleBtn.classList.remove('active')
  }

  #showThread(thread, channel) {
    this.open()
    if (this.#labelEl) this.#labelEl.textContent = 'Thread'
    this.#emptyEl.style.display = 'none'
    this.#composerEl.style.display = ''

    const color  = senderColor(thread.author)
    const init   = senderInitials(thread.author)
    const timeEl = `<time class="message-time">Earlier</time>`

    const rootHtml = `
      <div class="ipad-thread-root">
        <div style="display:grid;grid-template-columns:32px 1fr;gap:0 8px;margin-bottom:6px">
          <div class="mob-msg-avatar" style="grid-row:span 2"><div class="mob-msg-avatar-circle" style="background:${color};width:28px;height:28px;font-size:11px">${escHtml(init)}</div></div>
          <div class="mob-msg-header" style="font-size:12px"><span class="message-handle" style="color:${color}">${escHtml(thread.author)}</span>${timeEl}</div>
          <div class="message-text" style="font-size:13px"><p>${escHtml(thread.rootMsg)}</p></div>
        </div>
        <div class="ipad-thread-reply-count">${thread.replies} repl${thread.replies===1?'y':'ies'}</div>
      </div>`

    const seedReplies = [
      { handle:'Alice', text:'Good point. Let me check the current implementation.' },
      { handle:'Bob',   text:'I think we should benchmark before deciding.' },
      { handle:'You',   text:"Agreed. I'll set up a spike ticket." },
    ].slice(0, Math.min(3, thread.replies))

    let repliesHtml = ''
    for (const r of seedReplies) {
      const rc = senderColor(r.handle)
      const ri = senderInitials(r.handle)
      repliesHtml += `<article class="message new-sender" style="padding:6px 14px">
        <div class="mob-msg-avatar"><div class="mob-msg-avatar-circle" style="background:${rc};width:28px;height:28px;font-size:11px">${escHtml(ri)}</div></div>
        <div class="mob-msg-header" style="font-size:12px"><span class="message-handle" style="color:${rc}">${escHtml(r.handle)}</span></div>
        <div class="message-text" style="font-size:13px"><p>${escHtml(r.text)}</p></div>
      </article>`
    }

    this.#messagesEl.innerHTML = rootHtml + repliesHtml
    this.#messagesEl.scrollTop = 9999
    this.#inputEl.focus()
  }

  #appendReply(msg) {
    const art = document.createElement('article')
    art.className = 'message new-sender'
    art.style.cssText = 'padding:6px 14px'
    const rc = senderColor(msg.handle)
    const ri = senderInitials(msg.handle)
    art.innerHTML = `<div class="mob-msg-avatar"><div class="mob-msg-avatar-circle" style="background:${rc};width:28px;height:28px;font-size:11px">${escHtml(ri)}</div></div>`
      + `<div class="mob-msg-header" style="font-size:12px"><span class="message-handle" style="color:${rc}">${escHtml(msg.handle)}</span></div>`
      + `<div class="message-text" style="font-size:13px"><p>${escHtml(msg.text)}</p></div>`
    this.#messagesEl.appendChild(art)
    this.#messagesEl.scrollTop = 9999
  }

  #sendReply() {
    const text = this.#inputEl.value.trim()
    if (!text) return
    this.#inputEl.value = ''
    this.#model.sendThreadReply(text)
  }
}

// ── CallView ───────────────────────────────────────────────────────────────────
class CallView {
  #model; #sc
  #sheetEl; #backdropEl; #barEl; #barTextEl; #barTimerEl
  #participantsEl; #timerEl; #channelInfoEl
  #muteBtn; #cameraBtn; #speakerBtn; #hangupBtn; #barLeaveBtn; #callBtn
  #timerInterval=null; #elapsed=0
  #muted=false; #cameraOn=false; #speakerOn=true

  constructor(model) {
    this.#model = model
    this.#sheetEl        = document.getElementById('ipad-nh-call-sheet')
    this.#backdropEl     = document.getElementById('ipad-nh-call-backdrop')
    this.#barEl          = document.getElementById('ipad-nh-call-bar')
    this.#barTextEl      = document.getElementById('ipad-nh-call-bar-text')
    this.#barTimerEl     = document.getElementById('ipad-nh-call-bar-timer')
    this.#participantsEl = document.getElementById('ipad-nh-call-participants')
    this.#timerEl        = document.getElementById('ipad-nh-call-timer')
    this.#channelInfoEl  = document.getElementById('ipad-nh-call-channel-info')
    this.#muteBtn        = document.getElementById('ipad-nh-call-mute')
    this.#cameraBtn      = document.getElementById('ipad-nh-call-camera')
    this.#speakerBtn     = document.getElementById('ipad-nh-call-speaker')
    this.#hangupBtn      = document.getElementById('ipad-nh-call-hangup')
    this.#barLeaveBtn    = document.getElementById('ipad-nh-call-bar-leave')
    this.#callBtn        = document.getElementById('ipad-nh-call-btn')

    this.#sc = new SheetController(this.#sheetEl, this.#backdropEl, { handleSelector:'.ipad-call-handle' })

    this.#barEl.addEventListener('click', () => { if (model.callState==='active') model.startCall() })
    this.#barLeaveBtn.addEventListener('click', e => { e.stopPropagation(); model.leaveCall() })
    this.#hangupBtn.addEventListener('click', () => model.leaveCall())
    this.#callBtn.addEventListener('click', () => model.startCall())
    this.#muteBtn.addEventListener('click',    () => { model.toggleMute() })
    this.#cameraBtn.addEventListener('click',  () => { this.#cameraOn=!this.#cameraOn; this.#updateControlState() })
    this.#speakerBtn.addEventListener('click', () => { this.#speakerOn=!this.#speakerOn; this.#updateControlState() })

    model.addEventListener('call:started',              e => this.#onCallStarted(e.detail))
    model.addEventListener('call:participants-changed', e => this.#renderParticipants(e.detail.participants))
    model.addEventListener('call:ended',                () => this.#onCallEnded())
    model.addEventListener('call:sheet-requested',      () => this.#sc.show())
  }

  #onCallStarted({ channel, participants }) {
    this.#channelInfoEl.textContent = `#${channel?.name??''}`
    this.#renderParticipants(participants)
    this.#startTimer()
    this.#barEl.classList.add('is-active')
    this.#sc.show()
    this.#muted=false; this.#cameraOn=false; this.#speakerOn=true
    this.#updateControlState()
  }

  #onCallEnded() {
    this.#sc.hide()
    this.#stopTimer()
    this.#barEl.classList.remove('is-active')
    this.#elapsed=0; this.#timerEl.textContent='0:00'; this.#barTimerEl.textContent='0:00'
  }

  #renderParticipants(participants) {
    this.#barTextEl.textContent = `${participants.length} in call`
    this.#participantsEl.innerHTML = participants.map(p =>
      `<div class="ipad-call-tile${p.speaking?' speaking':''}${p.muted?' muted':''}">
        <div class="ipad-call-tile-avatar" style="background:${escHtml(p.color)}">${escHtml(p.initials)}<span class="ipad-call-tile-mic">${p.muted?'🔇':'🎤'}</span></div>
        <span class="ipad-call-tile-name">${escHtml(p.name)}</span>
      </div>`
    ).join('')
  }

  #startTimer() {
    this.#elapsed=0
    this.#timerInterval = setInterval(() => {
      this.#elapsed++
      const m=Math.floor(this.#elapsed/60), s=String(this.#elapsed%60).padStart(2,'0')
      const str=`${m}:${s}`
      this.#timerEl.textContent=str; this.#barTimerEl.textContent=str
    }, 1000)
  }

  #stopTimer() { clearInterval(this.#timerInterval) }

  #updateControlState() {
    this.#muteBtn.classList.toggle('active', this.#muted)
    this.#cameraBtn.classList.toggle('active', this.#cameraOn)
    this.#speakerBtn.classList.toggle('active', this.#speakerOn)
  }
}

// ── IncomingCallView ───────────────────────────────────────────────────────────
class IncomingCallView {
  #model; #toastEl; #avatarEl; #nameEl; #subEl; #acceptBtn; #declineBtn; #timeout=null

  constructor(model) {
    this.#model     = model
    this.#toastEl   = document.getElementById('ipad-nh-call-toast')
    this.#avatarEl  = document.getElementById('ipad-nh-call-toast-avatar')
    this.#nameEl    = document.getElementById('ipad-nh-call-toast-name')
    this.#subEl     = document.getElementById('ipad-nh-call-toast-sub')
    this.#acceptBtn  = document.getElementById('ipad-nh-call-toast-accept')
    this.#declineBtn = document.getElementById('ipad-nh-call-toast-decline')

    this.#acceptBtn.addEventListener('click', () => { this.#hide(); model.joinCall() })
    this.#declineBtn.addEventListener('click', () => this.#hide())
    model.addEventListener('call:incoming', e => this.#show(e.detail))
  }

  #show({ from, channel }) {
    this.#avatarEl.textContent = from.initials; this.#avatarEl.style.background = from.color
    this.#nameEl.textContent = from.name
    this.#subEl.textContent = `started a call in #${channel?.name??'unknown'}`
    this.#toastEl.classList.add('is-visible')
    this.#timeout = setTimeout(() => this.#hide(), 8000)
  }

  #hide() {
    clearTimeout(this.#timeout)
    this.#toastEl.classList.remove('is-visible')
  }
}

