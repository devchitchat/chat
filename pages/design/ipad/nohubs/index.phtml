  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ipad-prefs-status-row {
  display: flex; flex-direction: column;
  border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
}
.ipad-prefs-status {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 13px; font-size: 14px; color: var(--text-secondary);
  background: var(--bg-base); border: none;
  border-bottom: 1px solid var(--border); cursor: pointer; text-align: left;
}
.ipad-prefs-status:last-child { border-bottom: none; }
.ipad-prefs-status:hover { background: var(--bg-hover); }
.ipad-prefs-status.active { color: var(--text-primary); font-weight: 500; }
.ipad-prefs-status.active::after { content: '✓'; margin-left: auto; color: var(--accent); }
.ipad-prefs-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.ipad-prefs-links {
  display: flex; flex-direction: column;
  border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
}
.ipad-prefs-link {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 13px; font-size: 14px; color: var(--text-primary);
  background: var(--bg-base); border: none;
  border-bottom: 1px solid var(--border); cursor: pointer; text-align: left;
}
.ipad-prefs-link:last-child { border-bottom: none; }
.ipad-prefs-link:hover { background: var(--bg-hover); }
.ipad-prefs-link::after { content: '›'; font-size: 18px; color: var(--text-muted); }
.ipad-prefs-signout {
  width: 100%; padding: 12px;
  border: 1px solid var(--border); border-radius: 8px;
  background: var(--bg-base); color: #ef4444;
  font-size: 14px; font-weight: 500; cursor: pointer;
}
.ipad-prefs-signout:hover { background: color-mix(in srgb, #ef4444 6%, var(--bg-base)); }

/* Activity sheet */
.ipad-activity-item {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 12px 16px; border-bottom: 1px solid var(--border); cursor: pointer;
}
.ipad-activity-item:hover { background: var(--bg-hover); }
.ipad-activity-item.unread { background: color-mix(in srgb, var(--accent) 5%, transparent); }
.ipad-activity-avatar {
  width: 34px; height: 34px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: white; flex-shrink: 0;
}
.ipad-activity-body { flex: 1; min-width: 0; }
.ipad-activity-text { font-size: 13px; color: var(--text-primary); line-height: 1.4; margin-bottom: 2px; }
.ipad-activity-item.unread .ipad-activity-text { font-weight: 600; }
.ipad-activity-sub { font-size: 12px; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ipad-activity-time { font-size: 11px; color: var(--text-muted); flex-shrink: 0; margin-top: 2px; }

/* ── DM people picker ────────────────────────────────────────────────────── */
.ipad-dm-search {
  margin: 10px 14px 0; padding: 7px 11px;
  border-radius: var(--radius-md); border: 1px solid var(--border);
  background: var(--bg-input); color: var(--text-primary);
  font-size: 13px; width: calc(100% - 28px); outline: none;
}
.ipad-dm-search:focus { border-color: var(--accent); }
.ipad-dm-person-row {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 14px; cursor: pointer; border-bottom: 1px solid var(--border);
}
.ipad-dm-person-row:last-child { border-bottom: none; }
.ipad-dm-person-row:hover { background: var(--bg-hover); }
.ipad-dm-person-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700; color: white; flex-shrink: 0;
  position: relative;
}
.ipad-dm-person-avatar::after {
  content: ''; position: absolute; bottom: 1px; right: 1px;
  width: 9px; height: 9px; border-radius: 50%;
  border: 2px solid var(--bg-elevated); background: var(--color-success);
}
.ipad-dm-person-avatar.away::after { background: var(--color-warning); }
.ipad-dm-person-info { flex: 1; min-width: 0; }
.ipad-dm-person-name { font-size: 14px; color: var(--text-primary); font-weight: 500; }
.ipad-dm-person-status { font-size: 11px; color: var(--text-muted); }

/* ── Call backdrop + sheet ────────────────────────────────────────────────── */
.ipad-call-backdrop {
  position: absolute; inset: 0; z-index: 75;
  background: rgba(0,0,0,.55); opacity: 0;
  pointer-events: none; transition: opacity 280ms;
}
.ipad-call-backdrop.is-open { opacity: 1; pointer-events: auto; }

.ipad-call-sheet {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 76;
  background: var(--bg-elevated); border-radius: 16px 16px 0 0;
  height: 85%; display: flex; flex-direction: column;
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.ipad-call-sheet.is-open { transform: translateY(0); pointer-events: auto; }

.ipad-call-handle {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--border); margin: 10px auto 0; flex-shrink: 0;
}
.ipad-call-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 20px 10px; flex-shrink: 0;
}
.ipad-call-channel { font-size: 15px; font-weight: 600; color: var(--text-primary); flex: 1; }
.ipad-call-timer { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); }
.ipad-call-participants {
  flex: 1; min-height: 0;
  display: flex; flex-wrap: wrap; gap: 12px;
  padding: 12px 16px; align-content: flex-start; overflow-y: auto;
}
.ipad-call-tile {
  width: calc(33.333% - 8px);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  padding: 16px 8px 12px; background: var(--bg-base); border-radius: 14px; position: relative;
}
@keyframes ipad-call-speaking {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,.7); }
  50%       { box-shadow: 0 0 0 6px rgba(34,197,94,.0); }
}
.ipad-call-tile-avatar {
  width: 48px; height: 48px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 700; color: white; position: relative; flex-shrink: 0;
}
.ipad-call-tile.speaking .ipad-call-tile-avatar {
  animation: ipad-call-speaking 1s ease-in-out infinite;
  outline: 2.5px solid #22c55e; outline-offset: 2px;
}
.ipad-call-tile-mic {
  position: absolute; bottom: -2px; right: -2px;
  font-size: 10px; background: var(--bg-elevated); border-radius: 50%; padding: 2px;
}
.ipad-call-tile-name {
  font-size: 12px; font-weight: 500; color: var(--text-secondary);
  text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%;
}
.ipad-call-controls {
  display: flex; flex-direction: column; gap: 12px;
  padding: 12px 20px 24px; flex-shrink: 0; border-top: 1px solid var(--border);
}
.ipad-call-controls-row { display: flex; justify-content: space-around; gap: 8px; }
.ipad-call-btn {
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  background: none; border: none; cursor: pointer; min-width: 56px;
}
.ipad-call-btn-icon {
  width: 48px; height: 48px; border-radius: 50%;
  background: var(--bg-base);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; transition: background 160ms, transform 100ms;
}
.ipad-call-btn:active .ipad-call-btn-icon { transform: scale(0.92); }
.ipad-call-btn.active .ipad-call-btn-icon { background: color-mix(in srgb, var(--accent) 18%, var(--bg-base)); }
.ipad-call-btn-label { font-size: 11px; color: var(--text-secondary); white-space: nowrap; }
.ipad-call-hangup {
  width: 60px; height: 60px; border-radius: 50%;
  background: #ef4444; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(239,68,68,.4);
  transition: transform 100ms, box-shadow 100ms;
}
.ipad-call-hangup:active { transform: scale(0.92); box-shadow: 0 2px 8px rgba(239,68,68,.4); }

/* ── Incoming call toast ──────────────────────────────────────────────────── */
.ipad-call-toast {
  position: absolute;
  top: 28px; right: 12px;
  width: 280px; z-index: 80;
  display: flex; align-items: center; gap: 10px;
  background: color-mix(in srgb, var(--bg-elevated) 96%, transparent);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border); border-radius: 14px; padding: 10px 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,.35);
  transform: translateX(calc(100% + 20px));
  transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}
.ipad-call-toast.is-visible { transform: translateX(0); pointer-events: auto; }
.ipad-call-toast-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: white; flex-shrink: 0;
}
.ipad-call-toast-body { flex: 1; min-width: 0; }
.ipad-call-toast-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
.ipad-call-toast-sub { font-size: 12px; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ipad-call-toast-btns { display: flex; gap: 5px; flex-shrink: 0; }
.ipad-call-toast-btn {
  border: none; border-radius: 7px;
  font-size: 12px; font-weight: 600; padding: 5px 10px; cursor: pointer;
}
.ipad-call-toast-btn.decline { background: color-mix(in srgb, #ef4444 15%, var(--bg-base)); color: #ef4444; }
.ipad-call-toast-btn.accept  { background: #22c55e; color: white; }
.ipad-call-toast-btn:active  { opacity: 0.75; }

/* ── Context menu ─────────────────────────────────────────────────────────── */
.ipad-ctx-backdrop {
  position: absolute; inset: 0; z-index: 50; display: none;
}
@keyframes ipad-ctx-in {
  from { opacity: 0; transform: scale(0.92) translateY(-4px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}
.ipad-ctx-menu {
  position: absolute; z-index: 51; min-width: 192px;
  background: color-mix(in srgb, var(--bg-elevated) 95%, transparent);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  border: 1px solid var(--border); border-radius: 10px;
  box-shadow: 0 8px 32px rgba(0,0,0,.3), 0 2px 8px rgba(0,0,0,.15);
  overflow: hidden; display: none; flex-direction: column;
  transform-origin: top left;
  animation: ipad-ctx-in 160ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
}
.ipad-ctx-menu.is-open { display: flex; }
.ipad-ctx-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 15px; font-size: 13px; color: var(--text-primary);
  cursor: pointer; border: none; background: none; width: 100%; text-align: left; white-space: nowrap;
}
.ipad-ctx-item:hover  { background: var(--bg-hover); }
.ipad-ctx-item:active { background: var(--bg-active); }
.ipad-ctx-item.danger { color: #ef4444; }
.ipad-ctx-icon { width: 16px; text-align: center; flex-shrink: 0; font-size: 12px; opacity: .65; }
.ipad-ctx-divider { height: 1px; background: var(--border); flex-shrink: 0; margin: 2px 0; }
</style>

