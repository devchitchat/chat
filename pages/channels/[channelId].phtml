<aside class="sidebar" id="sidebar" role="navigation" aria-label="Channels"
  data-current-channel="{{currentChannelId}}"
  data-userid="{{user.user_id}}"
  data-vapid-key="{{vapidPublicKey}}">

  <header class="sidebar-header">
    <img src="{{base}}/logo-badge.png" class="sidebar-team-badge" alt="devchitchat">
    <span class="sidebar-team-name">devchitchat</span>
  </header>

  <div class="channel-group">

    <div class="channel-section" data-section="public">
      <div class="channel-section-header">
        <span class="channel-section-label">PUBLIC</span>
        <button class="btn-section-add btn-icon" type="button" data-add-section="public"
                title="New channel" aria-label="New channel">+</button>
      </div>
      <ul class="channel-list">
        {{#each channels.public}}
        <li class="channel-item{{#if active}} active{{/if}}{{#unless isMember}} not-member{{/unless}}"
            data-channel-id="{{channel_id}}"
            data-section="public"
            draggable="true">
          <a class="channel-link"
             href="{{url}}"
             data-channel-id="{{channel_id}}"
             data-channel-name="{{name}}"
             data-channel-topic="{{topic}}"
             data-channel-visibility="public"
             data-is-member="{{isMember}}">
            <span class="ch-prefix">#</span> {{name}}
          </a>
          {{#unless isMember}}<span class="ch-join-pill" data-channel-id="{{channel_id}}">Join</span>{{/unless}}
          <span class="call-badge" aria-label="Call active"></span>
        </li>
        {{/each}}
      </ul>
      <a class="ch-browse-all" href="{{base}}/channels" aria-label="Browse all channels">Browse all channels</a>
    </div>

    <div class="channel-section" data-section="private">
      <div class="channel-section-header">
        <span class="channel-section-label">PRIVATE</span>
        <button class="btn-section-add btn-icon" type="button" data-add-section="private"
                title="New private channel" aria-label="New private channel">+</button>
      </div>
      <ul class="channel-list">
        {{#each channels.private}}
        <li class="channel-item{{#if active}} active{{/if}}"
            data-channel-id="{{channel_id}}"
            data-section="private"
            draggable="true">
          <a class="channel-link"
             href="{{url}}"
             data-channel-id="{{channel_id}}"
             data-channel-name="{{name}}"
             data-channel-topic="{{topic}}"
             data-channel-visibility="private">
            <span class="ch-prefix ch-prefix--private">🔒</span> {{name}}
          </a>
        </li>
        {{/each}}
      </ul>
    </div>

    <div class="channel-section" data-section="sessions">
      <div class="channel-section-header">
        <span class="channel-section-label">SESSIONS</span>
        <button class="btn-section-add btn-icon" type="button" data-add-section="sessions"
                title="New session" aria-label="New session">+</button>
      </div>
      <ul class="channel-list">
        {{#each channels.sessions}}
        <li class="channel-item{{#if active}} active{{/if}}{{#if isEnded}} session-ended{{/if}}"
            data-channel-id="{{channel_id}}"
            data-section="sessions"
            draggable="true">
          <a class="channel-link"
             href="{{url}}"
             data-channel-id="{{channel_id}}"
             data-channel-name="{{name}}"
             data-channel-topic="{{topic}}"
             data-channel-visibility="public">
            <span class="ch-prefix ch-prefix--session">&#x25C8;</span> {{name}}
          </a>
          <span class="ch-status {{#if isEnded}}ch-status--ended{{else}}ch-status--active{{/if}}">
            {{#if isEnded}}Ended{{else}}Active{{/if}}
          </span>
        </li>
        {{/each}}
      </ul>
    </div>

    <div class="channel-section" data-section="dms">
      <div class="channel-section-header">
        <span class="channel-section-label">DIRECT MESSAGES</span>
        <button class="btn-section-add btn-icon" type="button" data-add-section="dms"
                title="New message" aria-label="New message">+</button>
      </div>
      <ul class="channel-list" id="dm-list">
        <!-- populated client-side by SidebarView via dm.list_result -->
      </ul>
    </div>

  </div><!-- /.channel-group -->

  <footer class="sidebar-footer">
    {{#if user}}
    <div class="sidebar-footer-user">
      <button class="sidebar-user-identity" id="sidebar-btn-you" type="button" aria-label="Your profile and settings" title="Profile &amp; settings">
        <div class="sidebar-user-avatar" id="sidebar-you-avatar">{{user_initials}}</div>
        <div class="sidebar-user-info">
          <span class="sidebar-username">{{user.display_name}}</span>
          <span class="sidebar-user-status">Active</span>
        </div>
      </button>
      <div class="sidebar-footer-actions">
        <button class="btn-icon sidebar-footer-btn" id="sidebar-search-trigger" aria-label="Search" title="Search" type="button">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <button class="btn-icon sidebar-footer-btn" id="sidebar-btn-activity" aria-label="Activity" title="Activity">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="sidebar-footer-dot" id="sidebar-activity-dot" hidden></span>
        </button>
      </div>
    </div>
    {{/if}}
    <!-- Mini-bar: shown when the user is in a call and navigates to another channel -->
    <div class="call-mini-bar" id="call-mini-bar">
      <span class="call-mini-bar-channel" id="mini-bar-channel-name"></span>
      <button class="btn-icon" id="mini-bar-mic" aria-label="Toggle mic" type="button">🎙</button>
      <button class="btn-ghost" id="mini-bar-return" aria-label="Return to call" type="button">↩</button>
      <button class="btn-ghost" id="mini-bar-leave" aria-label="Leave call" style="color: var(--color-danger)" type="button">✕</button>
    </div>
  </footer>
</aside>

<!-- Main content wrapper: slides in from right on mobile -->
<div class="main-content">

<section class="chat-panel"
  data-id="{{channel.channel_id}}"
  data-name="{{channel.name}}"
  data-topic="{{channel.topic}}"
  data-kind="{{channel.kind}}"
  data-visibility="{{channel.visibility}}"
  data-is-member="{{isMember}}"
  data-is-session-ended="{{isSessionEnded}}"
  data-is-session-owner="{{isSessionOwner}}"
  data-user-id="{{user.user_id}}"
  data-user-handle="{{user.handle}}"
  data-user-display-name="{{user.display_name}}"
  data-user-roles="{{user.roles}}"
  data-seed-seq="{{seedSeq}}"
  data-seed-first-seq="{{seedFirstSeq}}"
  data-seed-has-more="{{seedHasMore}}"
>

  <header class="chat-header">
    <button class="btn-back-mobile" aria-label="Back to channels" type="button">&#8592;</button>
    <hgroup>
      <h2 class="chat-title">
        {{#if channel.visibility === 'private'}}<span class="chat-title-lock">&#x1F512;</span>{{/if}}
        {{channel.name}}
      </h2>
      {{#if channel.visibility === 'private'}}
      <p class="chat-topic">Private channel{{#if channel.topic}} &middot; {{channel.topic}}{{/if}}</p>
      {{else}}
      <p class="chat-topic">{{channel.topic}}</p>
      {{/if}}
    </hgroup>
    <div class="chat-header-actions">
      <button class="btn-icon" id="btn-start-call" aria-label="Start call" type="button">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.83a16 16 0 0 0 6.29 6.29l1.13-1.13a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </button>
      <button class="btn-icon btn-thread-toggle" id="btn-thread-toggle" aria-label="Toggle thread panel" title="Toggle thread panel" type="button">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M9 3v18"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Call status row: shown when a call is active and user hasn't joined -->
  <div class="call-status" id="call-status" hidden>
    <span class="call-status-dot"></span>
    <span class="call-status-info" id="call-status-info">Call in progress</span>
    <div class="call-status-avatars" id="call-status-avatars"></div>
    <button class="btn-primary" id="btn-join-call" style="padding: 6px 14px; font-size: 13px" type="button">
      Join call
    </button>
  </div>

  <!-- In-call controls bar: shown when user is in the call -->
  <div class="call-controls-bar" id="call-controls-bar">
    <button class="btn-icon" id="ctrl-mic" aria-label="Toggle microphone" type="button">🎙</button>
    <button class="btn-icon" id="ctrl-cam" aria-label="Toggle camera" type="button">📷</button>
    <button class="btn-icon" id="ctrl-screen" aria-label="Share screen" type="button">🖥</button>
    <button class="btn-icon" id="ctrl-devices" aria-label="Switch camera or microphone" type="button">&#9881;</button>
    <span class="call-peer-count" id="call-peer-count"></span>
    <button class="btn-leave" id="btn-leave-call" type="button">Leave</button>
  </div>

  <!-- Session banner: shown for session channels -->
  {{#if isSession}}
  <div class="session-banner{{#if isSessionEnded}} session-banner--ended{{/if}}" id="session-banner">
    <div class="session-banner-members" id="session-banner-members">
      {{#each sessionMembers}}
      {{#if avatar_url}}
      <div class="session-avatar" data-user-id="{{user_id}}" title="{{display_name}}"><img src="{{avatar_url}}" class="avatar-img" alt="{{display_name}}"></div>
      {{else}}
      <div class="session-avatar" data-user-id="{{user_id}}" title="{{display_name}}" style="background:{{#if avatar_color}}{{avatar_color}}{{else}}var(--accent){{/if}}">{{initials}}</div>
      {{/if}}
      {{/each}}
    </div>
    <div class="session-banner-info">
      {{#if sessionOwner}}<span class="session-owner">{{sessionOwner.display_name}}</span>{{/if}}
      <span class="session-member-count"> · {{sessionMembers.length}} members</span>
      {{#if isSessionEnded}}
        <span class="session-status session-status--ended"> · Ended</span>
      {{else}}
        <span class="session-status session-status--active"> · Active</span>
      {{/if}}
    </div>
    {{#if isSessionOwner}}
    {{#unless isSessionEnded}}
    <button class="btn-end-session" id="btn-end-session" type="button" data-channel-id="{{channel.channel_id}}">End Session</button>
    {{/unless}}
    {{/if}}
  </div>
  {{/if}}

  <!-- Join banner: shown for public channels the user hasn't joined -->
  {{#unless isMember}}
  {{#if channel.visibility === 'public'}}
  <div class="join-banner" id="join-banner">
    <span class="join-banner-text">You're reading <strong>#{{channel.name}}</strong>. Send a message to join, or:</span>
    <button class="btn-primary btn-sm" id="btn-join-channel" type="button" data-channel-id="{{channel.channel_id}}">Join Channel</button>
  </div>
  {{/if}}
  {{/unless}}

  <!-- Server-rendered initial messages baked in -->
  <div class="messages" id="messages" aria-live="polite" aria-label="Messages" role="log">
    <div class="load-more-sentinel" id="load-more-sentinel" aria-hidden="true" hidden></div>
    {{#each seedMessages}}
    <article class="message" data-seq="{{seq}}" data-msg-id="{{msg_id}}" data-user-id="{{user_id}}" data-raw-text="{{raw_text}}" data-edited-at="{{edited_at}}" data-attachments="{{attachments_json}}" data-reactions="{{reactions_json}}" data-reply-count="{{reply_count}}">
      <span class="message-handle" data-user-id="{{user_id}}">{{user_display_name}}</span>
      <time class="message-time" datetime="{{ts}}">{{ts_fmt}}{{#if edited_at}}<span class="message-edited">(edited)</span>{{/if}}</time>
      <div class="message-text">{{{text}}}</div>
      {{#if reply_count_label}}<a class="thread-replies-link" href="#" data-msg-id="{{msg_id}}">{{reply_count_label}}</a>{{/if}}
      <div class="reaction-bar"></div>
    </article>
    {{/each}}
  </div>

  <footer class="composer">
    <!-- Reply quote bar: shown when replying inline to a message -->
    <div class="reply-quote" id="reply-quote" hidden>
      <span class="reply-quote-name" id="reply-quote-name"></span>
      <span class="reply-quote-text" id="reply-quote-text"></span>
      <button class="reply-quote-dismiss" id="reply-quote-dismiss" type="button" aria-label="Clear reply">✕</button>
    </div>
    <textarea id="message-input" placeholder="Message in {{channel.name}}" aria-label="Write a message"
      rows="1"{{#if isSessionEnded}} disabled{{/if}}></textarea>
    <button class="btn-compose-expand btn-icon" type="button"
      title="Compose mode (Ctrl+E)" aria-label="Open compose mode"{{#if isSessionEnded}} disabled{{/if}}>&#x26F6;</button>
    <button class="btn-send" aria-label="Send message" title="Send" type="button"{{#if isSessionEnded}} disabled{{/if}}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </button>
  </footer>

  <!-- Compose overlay — full-panel editor with Write / Preview tabs -->
  <div class="compose-overlay" id="compose-overlay" hidden>
    <div class="compose-overlay-header">
      <div class="compose-tabs" role="tablist">
        <button class="compose-tab compose-tab--active" data-tab="write"
          role="tab" aria-selected="true" type="button">Write</button>
        <button class="compose-tab" data-tab="preview"
          role="tab" aria-selected="false" type="button">Preview</button>
      </div>
      <button class="btn-compose-collapse btn-icon" id="btn-compose-collapse"
        type="button" title="Collapse (Esc)" aria-label="Collapse compose mode">&#x2715;</button>
    </div>
    <div class="attachment-chips" id="compose-chips" hidden></div>
    <textarea class="compose-textarea" id="compose-textarea"
      placeholder="Write your message… (Ctrl+Enter to send)" aria-label="Compose message"></textarea>
    <div class="compose-preview message-text" id="compose-preview" hidden aria-live="polite"></div>
    <footer class="compose-overlay-footer">
      <button class="btn-attach btn-icon" id="compose-attach" type="button"
        title="Attach file" aria-label="Attach file">&#x1F4CE;</button>
      <button class="btn-send" id="compose-send" type="button" title="Send">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>

    </footer>
  </div>

</section><!-- /.chat-panel -->

<!-- Tile panel: sibling of chat-panel, never inside it -->
<div class="tile-panel" id="tile-panel">
  <div class="tile-panel-header">
    <span class="tile-panel-title" id="tile-panel-title">Call</span>
    <button class="btn-icon tile-panel-collapse" id="tile-panel-collapse" aria-label="Collapse tile panel" type="button">&#8854;</button>
  </div>
  <div class="tile-grid" id="tile-grid"></div>
</div>


</div><!-- /.main-content -->

<!-- Thread panel: fixed viewport overlay — outside .main-content so CSS transforms don't affect positioning -->
<div class="thread-panel" id="thread-panel">
  <div class="thread-panel-header">
    <span class="thread-panel-title">Thread</span>
    <button class="btn-icon thread-panel-close" id="thread-panel-close" aria-label="Close thread" type="button">&#x2715;</button>
  </div>
  <div class="thread-body">
    <div class="thread-anchor" id="thread-anchor"></div>
    <div class="thread-divider"><span>Replies</span></div>
    <div class="thread-replies" id="thread-replies" role="log" aria-label="Thread replies"></div>
  </div>
  <footer class="thread-composer">
    <textarea class="thread-textarea" id="thread-input" placeholder="Hit Enter to Reply in thread." rows="1" aria-label="Reply in thread"></textarea>
  </footer>
</div>

<!-- Incoming call toast -->
<div class="call-toast" id="call-toast" hidden aria-live="polite">
  <div class="call-toast-avatar" id="call-toast-avatar"></div>
  <div class="call-toast-body">
    <div class="call-toast-caller" id="call-toast-caller"></div>
    <div class="call-toast-sub" id="call-toast-sub"></div>
  </div>
  <button class="call-toast-decline" id="call-toast-decline" type="button">Decline</button>
  <button class="call-toast-join" id="call-toast-join" type="button">Join</button>
</div>

<!-- Search sheet — mobile bottom nav -->
<div class="search-backdrop" id="search-backdrop" hidden></div>
<div class="search-sheet" id="search-sheet" role="dialog" aria-label="Search" aria-modal="true" hidden>
  <div class="search-sheet-handle"></div>
  <div class="search-sheet-header">
    <input class="search-sheet-input" id="search-sheet-input" type="search"
           placeholder="Search channels and messages…" autocomplete="off" autocorrect="off"
           spellcheck="false" aria-label="Search">
    <button class="search-sheet-cancel" id="search-sheet-cancel" type="button">Cancel</button>
  </div>
  <div class="search-results" id="search-results" aria-live="polite">
    <p class="search-results-empty" id="search-results-empty">Type to search channels and messages.</p>
  </div>
</div>

<!-- Activity sheet — mobile bottom nav -->
<div class="activity-backdrop" id="activity-backdrop" hidden></div>
<div class="activity-sheet" id="activity-sheet" role="dialog" aria-label="Activity" aria-modal="true" hidden>
  <div class="activity-sheet-handle"></div>
  <div class="activity-sheet-header">
    <h2 class="activity-sheet-title">Activity</h2>
    <button class="activity-sheet-cancel" id="activity-sheet-cancel" type="button">Done</button>
  </div>
  <div class="activity-feed" id="activity-feed" aria-live="polite">
    <p class="activity-empty" id="activity-empty">No recent activity.</p>
  </div>
</div>

<!-- "You" sheet — mobile bottom nav; contains identity, theme, and sign-out -->
<div class="you-backdrop" id="you-backdrop" hidden></div>
<div class="you-sheet" id="you-sheet" role="dialog" aria-label="You" aria-modal="true" hidden>
  <div class="you-sheet-handle"></div>
  <div class="you-sheet-toolbar">
    <span class="you-sheet-title">You</span>
    <button class="you-sheet-done" id="you-sheet-done" type="button">Done</button>
  </div>
  <div class="you-sheet-body">
    {{#if user}}
    <div class="you-identity">
      <div class="you-avatar-wrap">
        <button class="you-avatar" id="you-avatar-btn" type="button" aria-label="Change avatar photo" title="Tap to change photo">{{user_initials}}</button>
        <input class="you-avatar-file" id="you-avatar-file" type="file" accept="image/jpeg,image/png,image/gif,image/webp">
      </div>
      <div class="you-identity-text">
        <span class="you-display-name">{{user.display_name}}</span>
        <span class="you-handle">@{{user.handle}}</span>
      </div>
    </div>
    <div class="you-avatar-controls">
      <div class="you-avatar-editor-initials-row">
        <label class="you-avatar-label" for="you-avatar-initials">Initials</label>
        <input class="you-avatar-initials" id="you-avatar-initials" type="text" maxlength="3" placeholder="AB" autocomplete="off" value="{{user_initials}}">
      </div>
      <div class="you-avatar-colors" id="you-avatar-colors" role="group" aria-label="Background color">
        <button class="you-avatar-swatch" type="button" data-color="#5865f2" style="background:#5865f2" aria-label="Indigo"></button>
        <button class="you-avatar-swatch" type="button" data-color="#ed4245" style="background:#ed4245" aria-label="Red"></button>
        <button class="you-avatar-swatch" type="button" data-color="#57f287" style="background:#57f287" aria-label="Green"></button>
        <button class="you-avatar-swatch" type="button" data-color="#fee75c" style="background:#fee75c" aria-label="Yellow"></button>
        <button class="you-avatar-swatch" type="button" data-color="#eb459e" style="background:#eb459e" aria-label="Fuchsia"></button>
        <button class="you-avatar-swatch" type="button" data-color="#e67e22" style="background:#e67e22" aria-label="Orange"></button>
        <button class="you-avatar-swatch" type="button" data-color="#1abc9c" style="background:#1abc9c" aria-label="Teal"></button>
        <button class="you-avatar-swatch" type="button" data-color="#9b59b6" style="background:#9b59b6" aria-label="Purple"></button>
        <button class="you-avatar-swatch you-avatar-swatch--none" type="button" data-color="" aria-label="Default color" title="Reset to default color">Auto</button>
      </div>
      <button class="you-avatar-remove" id="you-avatar-remove" type="button" hidden>Remove photo</button>
    </div>
    {{/if}}
    <div class="you-section">
      <label class="you-label" for="you-theme-picker">Appearance</label>
      <select id="you-theme-picker" data-theme-picker aria-label="Choose theme" autocomplete="off">
        <option value="dark">Dark</option>
        <option value="light">Light</option>
        <option value="ocean">Ocean</option>
        <option value="forest">Forest</option>
        <option value="rose">Rose</option>
      </select>
    </div>
    <div class="you-section" id="you-notif-section">
      <label class="you-label">Push Notifications</label>
      <div class="you-notif-row">
        <span class="you-notif-status" id="you-notif-status"></span>
        <button class="you-notif-btn" id="you-notif-btn" type="button" hidden>Enable</button>
        <button class="you-notif-btn you-notif-btn--disable" id="you-notif-disable-btn" type="button" hidden>Disable</button>
      </div>
    </div>
    {{#if isAdmin}}
    <a href="{{base}}/admin/invites" class="you-row-link">Admin panel</a>
    {{/if}}
    {{#if user}}
    <form method="POST" action="{{base}}/auth/signout" class="you-signout-form">
      <button type="submit" class="you-signout-btn">Sign out</button>
    </form>
    {{/if}}
  </div>
</div>

<!-- Session create sheet -->
<div class="session-create-backdrop" id="session-create-backdrop" hidden></div>
<div class="session-create-sheet" id="session-create-sheet" role="dialog" aria-label="New Session" aria-modal="true" hidden>
  <div class="session-create-handle"></div>
  <div class="session-create-toolbar">
    <button class="session-create-cancel" id="session-create-cancel" type="button">Cancel</button>
    <h2 class="session-create-title">New Session</h2>
    <button class="session-create-done" id="session-create-submit" type="button">Create</button>
  </div>
  <div class="session-create-body">
    <div class="session-create-group">
      <label class="session-create-label" for="session-name-input">Name</label>
      <input class="session-create-input" id="session-name-input" type="text" placeholder="session-name" autocomplete="off" spellcheck="false">
    </div>
    <div class="session-create-group">
      <label class="session-create-label" for="session-members-input">Members</label>
      <div class="session-members-picker" id="session-members-picker">
        <input class="session-create-input" id="session-members-input" type="text" placeholder="Search people…" autocomplete="off">
        <ul class="session-members-list" id="session-members-list"></ul>
        <ul class="session-selected-members" id="session-selected-members"></ul>
      </div>
    </div>
    <div class="session-create-group">
      <label class="session-create-label" for="session-auto-end">Auto-end</label>
      <select class="session-create-input" id="session-auto-end">
        <option value="7">7 days</option>
        <option value="14">14 days</option>
        <option value="30" selected>30 days</option>
        <option value="0">Never</option>
      </select>
    </div>
    <div class="session-create-group">
      <label class="session-create-label" for="session-purpose-input">Purpose <span class="session-label-optional">(optional)</span></label>
      <textarea class="session-create-input session-create-textarea" id="session-purpose-input" placeholder="What is this session for?" rows="3"></textarea>
    </div>
  </div>
</div>

<!-- Threads sheet — "view all threads" for a channel -->
